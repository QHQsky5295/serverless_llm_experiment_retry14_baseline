+def _active_adapter_name(lora_model: LoraModel) -> str:
+    active_adapter = lora_model.active_adapter
+    if isinstance(active_adapter, (list, tuple)):
+        return active_adapter[0]
+    return active_adapter
+
+
+def _max_lora_rank(lora_model: LoraModel) -> int:
+    active_adapter = _active_adapter_name(lora_model)
+    ranks = [lora_model.peft_config[active_adapter].r]
+    for target_module_name in lora_model.targeted_module_names:
+        lora_layer = _get_submodules(lora_model.model, target_module_name)[1]
+        if active_adapter in lora_layer.lora_A:
+            ranks.append(lora_layer.lora_A[active_adapter].weight.size(0))
+        if active_adapter in lora_layer.lora_B:
+            ranks.append(lora_layer.lora_B[active_adapter].weight.size(1))
+    return max(ranks)
+
