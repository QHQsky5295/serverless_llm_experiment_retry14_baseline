"""R0H0 prelaunch: reuse D1055/D1047 evidence; combine only load-only and no-handoff gates."""
import json
import os
from pathlib import Path
import subprocess
import sys
import yaml

ROOT = Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
RAW = Path(__file__).resolve().parent
OUT = ROOT/'paper_results/ieee_tc/ablation/d1056_3b_r0h0_w1/prelaunch'
sys.path.insert(0, str(ROOT))
from scripts import ieee_tc_preflight as p
from faaslora.datasets.workload_generator import FrozenReplayPlan
from faaslora.storage.http_artifact_store import HttpArtifactStoreClient

def read(path): return json.loads(path.read_text())
def ref(path): return dict(path=str(path), sha256=p.digest(path), bytes=path.stat().st_size)
def save(path, value):
    with path.open('x') as handle:
        json.dump(value, handle, indent=2, allow_nan=False)
        handle.write('\n')

identity = p.scope_identity(p.cg_path().name)
assert os.sched_getaffinity(0) == {2, 3, 26, 27} and os.environ['CUDA_VISIBLE_DEVICES'] == ''
assert (p.cg_path()/'memory.high').read_text().strip() == str(3*p.GIB)
assert (p.cg_path()/'memory.max').read_text().strip() == str(4*p.GIB)
assert (p.cg_path()/'memory.swap.max').read_text().strip() == '0'
assert not subprocess.check_output(['nvidia-smi', '--query-compute-apps=pid', '--format=csv,noheader'], text=True).strip()
parent_config = ROOT/'configs/ieee_tc/20261104_d1047_3b_event_busy_time_w1.yaml'
config = ROOT/'configs/ieee_tc/20261104_d1056_3b_r0h0_w1.yaml'
parent, candidate = yaml.safe_load(parent_config.read_text()), yaml.safe_load(config.read_text())
assert (candidate['resource_coordination']['min_instances'], candidate['resource_coordination']['max_instances']) == (1, 3)
assert candidate['resource_coordination']['ieee_handoff_policy'] == 'no_handoff'
assert candidate['resource_coordination'].pop('ieee_selection_strategy') == 'load_only'
assert 'coordination_enabled' not in candidate['resource_coordination']
assert 'dynamic_scaling' not in candidate['resource_coordination']
changes = [dict(section='resource_coordination', key='ieee_selection_strategy', parent='service_bins (default)', candidate='load_only')]
for section, key in [('experiment','output_dir'), ('storage','nvme_cache_dir'),
                     ('storage','host_cache_dir'), ('resource_coordination','ieee_handoff_policy')]:
    a, b = parent[section][key], candidate[section][key]
    assert a != b
    changes.append(dict(section=section, key=key, parent=a, candidate=b))
    candidate[section][key] = a
assert parent == candidate, 'non-target configuration changed'
parent_qualification = ROOT/'paper_results/ieee_tc/p2_backend/d1047_same_version_w1/prelaunch/qualification.json'
prior = read(parent_qualification)
connection = ROOT/'paper_results/ieee_tc/ablation/d1055_3b_no_routing_w1/prelaunch/qualification.json'
wiring = read(connection)
assert prior['passed'] and wiring['passed']
unchanged = {**wiring['unchanged_sources'], **wiring['changed_sources']}
for name, sha in unchanged.items():
    assert p.digest(ROOT/name) == sha, name
test = read(RAW/'targeted_tests_v2.json')
assert test['passed'] and test['exit_code'] == 0 and test['tests_run'] == 12
for name, sha in test['test_sources'].items():
    assert p.digest(ROOT/name) == sha, name
assert p.digest(ROOT/'faaslora/experiment/instance_pool.py') == test['pool_source_sha256']
assert p.digest(ROOT/'scripts/run_all_experiments.py') == test['runner_sha256']
view = FrozenReplayPlan.load(prior['frozen_views']['W1']['source_path'], profile='W1').identity()
assert view['count'] == view['source_count'] == 4000
for key in ('source_sha256', 'view_sha256'):
    assert view[key] == prior['frozen_views']['W1'][key]
full = ROOT/'paper_results/ieee_tc/p2_backend/d1047_same_version_w1/completion/full4000.json'
assert p.digest(full) == '9efa154f7d9322e6ccac94541a7d323064d2bd868ee8642c8245755c42fde6e1'
protected = p.verify_seal(Path('/home/qhq/serverless_llm_experiment/results/ieee_tc/slora_qualification/d435_20261011/protected_before.json'))
assert protected['pass'] and protected['entry_count'] == 147
for name, sha in wiring['user_protected'].items():
    assert p.digest(ROOT/name) == sha, name
client = HttpArtifactStoreClient(endpoint='http://192.168.4.174:18080',
    token=Path('/home/qhq/.config/primelora-tc-d75/artifact.token').read_text().strip(),
    timeout_s=30., required_delivery_mode='prepublished_gzip_v1')
health = client.health()
assert health['ok'] and health['delivery_mode'] == 'prepublished_gzip_v1'
assert health['timing_contract'] == 'artifact_timing_v2'
assert health['root'] == '/home/lab14/primelora_remote_artifacts/llama32_3b_a500_v1_modelscope'
OUT.mkdir(parents=True, exist_ok=False)
for name in ('targeted_tests.json', 'targeted_tests.txt', 'targeted_tests.py',
             'targeted_tests_v2.json', 'targeted_tests_v2.txt', 'targeted_tests_v2.py', 'curate.py'):
    with (OUT/(name+'.snapshot' if name.endswith('.py') else name)).open('xb') as handle:
        handle.write((RAW/name).read_bytes())
save(OUT/'remote_health.json', dict(health=health, configuration_changed=False,
    continuous_remote_monitoring=False, note='Existing service reused; same monitoring limitation as D1047/D1055.'))
save(OUT/'qualification.json', dict(passed=True, performance_result=False, tests=12,
    variant='R0H0', parent_variant='Full', raw_scenario='tc_ieee_full',
    parent_result=ref(full), parent_qualification=ref(parent_qualification),
    parent_mechanism_qualification=ref(connection), config=ref(config), config_changes=changes,
    unchanged_sources=unchanged, changed_sources={},
    workload=view, plan_sha256=p.check_plan(), identity=identity,
    resources=p.cgroup_snapshot(p.cg_path()), protected=protected,
    user_protected=wiring['user_protected'], production_change=None,
    test_changes={},
    test_sources=test['test_sources'],
    n_correct=None, independent_numerical_proof=False, formal_ranking_eligible=False,
    limitations=['Single known-source42 development observation; no CI.',
        'Display R0H0; executable scenario remains tc_ieee_full.',
        'Only service-bin routing and activation handoff are removed; hierarchy, admission, owners, demand preparation and control remain Full.',
        'Natural closed-loop plans can differ between runs; not the controlled same-plan A2/A4 result.',
        'All-zero-update 3B pool and independent numerical correctness limitations retained.']))
save(OUT/'manifest.json', dict(files=[ref(path) for path in sorted(OUT.iterdir()) if path.is_file()]))
print(json.dumps(dict(passed=True, tests=2, variant='R0H0', config_changes=changes)), flush=True)
