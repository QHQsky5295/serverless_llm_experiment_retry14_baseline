#!/usr/bin/env bash
# Offline continuation only: never launches inference or changes a service.
set -euo pipefail
set -o noclobber
ROOT=/home/qhq/serverless_llm_experiment_retry14_baseline
RAW=/home/qhq/serverless_llm_experiment/results/ieee_tc/p2_backend_qualification/d1062_20261104
PY=/home/qhq/.venvs/primelora_vllm0300_tc_20260925/bin/python
exec > "$RAW/postrun_pipeline.log" 2>&1
trap 'rc=$?; printf "pipeline_exit_code=%s\n" "$rc"' EXIT
cd "$ROOT"
date --iso-8601=seconds
deadline=$((SECONDS + 7200))
while tmux has-session -t tc-d1062-last-known-3b-w1 2>/dev/null; do
    if (( SECONDS >= deadline )); then exit 75; fi
    sleep 15
done
date --iso-8601=seconds
jq -e '.pass == true and .service_path_removed == true and .native_gpu_context_release_confirmed == true' \
    "$RAW/d1062_3b_last_known_w1/launch.json"
test ! -e "$RAW/analysis_tests1.json"
systemd-run --user --scope --collect --unit=primelora-tc-aux-d1062000000000000000000000000006 \
    -p MemoryHigh=3G -p MemoryMax=4G -p MemorySwapMax=0 \
    taskset -c 2,3,26,27 env CUDA_VISIBLE_DEVICES= PYTHONDONTWRITEBYTECODE=1 \
    "$PY" "$RAW/analysis_tests.py" analysis_tests1
systemd-run --user --scope --collect --unit=primelora-tc-aux-d1062000000000000000000000000007 \
    -p MemoryHigh=3G -p MemoryMax=4G -p MemorySwapMax=0 \
    taskset -c 2,3,26,27 env CUDA_VISIBLE_DEVICES= PYTHONDONTWRITEBYTECODE=1 \
    "$PY" "$RAW/collect_closed_evidence.py"
systemd-run --user --scope --collect --unit=primelora-tc-aux-d1062000000000000000000000000008 \
    -p MemoryHigh=3G -p MemoryMax=4G -p MemorySwapMax=0 \
    taskset -c 2,3,26,27 env CUDA_VISIBLE_DEVICES= PYTHONDONTWRITEBYTECODE=1 \
    "$PY" "$RAW/compare.py"
date --iso-8601=seconds
