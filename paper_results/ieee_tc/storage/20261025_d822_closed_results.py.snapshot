"""Reuse verified D817 lossless archiving for the three closed D822 logs."""
from pathlib import Path

_template=Path(__file__).resolve().parent.parent/'d817_20261025/storage_maintenance.py'
_source=_template.read_text()
_source=_source.replace('d817_3b_required_capacity_full_w2','d822_3b_shared_pressure_full_w2')
_source=_source.replace('d817_20261025/3b_max3_full_w2','d822_20261025/3b_max3_full_w2')
_source=_source.replace('20261025_d817_closed_results','20261025_d822_closed_results')
_source=_source.replace('D817','D822')
_needle='exec(compile(_source,str(_template),\'exec\'),globals())'
assert _source.count(_needle)==1
_source=_source.replace(_needle,'''
_marker='c.TARGETS, c.OUT = targets, OUT'
assert _source.count(_marker)==1
_source=_source.replace(_marker,"""remote_monitor_sha=next(line.split()[0] for line in (RAW/'remote_stop.log').read_text().splitlines() if line.endswith('/remote_monitor.log'))
assert p.digest(RAW/'remote_monitor.log')==remote_monitor_sha
targets.append(dict(run='d822_20261025/3b_max3_full_w2',audit_sha=remote_monitor_sha,
    remote_monitor_log='remote_monitor.log'))
"""+_marker)
with (RAW if 'RAW' in globals() else Path(__file__).resolve().parent).joinpath('storage_program.py.snapshot').open('x') as _stream:
    _stream.write(_source)
exec(compile(_source,str(_template),'exec'),globals())
''')
exec(compile(_source,str(_template),'exec'),globals())
