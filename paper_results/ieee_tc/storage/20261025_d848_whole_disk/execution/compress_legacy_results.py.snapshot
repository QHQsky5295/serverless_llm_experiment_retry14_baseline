"""Reuse the unchanged closed-evidence compressor on two explicit old results."""
import json
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
RAW = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))
from scripts import ieee_tc_preflight as p
from scripts.ieee_tc import compress_closed_main_outcomes as c

own = p.scope_identity(p.cg_path().name)
with (RAW/'compression_identity.json').open('x') as stream:
    json.dump(own, stream, indent=2)
assert os.sched_getaffinity(0) == {2,3,26,27}
assert not subprocess.check_output(['nvidia-smi', '--query-compute-apps=pid', '--format=csv,noheader'], text=True).strip()
seal = RAW.parent.parent/'slora_qualification/d435_20261011/protected_before.json'
assert p.verify_seal(seal)['pass']
user = ROOT/'configs/generated/lora_manifest_1000.json'
user_sha = p.digest(user)
assert user_sha == '3b69bd0a6888aa56e98c3b9efb61234860d4b80f25729cfea6b79126d19127df'
c.TARGETS = [
    dict(run='d125_20260930/7b_full_w0_full1',
         legacy_result='7b_outputs_full1/experiment_results_full_vllm_dedicated_a500_r4000_c2_tc_ieee_full_d125_7b_full_w0_full1.json',
         audit_sha='93c17465221aed19dc993bf04cbfbefa720b692e6cf4465e88aef76b33f648a2'),
    dict(run='d129_20260930/7b_full_w0_full1',
         legacy_result='7b_outputs_full1/experiment_results_full_vllm_dedicated_a500_r4000_c2_tc_ieee_full_d129_7b_full_w0_full1.json',
         audit_sha=None),
]
c.OUT = ROOT/'paper_results/ieee_tc/storage/20261025_d848_legacy_results.json'
peak = max(c.evidence_paths(c.RAW_ROOT/row['run'], legacy_result=row['legacy_result'])[0].stat().st_size for row in c.TARGETS)
free = os.statvfs('/home/qhq').f_bavail * os.statvfs('/home/qhq').f_frsize
assert free >= max(150*1024**3, 100*1024**3 + 1.5*(peak*1.01 + 1024**3))
with (RAW/'compression_contract.json').open('x') as stream:
    json.dump(dict(targets=c.TARGETS, compressor_sha256=p.digest(Path(c.__file__)),
        source_script_sha256=p.digest(Path(__file__)), available_bytes=free,
        largest_input_bytes=peak, protected_seal_sha256=p.digest(seal),
        user_manifest_sha256=user_sha,
        purpose='Preserve old raw measurements byte-for-byte, not qualify or improve historical performance.',
        restoration='Read gzip streams directly. If an old analyzer requires JSON, restore only that explicit file using gzip -dk after checking space and no existing destination; verify the source SHA in its receipt. Never restore during a performance measurement.'), stream, indent=2)
print(json.dumps(dict(stage='compressing_two_closed_legacy_results', available_bytes=free)), flush=True)
assert c.main() == 0
assert p.verify_seal(seal)['pass'] and p.digest(user) == user_sha
group = Path(own['path'])
events = {line.split()[0]: int(line.split()[1]) for line in (group/'memory.events').read_text().splitlines()}
assert all(events.get(key, 0) == 0 for key in ('max', 'oom', 'oom_kill'))
assert (group/'memory.swap.current').read_text().strip() == '0'
receipt = json.loads(c.OUT.read_text())
verification = dict(passed=True, identity=own, resources=p.cgroup_snapshot(group),
    memory_events=events, high_events_interpretation='Maintenance page-cache reclaim is recorded, not a GPU performance result.',
    protected_147_unchanged=True, user_manifest_sha256=user_sha,
    receipt_sha256=p.digest(c.OUT),
    reclaimed_bytes=sum(row['allocated_bytes_reclaimed'] for row in receipt['entries']),
    no_new_performance_run=True)
with c.OUT.with_name(c.OUT.stem+'_verification.json').open('x') as stream:
    json.dump(verification, stream, indent=2)
print(json.dumps(verification), flush=True)
