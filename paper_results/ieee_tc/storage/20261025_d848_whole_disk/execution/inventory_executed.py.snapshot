start = time.monotonic()
with (ROOT/'inventory_allocated.tsv').open('x') as out, (ROOT/'inventory_errors.log').open('x') as err:
    result = subprocess.run(['nice','-n','19','ionice','-c','3','du','-x','-B1',
                             '--max-depth=4', *['--exclude='+path for path in excluded_mounts], '--', *roots], stdout=out, stderr=err,
                            timeout=1800)
save('inventory_result.json', dict(completed=result.returncode in (0,1), fully_readable=result.returncode==0, passed=result.returncode==0,
    returncode=result.returncode, roots=roots, elapsed_s=time.monotonic()-start,
    allocated_sha256=p.digest(ROOT/'inventory_allocated.tsv'),
    errors_sha256=p.digest(ROOT/'inventory_errors.log'),
    limitations='Whole root filesystem metadata with all submounts excluded; unreadable directories are explicit gaps, not zero; no evidence of uselessness from size/age alone.'))
print(json.dumps(dict(returncode=result.returncode, elapsed_s=time.monotonic()-start)))
sys.exit(result.returncode)
