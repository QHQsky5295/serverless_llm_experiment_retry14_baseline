"""Bounded read-only metadata inventory; no source/content deletion decisions."""
import json
import os
from pathlib import Path
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, '/home/qhq/serverless_llm_experiment_retry14_baseline')
from scripts import ieee_tc_preflight as p

def save(name, value):
    with (ROOT/name).open('x') as out:
        json.dump(value, out, indent=2)

save('inventory_identity.json', p.scope_identity(p.cg_path().name))
