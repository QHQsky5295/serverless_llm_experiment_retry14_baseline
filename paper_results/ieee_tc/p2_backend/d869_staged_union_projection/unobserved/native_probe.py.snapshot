"""One current-context two-view HOST microtest; reuses D747/D864 fixture design.

No model/trace replay or new weight artifact. Per-view native descriptor is
unchanged, so reuse its pin-state qualification instead of rerunning nine cases.
"""
import json
from pathlib import Path
import statistics
import sys
import time
import traceback
from types import SimpleNamespace as NS

ROOT = Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
RAW = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))
from scripts import ieee_tc_preflight as p

result = dict(kind='fresh_staged_union_two_host_views_d869_v1', passed=False,
              full_performance_run=False, model_loaded=False, tensor_state_cached=False)
try:
    result['service'] = p.verify_current_service()
    import torch
    from faaslora.memory import gpu_monitor as monitor
    from faaslora.experiment.instance_pool import NativeSourceSnapshot
    assert torch.__version__ == '2.13.0+cu130' and torch.cuda.device_count() == 1
    torch.cuda.set_device(0)
    torch.cuda.init()
    sentinel = torch.empty(1, device='cuda')
    torch.cuda.synchronize()
    descriptor, implementation = monitor.native_host_descriptor()
    assert implementation['kind'] == 'fresh_native_tensor_descriptor_v1'
    result.update(implementation=implementation, torch_version=torch.__version__,
                  device_name=torch.cuda.get_device_name(0), plan_sha256=p.check_plan())
    # Exact small dense/packed/alias fixture structure from backend_pin_query_check.
    models = {}
    for aid in range(1, 9):
        layers = {}
        for layer in range(32):
            a = torch.empty((8, 32), dtype=torch.float16, pin_memory=(aid % 2 == 0))
            b = torch.empty((32, 8), dtype=torch.float16, pin_memory=(aid % 2 == 0))
            layers[f'layer{layer:02d}'] = NS(lora_a=[a, a[1:], a.T], lora_b=[b, b[1:], b.T])
        models[aid] = NS(id=aid, rank=8, loras=layers)
    models[2].loras['layer00'].lora_a[0] = models[1].loras['layer00'].lora_a[0]
    manager = NS(list_adapters=lambda: dict(models))
    staged = {9: NS(id=9, rank=8, loras=models[2].loras)}
    inventory = monitor._ieee_lora_host_inventory
    def reference():
        host = inventory(manager, include_tensor_views=False)
        union = inventory(manager, staged_models=staged, include_tensor_views=False)
        return host, union
    def candidate():
        union = inventory(manager, staged_models=staged, include_tensor_views=False)
        return monitor._ieee_registered_host_inventory_from_union(union), union
    expected, observed = reference(), candidate()
    assert expected == observed  # Higher staged ID preserves numbering in this fixture.
    pool = dict(uniform_slot_layout=True, slot_adapter_ids=[1, None],
        registered_cpu_adapter_ids=list(models), slot_capacity_bytes=32, pool_allocated_bytes=64,
        pool_tensor_views=[{'dtype': 'torch.float16'}])
    assert NativeSourceSnapshot._footprints({**expected[0], **pool}, (1, None), tuple(models)) == \
        NativeSourceSnapshot._footprints({**observed[0], **pool}, (1, None), tuple(models))
    assert any(row['pinned'] for row in observed[1]['host_allocations'])
    assert any(not row['pinned'] for row in observed[1]['host_allocations'])
    result.update(semantic_equal=True, fixture=dict(registered=8, staged=1, layers=32,
        registered_views=1536, union_views=1728, small_in_memory_only=True,
        artifact_pool_created=False), scope='both_HOST_views_not_entire_source_snapshot')
    reference()
    candidate()
    torch.cuda.synchronize()
    measurements = []
    for index in range(20):
        order = [('two_fresh_inventories', reference), ('one_fresh_union_projection', candidate)]
        if index % 2:
            order.reverse()
        for label, function in order:
            cpu, wall = time.process_time_ns(), time.perf_counter_ns()
            value = function()
            elapsed, used = time.perf_counter_ns() - wall, time.process_time_ns() - cpu
            assert value == expected
            measurements.append(dict(index=index, variant=label, wall_ns=elapsed, cpu_ns=used))
    result['measurements'] = measurements
    result['summary'] = {label: {field: dict(mean=statistics.mean(values),
        median=statistics.median(values), minimum=min(values), maximum=max(values))
        for field in ('wall_ns', 'cpu_ns')
        for values in [[row[field] for row in measurements if row['variant'] == label]]}
        for label in ('two_fresh_inventories', 'one_fresh_union_projection')}
    old = result['summary']['two_fresh_inventories']['wall_ns']['mean']
    new = result['summary']['one_fresh_union_projection']['wall_ns']['mean']
    result['mean_wall_lower_better_fraction'] = (old-new)/old
    result['production_source_sha256'] = p.digest(ROOT/'faaslora/memory/gpu_monitor.py')
    result['probe_source_sha256'] = p.digest(Path(__file__))
    result['resources'] = p.cgroup_snapshot(p.cg_path())
    torch.cuda.synchronize()
    del sentinel
    result['passed'] = True
except Exception as error:
    result.update(error_type=type(error).__name__, error=str(error), traceback=traceback.format_exc())
with (RAW/'native_probe.json').open('x') as f:
    json.dump(result, f, indent=2, allow_nan=False)
    f.write('\n')
print(json.dumps({key: result.get(key) for key in ('passed', 'summary', 'error')}))
raise SystemExit(0 if result['passed'] else 2)
