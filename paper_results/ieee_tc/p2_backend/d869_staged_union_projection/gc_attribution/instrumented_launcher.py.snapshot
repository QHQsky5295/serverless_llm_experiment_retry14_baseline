"""Reuse the guarded D864/D747 native launcher, with one D869 component query."""
import json
import os
from pathlib import Path
import subprocess
import sys
ROOT = Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
RAW = Path(__file__).resolve().parent
OUT = ROOT/'paper_results/ieee_tc/p2_backend/d869_staged_union_projection'
sys.path.insert(0, str(ROOT))
from scripts import ieee_tc_preflight as p
def save(name, value):
    with (RAW/name).open('x') as f:
        json.dump(value, f, indent=2, allow_nan=False)
        f.write('\n')
p.require_watchdog_primitives()
identity = p.scope_identity(p.cg_path().name)
save('native_supervisor_identity.json', identity)
qualified = json.loads((OUT/'qualification.json').read_text())
assert qualified['passed'] and qualified['seal']['pass']
for path, sha in qualified['source_shas'].items():
    assert p.digest(Path(path)) == sha, path
assert not subprocess.check_output(['nvidia-smi', '--query-compute-apps=pid', '--format=csv,noheader'], text=True).strip()
assert not Path(qualified['identity']['path']).exists()
os.environ['FAASLORA_TC_NVML_BINDING'] = '/home/qhq/anaconda3/envs/LLM_vllm0102/lib/python3.12/site-packages/pynvml.py'
os.environ['FAASLORA_TC_NVML_SHA256'] = '4251429c25f1615a4166f395d3c09fe0732bfb023864c4b7f12813373e5696ea'
receipt = RAW.parent.parent/'runtime_20260926/cuda_import_attempt3.json'
assert p.digest(receipt) == 'cf38bbf8d3b80b30d88ac38e27722d389a24ae516565708cfc924937589079cf'
library = RAW.parent.parent/'d747_20261023/_ieee_native_host_descriptor.cpython-312-x86_64-linux-gnu.so'
library_sha = 'b76733db910a0041409ce375e7b5a281dabadd6d0e5796699bf8fe574e293044'
assert p.digest(library) == library_sha
save('native_preregister.json', dict(plan_sha256=p.check_plan(), qualification_sha256=p.digest(OUT/'qualification.json'),
    runtime_receipt_sha256=p.digest(receipt), library=str(library), library_sha256=library_sha,
    sources={str(path): p.digest(path) for path in (RAW/'native_probe.py', Path(__file__))},
    paired_component_schedule=20, native_pin_qualification_reused=True,
    full_performance_run=False, source_parent_head=subprocess.check_output(['git','rev-parse','HEAD'],cwd=ROOT,text=True).strip()))
command = ['/usr/bin/env', 'CUDA_VISIBLE_DEVICES=0',
    'PYTORCH_ALLOC_CONF=pinned_max_cached_size_mb:0,pinned_use_background_threads:True',
    'FAASLORA_IEEE_HOST_DESCRIPTOR_LIBRARY='+str(library),
    'FAASLORA_IEEE_HOST_DESCRIPTOR_SHA256='+library_sha,
    'FAASLORA_IEEE_HOST_INVENTORY_MODE=descriptor',
    '/home/qhq/.venvs/primelora_vllm0300_tc_20260925/bin/python', '-B', str(RAW/'native_probe.py')]
result = p.gated_launch(command, RAW/'native_launch.json', predicted_growth=64*p.MIB)
save('native_launch.json', result)
print(json.dumps(dict(passed=result['pass'], service=result.get('service_unit'))))
raise SystemExit(0 if result['pass'] else 2)
