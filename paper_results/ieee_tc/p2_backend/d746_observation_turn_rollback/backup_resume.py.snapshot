"""Resume D746 publication after gitignore rejected the explicit small test log."""
import ast
import json
import os
import re
import subprocess
import sys
from pathlib import Path
ROOT = Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
RAW = Path(__file__).resolve().parent
OUT = ROOT/'paper_results/ieee_tc/p2_backend/d746_observation_turn_rollback'
sys.path.insert(0, str(ROOT))
from scripts import ieee_tc_preflight as p
def read(path): return json.loads(path.read_text())
def save(path, data):
    with path.open('x') as f: json.dump(data, f, indent=2, allow_nan=False)
def call(args):
    return subprocess.check_output(args, cwd=ROOT, text=True, stderr=subprocess.STDOUT, timeout=60).strip()

assert os.sched_getaffinity(0) == {2,3,26,27}
save(RAW/'backup_resume_identity.json', p.scope_identity(p.cg_path().name))
assert not call(['nvidia-smi','--query-compute-apps=pid','--format=csv,noheader'])
identity = read(RAW/'backup_identity.json')
path = Path(identity['path'])
assert p.scope_still_owned(identity) and not p.owned_pids(path)
resources = p.cgroup_snapshot(path)
closed = p.stop_scope_identity(identity, grace_seconds=0)
assert closed['released'] and not closed['targets']
restore = read(OUT/'restoration.json')
for name, sha in restore['restored'].items(): assert p.digest(ROOT/name) == sha
q = read(ROOT/'paper_results/ieee_tc/p2_backend/d745_3b_observe_after_turn_full_w0/prelaunch/qualification.json')
for name, sha in q['protected'].items(): assert p.digest(Path(name)) == sha
files = []
for item in read(OUT/'manifest.json')['files']:
    path = ROOT/item['path']
    assert p.digest(path) == item['sha256']
    files.append(path)
files += [OUT/'manifest.json']+[ROOT/name for name in restore['restored']]
files += [ROOT/'docs/ieee_tc/D746_OBSERVATION_TURN_ROLLBACK_20261023.md', ROOT/'docs/ieee_tc/EXECUTION_STATUS.md']
paths = [str(path.relative_to(ROOT)) for path in files]
log = str((OUT/'tests.log').relative_to(ROOT))
assert set(call(['git','diff','--cached','--name-only']).splitlines()) == set(paths)-{log}
assert call(['git','check-ignore','-v',log]).startswith('.gitignore:57:*.log')
assert (OUT/'tests.log').stat().st_size < 1024*1024
failure = OUT/'publication_resume.json'
save(failure, dict(reason='Original git add rejected the explicit curated tests.log under *.log; no test or measurement failed. Other 15 intended paths were already staged. Resume only publication, preserving original script and prepared manifest.',
    failed_scope_identity=identity, failed_scope_resources=resources, failed_scope_release=closed,
    original_manifest_sha256=p.digest(OUT/'manifest.json'), new_gpu_replays=0, repeated_tests=0))
snapshot = OUT/'backup_resume.py.snapshot'
ast.parse(Path(__file__).read_text())
with snapshot.open('xb') as f: f.write(Path(__file__).read_bytes())
files += [failure,snapshot]
paths += [str(x.relative_to(ROOT)) for x in (failure,snapshot)]
secret = re.compile(r'-----BEGIN (?:OPENSSH |RSA |EC )?PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]+|(?im:^[ \t]*(?:password|passwd|secret|api_key|PRIME_REMOTE_TOKEN)[ \t]*=[ \t]*[\x22\x27]?[A-Za-z0-9+/]{8,})')
for path in files: assert not secret.search(path.read_text()), str(path)
call(['git','add','-f','--',log])
call(['git','add','--',*[x for x in paths if x!=log]])
assert set(call(['git','diff','--cached','--name-only']).splitlines()) == set(paths)
assert 'configs/generated/lora_manifest_1000.json' not in paths
call(['git','diff','--cached','--check','--',*[x for x in paths if not x.endswith('.snapshot')]])
call(['git','-c','core.whitespace=blank-at-eol,space-before-tab,-blank-at-eof','diff','--cached','--check','--',*[x for x in paths if x.endswith('.snapshot')]])
save(RAW/'backup_precommit.json',dict(passed=True,paths=paths,protected_files=len(q['protected'])))
call(['git','commit','-m','tc: withdraw D744 observation-turn candidate after full D745 regression'])
head=call(['git','rev-parse','HEAD'])
ref='refs/heads/backup/d746-observation-turn-rollback-20261023'
call(['git','push','faaslora_origin','HEAD:'+ref])
assert call(['git','ls-remote','faaslora_origin',ref]).split()[0]==head
save(RAW/'backup_completion.json',dict(passed=True,head=head,ref=ref,files=paths,v2_synchronized=False))
print(json.dumps(dict(passed=True,head=head,ref=ref,files=len(paths))))
