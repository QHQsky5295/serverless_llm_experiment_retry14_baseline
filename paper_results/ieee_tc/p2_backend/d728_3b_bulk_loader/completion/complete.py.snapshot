"""Seal one native lifecycle check; prepare the existing full-replay interface."""
import copy,json,os,re,subprocess,sys
from pathlib import Path
ROOT=Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
RAW=Path(__file__).resolve().parent
OUT=ROOT/'paper_results/ieee_tc/p2_backend/d728_3b_bulk_loader/completion'
NEXT=RAW.parent/'d729_20261022'
PRE=ROOT/'paper_results/ieee_tc/p2_backend/d729_3b_bulk_loader_full_w0/prelaunch'
sys.path.insert(0,str(ROOT))
from scripts import ieee_tc_preflight as p
def read(path):return json.loads(path.read_text())
def save(path,obj):
    with path.open('x') as f:json.dump(obj,f,indent=2,allow_nan=False)
def ref(path):return dict(path=str(path),sha256=p.digest(path),bytes=path.stat().st_size)
own=p.scope_identity(p.cg_path().name);save(RAW/'complete_identity.json',own)
assert os.sched_getaffinity(0)=={2,3,26,27} and os.environ['CUDA_VISIBLE_DEVICES']==''
assert not subprocess.check_output(['nvidia-smi','--query-compute-apps=pid','--format=csv,noheader'],text=True).strip()
q=read(OUT.parent/'cpu_qualification.json')
for path,sha in (q['refs']|q['protected']).items():assert p.digest(Path(path))==sha,path
raw=read(RAW/'native.json');launch=read(RAW/'native_launch.json')
assert raw['pass'] and raw['stage']=='complete' and len(raw['requests'])==4
assert all(r['pass'] and r['actual_tokens']==r['target_tokens'] and r['release']['released'] for r in raw['requests'])
assert launch['pass'] and launch['service_path_removed'] and launch['native_gpu_context_release_confirmed']
assert launch['service_returncode']==launch['watchdog_returncode']==0
assert raw['shutdown_called'] and raw['physical_allocation']['released']
samples=[]
with (RAW/'native_launch.launch/watchdog.jsonl').open() as f:
    for line in f:
        row=json.loads(line)
        if row.get('event')=='resource_sample':samples.append(row)
events={k:max(s['service']['memory.events'][k] for s in samples) for k in ('high','max','oom','oom_kill')}
assert not any(events.values()) and not any(s['service']['memory.swap.current'] for s in samples)
gpu_processes=[proc for s in samples for d in s['gpu']['devices'] for proc in d['processes'] if proc['service_member']]
allowed=set(range(4,24))|set(range(28,48))
assert gpu_processes and all(set(proc['identity']['affinity'])<=allowed for proc in gpu_processes)
assert all(len(s['gpu']['service_held_gpu_uuids'])<=1 for s in samples)
log=ROOT/'results/worker_failures/faaslora_worker_dws2yfmx_engine_dead_1792660232/worker.log'
text=log.read_text()
assert 'load_format=fastsafetensors_affinity_preserving_v1' in text and 'Loading fastsafetensors checkpoint shards' in text
model_load=float(re.search(r'Model loading took [\d.]+ GiB memory and ([\d.]+) seconds',text).group(1))
weights_load=float(re.search(r'Loading weights took ([\d.]+) seconds',text).group(1))
OUT.mkdir(parents=True,exist_ok=False)
closures=[]
for name in ('backup_identity.json','launch_identity.json'):
    identity=read(RAW/name);assert not p.owned_pids(Path(identity['path']))
    closed=p.stop_scope_identity(identity,grace_seconds=0)
    assert closed['released'] and not closed['targets']
    closures.append(dict(identity=identity,closure=closed))
save(OUT/'summary.json',dict(passed=True,native_requests=4,native_target_counts=[r['actual_tokens'] for r in raw['requests']],
    startup_latency_ms=raw['startup_latency_ms'],weights_loading_s=weights_load,model_loading_s=model_load,
    max_service_memory_bytes=max(s['service']['memory.peak'] for s in samples),events=events,swap_peak_bytes=0,
    cpu_affinity_within_envelope=True,one_gpu_only=True,physical_release=True,closures=closures,
    generation_and_binding_qualified=True,n_correct=None,ranking_eligible=False,full_performance_runs=0,
    prior_full_model_load_s=10.677745,causal_speedup_claim=False,
    kv_tokens_observed=91440,prior_d726_kv_tokens_observed=91696,
    limitations=['Native sequential qualification only; no new Full result.',
      'Historical initialization/cache states are not paired; no causal end-to-end delta.',
      'Loader allocation changes native KV sizing slightly; admission uses live actual blocks.',
      'This is not independent numerical correctness certification.'],
    refs=[ref(f) for f in (RAW/'native.json',RAW/'native_launch.json',log,RAW/'native_launch.launch/watchdog.jsonl')]))
for source in (log,Path(__file__)):
    with (OUT/(source.name+'.snapshot')).open('xb') as f:f.write(source.read_bytes())
save(OUT/'manifest.json',dict(passed=True,files=[ref(f) for f in sorted(OUT.iterdir())]))

# Mechanical extension of D726: one startup field and fresh output/cache paths.
import yaml
from scripts.run_all_experiments import ScenarioRunner,_prepare_scenario_runtime_model_config,_prepare_dedicated_subprocess_model_cfg
from faaslora.experiment.instance_pool import FrozenServiceProfiles
oldpath=ROOT/'configs/ieee_tc/20261022_d726_3b_graph_full_w0.yaml'
newpath=ROOT/'configs/ieee_tc/20261022_d729_3b_bulk_loader_full_w0.yaml'
content=oldpath.read_text().replace('d726','d729').replace('3b_graph_full_w0','3b_bulk_loader_full_w0')
content=content.replace('  safetensors_load_strategy: auto','  safetensors_load_strategy: auto\n  ieee_backbone_loader: fastsafetensors_affinity_preserving_v1')
with newpath.open('x') as f:f.write(content)
old=yaml.safe_load(oldpath.read_text());new=yaml.safe_load(content)
restored=copy.deepcopy(new);assert restored['model'].pop('ieee_backbone_loader')=='fastsafetensors_affinity_preserving_v1'
restored['experiment']['output_dir']=old['experiment']['output_dir']
for key in ('host_cache_dir','nvme_cache_dir'):restored['storage'][key]=old['storage'][key]
assert restored==old
runtime=_prepare_scenario_runtime_model_config(new['model'],new['workload'],new['resource_coordination'])
child,_=_prepare_dedicated_subprocess_model_cfg(runtime,device_id=0,runtime_gpu_ids=[0])
contract=read(ROOT/'paper_results/ieee_tc/p2_backend/d725_3b_graph_profile/development_contract.json')
assert FrozenServiceProfiles.model_identity(child)==FrozenServiceProfiles.model_identity(contract['model_config'])
runner=ScenarioRunner.__new__(ScenarioRunner);runner.model_cfg=runtime;runner.coord_cfg=new['resource_coordination'];runner._initial_runtime_pending=True
runner._service_profiles=runner._load_ieee_service_profiles();runner._load_ieee_preparation_profiles()
launcher=ROOT/'scripts/ieee_tc/run_d293_7b_prefetch_validation_100.sh'
subprocess.run(['bash','-n',str(launcher)],check=True)
case=launcher.read_text().split('  d729)\n',1)[1].split('    ;;',1)[0]
assert 'PREFIX_COUNT=\n' in case and '3b_bulk_loader_full_w0' in case
assert launcher.read_text().count('== d729 ]]')==2
NEXT.mkdir(exist_ok=False)
for name in ('start_remote.sh','stop_remote.sh','check_remote_health_stdlib.py','run_and_release.sh'):
    original=RAW.parent/'d726_20261022'/name
    derived=original.read_text().replace('d726','d729').replace('3b_graph_full_w0','3b_bulk_loader_full_w0').replace('graph-fullw0','bulk-loader-fullw0')
    with (NEXT/name).open('x') as f:f.write(derived)
    if name.endswith('.sh'):subprocess.run(['bash','-n',str(NEXT/name)],check=True)
PRE.mkdir(parents=True,exist_ok=False)
refs=[p.PLAN,oldpath,newpath,launcher,ROOT/'scripts/run_all_experiments.py',OUT/'summary.json',
 ROOT/'faaslora/experiment/backbone_loader.py',ROOT/'faaslora/experiment/vllm_bulk_loader.py',
 ROOT/'faaslora/experiment/instance_pool.py',ROOT/'docs/ieee_tc/METRIC_PROTOCOL_FROZEN_V1.md',
 ROOT/'docs/ieee_tc/METRIC_PROTOCOL_SINGLE_RUN_V2.md',
 ROOT/'paper_results/ieee_tc/protocols/20261017_3b_slo_d648_frozen.json',Path(__file__),*NEXT.iterdir()]
for field in ('ieee_service_profile','ieee_preparation_profile'):
    binding=new['resource_coordination'][field]
    assert p.digest(Path(binding['path']))==binding['sha256'];refs.append(Path(binding['path']))
save(PRE/'qualification.json',dict(passed=True,identity=own,requests=4000,extra_full_prefix=False,
    only_lossless_backbone_loader_and_paths_changed=True,service_classes=len(runner._service_profiles.profiles),
    refs={str(f):p.digest(f) for f in refs},protected=q['protected'],profile_recollection_required=False))
print(json.dumps(dict(passed=True,native_requests=4,weights_loading_s=weights_load,model_loading_s=model_load,
    startup_latency_ms=raw['startup_latency_ms'],max_service_memory_bytes=max(s['service']['memory.peak'] for s in samples),
    next_config=str(newpath),service_classes=len(runner._service_profiles.profiles))))
