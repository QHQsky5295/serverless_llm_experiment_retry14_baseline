"""Reuse the successful D725 source collection with the qualified HOST candidate."""
import json
import os
from pathlib import Path
import subprocess
import sys
import yaml
ROOT=Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
RAW=Path(__file__).resolve().parent
OUT=ROOT/'paper_results/ieee_tc/p2_backend/d877_private_host_profile'
sys.path.insert(0,str(ROOT))
from scripts import ieee_tc_preflight as p
def read(path):return json.loads(path.read_text())
def save(path,value):
    with path.open('x') as f:json.dump(value,f,indent=2,allow_nan=False);f.write('\n')
assert os.sched_getaffinity(0)=={2,3,26,27} and os.environ['CUDA_VISIBLE_DEVICES']==''
identity=p.scope_identity(p.cg_path().name)
save(RAW/'prepare_identity.json',identity)
assert not subprocess.check_output(['nvidia-smi','--query-compute-apps=pid','--format=csv,noheader'],text=True).strip()
gate=p.preflight([ROOT,RAW],8*p.GIB);save(RAW/'preflight.json',gate)
assert gate['preflight_pass'],gate['issues']
protected=p.verify_seal(RAW.parent.parent/'slora_qualification/d435_20261011/protected_before.json')
assert protected['pass']
assert read(ROOT/'paper_results/ieee_tc/p2_backend/d875_private_host_native/summary.json')['passed']
config=yaml.safe_load((ROOT/'configs/ieee_tc/20261022_d724_3b_graph_native.yaml').read_text())
config['model_profiles']['llama32_3b_main_modelscope']['model']['ieee_host_construction']='private_cpu_core_commit_v1'
destination=ROOT/'configs/ieee_tc/20261026_d877_3b_private_host_source.yaml'
with destination.open('x') as f:yaml.safe_dump(config,f,sort_keys=False)
command=[sys.executable,'-B','-m','unittest',
    'tests.test_ieee_tc_preflight.MeasuredAdmissionInitializer','-v']
with (RAW/'tests.log').open('x') as log:
    test=subprocess.run(command,cwd=ROOT,stdout=log,stderr=subprocess.STDOUT)
assert test.returncode==0
subprocess.run(['bash','-n','scripts/ieee_tc/run_d298_capacity_source.sh'],cwd=ROOT,check=True)
with (RAW/'prepare.log').open('x') as log:
    subprocess.run([sys.executable,'-B','-m','scripts.ieee_tc.prepare_d701_3b_same_spec_profile',
        '--rebind-private-host-config',str(destination),'--output',str(OUT),
        '--raw-directory',str(RAW),'--campaign','D877_20261026'],
        cwd=ROOT,stdout=log,stderr=subprocess.STDOUT,check=True)
source=read(OUT/'source_spec.json')
previous=read(ROOT/'paper_results/ieee_tc/p2_backend/d725_3b_graph_profile/source_spec.json')
assert source['waves']==previous['waves'] and source['representatives']==previous['representatives']
for name in ('start_remote.sh','stop_remote.sh','run_and_release.sh','check_remote_health_stdlib.py'):
    old=RAW.parent/'d725_20261022'/name
    content=old.read_text().replace('d725_20261022','d877_20261026').replace('d725-graph-profile','d877-private-host-profile').replace('source.sh d725','source.sh d877')
    with (RAW/name).open('x') as f:f.write(content)
    if name.endswith('.sh'):subprocess.run(['bash','-n',str(RAW/name)],check=True)
    else:compile(content,str(RAW/name),'exec')
prelaunch=OUT/'prelaunch';prelaunch.mkdir()
refs=[p.PLAN,ROOT/'docs/ieee_tc/METRIC_PROTOCOL_FROZEN_V1.md',
    ROOT/'docs/ieee_tc/METRIC_PROTOCOL_SINGLE_RUN_V2.md',destination,
    ROOT/'scripts/ieee_tc_preflight.py',ROOT/'scripts/ieee_tc/prepare_d701_3b_same_spec_profile.py',
    ROOT/'scripts/ieee_tc/export_d701_3b_profile.py',ROOT/'scripts/ieee_tc/run_d298_capacity_source.sh',
    ROOT/'tests/test_ieee_tc_preflight.py',ROOT/'faaslora/memory/gpu_monitor.py',
    ROOT/'faaslora/memory/residency_manager.py',ROOT/'faaslora/scheduling/core_interleave.py',
    ROOT/'faaslora/scheduling/vllm_ieee_scheduler.py',RAW/'tests.log',
    *[path for path in OUT.iterdir() if path.is_file()]]
for path in sorted(RAW.iterdir()):
    if path.suffix in ('.py','.sh'):
        refs.append(path)
        with (prelaunch/(path.name+'.snapshot')).open('xb') as f:f.write(path.read_bytes())
save(prelaunch/'qualification.json',dict(passed=True,identity=identity,command=command,
    refs={str(path):p.digest(path) for path in refs},protected=protected,
    cases_reused=423,timing_samples_reused=False,correctness_checks_reused='D874/D875',
    frozen_slo_changed=False,resident_reference_changed=False,n_correct=None,
    ranking_eligible=False,resources=p.cgroup_snapshot(Path(identity['path']))))
print('D877: same 423 cases, explicit new timing identity; ready for one native collection')
