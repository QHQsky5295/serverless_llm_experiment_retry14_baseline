"""Reuse D840 complete-W2 accounting after D846 physical release."""
import hashlib
import json
from pathlib import Path

_raw = Path(__file__).resolve().parent
_template = _raw.parent / 'd840_20261025/completion_program.py.snapshot'
_sha = hashlib.sha256(_template.read_bytes()).hexdigest()
assert _sha == '078dbc38e7dc5d6843173a8f96fe03b02ef5a646014adfa50bdd284a8c825c8c'
_source = _template.read_text()
_replacements = (
    ('d840_3b_single_thread_decoder_full_w2', 'd846_3b_staging_identity_full_w2'),
    ('d840_20261025', 'd846_20261025'),
    ('D840_SINGLE_THREAD_DECODER_FULL_W2_20261025.md',
     'D846_STAGING_IDENTITY_FULL_W2_20261025.md'),
    ('d840_single_w2_frozen_resource_reference_observation_v1',
     'd846_single_w2_frozen_resource_reference_observation_v1'),
    ("protected = ROOT/'paper_results/ieee_tc/p2_backend/d839_single_thread_decoder/closure.json'\n"
     "assert p.digest(protected) == qualification['reused'][str(protected)]\n"
     "for path, sha in read(protected)['user_protected'].items():",
     "for path, sha in qualification['protected'].items():"),
)
for _old, _new in _replacements:
    assert _source.count(_old) >= 1, _old
    _source = _source.replace(_old, _new)
compile(_source, str(_raw/'completion_program.py.snapshot'), 'exec')
with (_raw/'completion_template.json').open('x') as _stream:
    json.dump(dict(source=str(_template), sha256=_sha, replacements=_replacements,
        changes='Run/output identities and prelaunch protected-reference shape only; reuse unchanged complete metrics, stages, fixed SLO and budget accounting. No profiling, numerical-correctness inference or ranking claim.'),
        _stream, indent=2)
    _stream.write('\n')
with (_raw/'completion_program.py.snapshot').open('x') as _stream:
    _stream.write(_source)
exec(compile(_source, str(_raw/'completion_program.py.snapshot'), 'exec'), globals())
