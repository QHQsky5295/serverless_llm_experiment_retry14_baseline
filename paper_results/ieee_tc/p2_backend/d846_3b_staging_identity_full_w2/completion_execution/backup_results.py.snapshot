"""Reuse the existing explicit-path result backup, without touching user dirt."""
import hashlib
from pathlib import Path

_raw = Path(__file__).resolve().parent
_template = _raw.parent/'d826_20261025/backup_results.py'
assert hashlib.sha256(_template.read_bytes()).hexdigest() == 'e0a920555b39e4fe64c67355a8177ed14db98dd35bf22144dd7952c0479e16b9'
_source = _template.read_text()
_replacements = (
    ('d826_3b_single_verification_full_w2', 'd846_3b_staging_identity_full_w2'),
    ('D826_SINGLE_VERIFICATION_FULL_W2_20261025.md', 'D846_STAGING_IDENTITY_FULL_W2_20261025.md'),
    ("(q['refs'] | q['reused']).items()", "q['refs'].items()"),
    ("protected.update(read(ROOT / 'paper_results/ieee_tc/p2_backend/d825_single_destination_verification/closure.json')['user_protected'])",
     "protected.update(q['protected'])"),
    ("'start_identity.json', 'completion_identity.json', 'context_identity.json'):",
     "'start_identity.json', 'completion_identity.json', 'context_identity.json', 'settlement_resume_identity.json'):"),
    ("small = ('complete.py', 'close_context.py', 'backup_results.py',\n"
     "         'completion_program.py.snapshot', 'context_program.py.snapshot',\n"
     "         'completion_identity.json', 'context_identity.json',\n"
     "         'completion_template.json', 'context_template.json',\n"
     "         'start_receipt.json', 'backup.json', 'commit.json',\n"
     "         'remote_start.log', 'remote_stop.log', 'remote_health.json',\n"
     "         'analysis_metrics.log', 'analysis_stages.log', 'completion.log', 'context.log')",
     "small = ('complete.py', 'close_delivery.py', 'backup_results.py',\n"
     "         'completion_program.py.snapshot', 'context_program.py.snapshot',\n"
     "         'completion_identity.json', 'context_identity.json',\n"
     "         'completion_template.json', 'delivery_template_reuse.json',\n"
     "         'start_receipt.json', 'backup.json', 'commit.json',\n"
     "         'remote_start.log', 'remote_stop.log', 'remote_health.json',\n"
     "         'analysis_metrics.log', 'analysis_stages.log',\n"
     "         'context_program.py.snapshot.log', 'settlement_resume_program.py.snapshot.log',\n"
     "         'settlement_resume_identity.json', 'backup_program.py.snapshot')"),
    ('3e24adf7f8bfa58304c7e29267af4a4d07d5758ecd07d8a8d7da4deefae5a417',
     '1cd8fee097c86d8bc84081209ae082a2cc7e57190e018c6a83051a9114874e22'),
    ('Reuse D825 446 distinct checks and D826 7 entry checks; no production change during closure.',
     'Reuse D845 67 targeted CPU checks and D846 23 run-contract checks. Complete 4000-request metrics/stages, delivery, native-owner and settlement audits passed; no new production change or replay during closure.'),
    ('tc: seal D826 full W2 mixed outcome and actual content verification',
     'tc: preserve D846 full W2 staging identity trade-off and delivery evidence'),
    ('backup/d826-complete-20261025', 'backup/d846-complete-20261025'),
)
for _old, _new in _replacements:
    assert _old in _source, _old
    _source = _source.replace(_old, _new)
_marker = "files.append(OUT / 'closure_manifest.json')"
assert _source.count(_marker) == 1
_source = _source.replace(_marker, _marker + '''
assert read(OUT/'settlement_analysis/summary.json')['passed'] is True
assert read(OUT/'delivery_closure/resolved.json')['passed'] is True
for directory in ('settlement_analysis', 'delivery_closure'):
    files.extend(path for path in sorted((OUT/directory).rglob('*')) if path.is_file())
''')
compile(_source, str(_raw/'backup_program.py.snapshot'), 'exec')
with (_raw/'backup_program.py.snapshot').open('x') as _stream:
    _stream.write(_source)
exec(compile(_source, str(_raw/'backup_program.py.snapshot'), 'exec'), globals())
