"""Reuse D846's explicit-path backup; preserve the failed offline driver too."""
import hashlib
from pathlib import Path

_raw = Path(__file__).resolve().parent
_template = _raw.parent/'d846_20261025/backup_program.py.snapshot'
assert hashlib.sha256(_template.read_bytes()).hexdigest() == '1d4bd97aa0833c68824b6d1e4aaa18091d0d4bd11706369d686101964aedaee3'
_source = _template.read_text()
_replacements = (
    ('d846_3b_staging_identity_full_w2', 'd854_3b_async_file_full_w2'),
    ('D846_STAGING_IDENTITY_FULL_W2_20261025.md', 'D854_ASYNC_FILE_FULL_W2_20261025.md'),
    ("'start_identity.json', 'completion_identity.json', 'context_identity.json', 'settlement_resume_identity.json'):",
     "'start_identity.json', 'completion_identity.json', 'completion_resume_identity.json', 'context_identity.json', 'settlement_resume_identity.json'):"),
    ("small = ('complete.py', 'close_delivery.py', 'backup_results.py',",
     "small = ('complete.py', 'complete_resume.py', 'close_delivery.py', 'backup_results.py',"),
    ("         'completion_program.py.snapshot', 'context_program.py.snapshot',",
     "         'context_program.py.snapshot',"),
    ("         'completion_identity.json', 'context_identity.json',",
     "         'completion_identity.json', 'completion_resume_identity.json', 'context_identity.json',"),
    ("         'completion_template.json', 'delivery_template_reuse.json',",
     "         'completion.log', 'completion_resume.log', 'delivery_closure.log', 'delivery_template_reuse.json',"),
    ('1cd8fee097c86d8bc84081209ae082a2cc7e57190e018c6a83051a9114874e22',
     'b8bd2cf49635532a20f3f80c38c34cb3c44949dab02b1a5b13b4e04b75471a35'),
    ('Reuse D845 67 targeted CPU checks and D846 23 run-contract checks. Complete 4000-request metrics/stages, delivery, native-owner and settlement audits passed; no new production change or replay during closure.',
     'Reuse D853 187 distinct targeted checks and D854 4 run-contract checks. Complete 4000-request metrics/stages, delivery, native-owner and settlement audits passed; preserve the initial offline-environment failure and successful continuation. No production change or GPU replay during closure.'),
    ('tc: preserve D846 full W2 staging identity trade-off and delivery evidence',
     'tc: preserve D854 full W2 async file regression and delivery evidence'),
    ('backup/d846-complete-20261025', 'backup/d854-complete-20261026'),
)
for _old, _new in _replacements:
    assert _old in _source, _old
    _source = _source.replace(_old, _new)
compile(_source, str(_raw/'backup_program.py.snapshot'), 'exec')
with (_raw/'backup_program.py.snapshot').open('x') as _stream:
    _stream.write(_source)
exec(compile(_source, str(_raw/'backup_program.py.snapshot'), 'exec'), globals())
