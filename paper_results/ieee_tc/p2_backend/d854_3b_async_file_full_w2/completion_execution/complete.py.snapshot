"""D854: reuse D846 completion; execute only after physical release."""
# Source: /home/qhq/serverless_llm_experiment/results/ieee_tc/p2_backend_qualification/d846_20261025/completion_program.py.snapshot
# SHA256: c6305992a82900f39f0b2bbbd05a789354c7aa1c952bb0c217195df2e88e949c
# Changes: output/campaign/document identity only; metrics and acceptance unchanged.
import hashlib
import json
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
RAW = Path(__file__).resolve().parent
RUN = RAW / '3b_max3_full_w2'
OUT = ROOT / 'paper_results/ieee_tc/p2_backend/d854_3b_async_file_full_w2/completion'
PYTHON = '/home/qhq/.venvs/primelora_vllm0300_tc_20260925/bin/python'
sys.path.insert(0, str(ROOT))
from scripts import ieee_tc_preflight as p


def read(path):
    return json.loads(path.read_text())


def save(path, value):
    with path.open('x') as stream:
        json.dump(value, stream, indent=2, allow_nan=False)
        stream.write('\n')


def ref(path):
    return dict(path=str(path), sha256=p.digest(path))


own = p.scope_identity(p.cg_path().name)
save(RAW / 'completion_identity.json', own)
group = Path(own['path'])
events_before = (group / 'memory.events').read_text()
assert os.sched_getaffinity(0) == {2, 3, 26, 27}
assert not subprocess.check_output(
    ['nvidia-smi', '--query-compute-apps=pid', '--format=csv,noheader'], text=True).strip()
launch = read(RUN / 'launch.json')
assert all(launch[k] is True for k in
           ('pass', 'service_path_removed', 'native_gpu_context_release_confirmed'))
assert all(launch[k] == 0 for k in
           ('service_returncode', 'watchdog_returncode', 'replay_returncode'))
stop = (RAW / 'remote_stop.log').read_text()
assert stop.count('ActiveState=inactive') == 3 and stop.count('MainPID=0') == 3
paths = [line for line in stop.splitlines()
         if line.startswith('/home/lab14/primelora_remote/tc/d80_20260927/3b/transfers-')
         and line.endswith('.jsonl')]
assert len(paths) == 1
for local, remote in (
    ('remote_transfers.jsonl', paths[0]),
    ('remote_monitor.log', '/home/lab14/primelora_remote/tc/d854_20261025/remote_monitor.log'),
):
    with (RAW / local).open('xb') as stream:
        subprocess.run(['ssh', '-o', 'BatchMode=yes', 'primelora-artifact-174', 'cat', remote],
                       stdout=stream, stderr=subprocess.PIPE, check=True, timeout=60)

monitor_sha = next(line.split()[0] for line in stop.splitlines()
                   if line.endswith('/d854_20261025/remote_monitor.log'))
assert p.digest(RAW/'remote_monitor.log') == monitor_sha
OUT.mkdir(parents=True, exist_ok=False)
save(OUT / 'delivery_audit_status.json', dict(
    status='pending_attempt_level_delivery_audit',
    reason='D816 permits deferred preparation; do not apply the legacy all-published assertion.',
    no_delivery_correctness_or_zero_cost_inference=True))
metric = OUT / 'full4000.json'
base = [PYTHON, '-B', '-m', 'scripts.ieee_tc.audit_d703_3b_full', '--raw', str(RUN)]
commands = [
    ('metrics', base + ['--reevaluate-common-slo', str(metric), '--expected-count', '4000']),
    ('stages', base + ['--diagnose-common-slo', str(OUT / 'stages'), '--metric-audit', str(metric)]),
]
for name, command in commands:
    with (RAW / ('analysis_' + name + '.log')).open('x') as log:
        subprocess.run(command, cwd=ROOT, stdout=log, stderr=subprocess.STDOUT, check=True)

# Reuse D725 profile binding; do not invoke D703's historical profile audit.
import ijson
with (RUN / 'launch.launch/physical_deployment/main_outcome.json').open('rb') as stream:
    contract = next(ijson.items(stream, 'launch_contract', use_float=True))
profiles = ROOT / 'paper_results/ieee_tc/p2_backend/d725_3b_graph_profile/export'
assert contract['replay_scope'] == 'full_source_v1'
assert contract['service_profile_id'] == p.digest(profiles / 'service.json')
assert contract['preparation_profile_id'] == p.digest(profiles / 'preparation.json')
save(OUT / 'actual_profile_binding.json', dict(
    passed=True, launch_contract=contract,
    prelaunch=ref(OUT.parent / 'prelaunch/qualification.json'),
    service=ref(profiles / 'service.json'), preparation=ref(profiles / 'preparation.json')))

qualification = read(OUT.parent / 'prelaunch/qualification.json')
assert qualification['passed'] is True
for path, sha in qualification['protected'].items():
    assert p.digest(Path(path)) == sha, path
seal_path = RAW.parent.parent/'slora_qualification/d435_20261011/protected_before.json'
assert p.digest(seal_path) == '79df0c64c0d88236bc20b439d735f8dcab113f06582421151742aa63a5a2be54'
seal = p.verify_seal(seal_path)
assert seal['pass'] and seal['entry_count'] == 147
save(OUT/'protected_147_after.json', seal)
save(OUT/'owner_publication_audit_status.json', dict(
    status='pending_actual_full_transfer_owner_anchor_and_settlement_evidence_audit',
    final_content_verification_required=True,
    stream_content_verification_not_required_for_owner_publication=True,
    historical_owner_anchor_is_not_fresh_tier_or_capacity=True,
    settlement_join_time_is_not_background_finish_time=True))
head = read(RAW/'start_receipt.json')['head']
evolving_docs = {
    ROOT/'docs/ieee_tc/EXECUTION_STATUS.md',
    ROOT/'docs/ieee_tc/D854_ASYNC_FILE_FULL_W2_20261025.md',
}
for name, sha in qualification['refs'].items():
    path = Path(name)
    if path in evolving_docs:
        content = subprocess.check_output(
            ['git', 'show', head+':'+str(path.relative_to(ROOT))], cwd=ROOT)
        assert hashlib.sha256(content).hexdigest() == sha, name
    else:
        assert p.digest(path) == sha, name
actual = read(metric)

assert actual['workload'] == 'W2' and actual['full_replay'] and not actual['full_w0']
reference_path = ROOT/'paper_results/ieee_tc/main_comparison/d657_3b_references/resident_references.json'
assert p.digest(reference_path) == 'f030f92f7bc426c427c6fa0ea65c8dd315a39cf52fd922973fc507117f30ea7a'
reference = read(reference_path)['W2']
assert reference['workload'] == actual['workload']
assert reference['slo_eval_sha256'] == actual['common_slo_sha256']
comparison = dict(
    kind='d854_single_w2_frozen_resource_reference_observation_v1',
    current=ref(metric), reference=ref(reference_path), reference_workload='W2',
    reference_id=reference['reference_id'],
    reference_gpu_seconds=reference['U_ref_gpu_seconds'],
    budget_gpu_seconds=reference['B_gpu_seconds'],
    observed_within_budget=actual['physical_gpu_seconds'] <= reference['B_gpu_seconds'],
    budget_utilization=actual['physical_gpu_seconds']/reference['B_gpu_seconds'],
    gpu_seconds_reduction_fraction=1-actual['physical_gpu_seconds']/reference['U_ref_gpu_seconds'],
    gpu_seconds_per_binding_valid_request=actual['physical_gpu_seconds']/4000,
    joint_slo_delta_percentage_points=100*(actual['joint_slo_fraction']-reference['source_observed_joint_slo']),
    normalized_p95_ttft=actual['metrics']['ttft_ms']['p95_type1']/reference['Q_ref_p95_ttft_ms'],
    joint_slo_margin_requests=actual['counts']['joint_pass']-3800,
    n_correct=actual['n_correct'], ranking_eligible=False, confidence_interval=None,
    complete_g1_g2=False, independent_holdout=False,
    scope='Known W2 development observation versus the frozen W2 resident reference; no cross-workload improvement claim, independent numerical proof, or final ranking.')
save(OUT / 'comparison.json', comparison)
assert (group / 'memory.events').read_text() == events_before
assert (group / 'memory.swap.current').read_text().strip() == '0'
save(OUT / 'analysis_resources.json', dict(identity=own, resources={
    key: (group / key).read_text().strip()
    for key in ('memory.peak', 'memory.events', 'memory.swap.current')}))
with (OUT / 'complete.py.snapshot').open('xb') as stream:
    stream.write(Path(__file__).read_bytes())
save(OUT / 'manifest.json', dict(files=[
    dict(path=str(path.relative_to(ROOT)), sha256=p.digest(path))
    for path in sorted(OUT.rglob('*')) if path.is_file()]))
print(json.dumps(dict(counts=actual['counts'], joint_slo_fraction=actual['joint_slo_fraction'],
    physical_gpu_seconds=actual['physical_gpu_seconds'], metrics=actual['metrics'],
    n_correct=actual['n_correct'], comparison=comparison), indent=2))
