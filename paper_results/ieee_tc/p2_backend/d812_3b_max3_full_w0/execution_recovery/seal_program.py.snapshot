"""Close D752 and audit actual descriptor receipts; no new replay or policy."""
import collections
import json
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
RAW = Path(__file__).resolve().parent
OUT = ROOT/'paper_results/ieee_tc/p2_backend/d812_3b_max3_full_w0'
sys.path.insert(0, str(ROOT))
import ijson
from scripts import ieee_tc_preflight as p

def read(path): return json.loads(path.read_text())
def save(path, value):
    with path.open('x') as stream:
        json.dump(value, stream, indent=2, allow_nan=False)
        stream.write('\n')
def ref(path): return dict(path=str(path), sha256=p.digest(path))

assert os.sched_getaffinity(0) == {2, 3, 26, 27}
own = p.scope_identity(p.cg_path().name)
save(RAW/'closure_identity.json', own)
assert not subprocess.check_output(['nvidia-smi', '--query-compute-apps=pid', '--format=csv,noheader'], text=True).strip()
for item in read(OUT/'completion/manifest.json')['files']:
    assert p.digest(ROOT/item['path']) == item['sha256']
q = read(OUT/'prelaunch/qualification.json')
metric_path = OUT/'completion/full4000.json'
metric = read(metric_path)
source = next(Path(s['path']) for s in metric['source_refs'] if Path(s['path']).name.startswith('experiment_results_full'))
expected = q['candidate_environment']
receipts = 0
workers = collections.Counter()
requests = 0

def descriptors(value):
    if isinstance(value, dict):
        if 'native_host_descriptor' in value:
            yield value['native_host_descriptor'], value.get('worker_pid', value.get('pid'))
        for child in value.values():
            yield from descriptors(child)
    elif isinstance(value, list):
        for child in value:
            yield from descriptors(child)

with source.open('rb') as stream:
    for row in ijson.items(stream, 'detailed_results.tc_ieee_full.requests.item', use_float=True):
        found = list(descriptors(row['gpu_reference_evidence']))
        assert found, row['request_id']
        for desc, pid in found:
            assert desc['kind'] == 'fresh_native_tensor_descriptor_v1'
            assert desc['library'] == expected['FAASLORA_IEEE_HOST_DESCRIPTOR_LIBRARY']
            assert desc['sha256'] == expected['FAASLORA_IEEE_HOST_DESCRIPTOR_SHA256']
            assert desc['tensor_state_cached'] is False
            assert desc['torch_version'] == '2.13.0+cu130' and desc['python_abi'] == 'cpython-312'
            assert isinstance(pid, int) and pid > 0
            workers[pid] += 1
        receipts += len(found)
        requests += 1
assert requests == 4000 and len(workers) == 3

comparisons = []
for label, path in (
    ('D752_direct_parent', ROOT/'paper_results/ieee_tc/p2_backend/d752_3b_dense_alias_validation_full_w0/completion/full4000.json'),
    ('D703_historical', ROOT/'paper_results/ieee_tc/p2_backend/d714_common_slo_correction/d703_verified.json'),
    ('D745_rejected', ROOT/'paper_results/ieee_tc/p2_backend/d745_3b_observe_after_turn_full_w0/completion/full4000.json')):
    old = read(path)
    comparisons.append(dict(label=label, source=ref(path),
        previous_joint_slo=old['joint_slo_fraction'],
        previous_gpu_seconds=old['physical_gpu_seconds'],
        joint_difference_percentage_points=100*(metric['joint_slo_fraction']-old['joint_slo_fraction']),
        gpu_seconds_reduction_fraction=(old['physical_gpu_seconds']-metric['physical_gpu_seconds'])/old['physical_gpu_seconds']))

budget_path = ROOT/'paper_results/ieee_tc/main_comparison/d657_3b_references/resident_references.json'
budget = read(budget_path)['W0']
parent = read(ROOT/'paper_results/ieee_tc/p2_backend/d752_3b_dense_alias_validation_full_w0/completion/full4000.json')
save(OUT/'resource_quality_observation.json', dict(
    kind='d812_single_w0_resource_quality_observation_v1',
    current=ref(metric_path), reference=ref(budget_path),
    parent_comparison=comparisons[0],
    budget_gpu_seconds=budget['B_gpu_seconds'],
    observed_within_budget=metric['physical_gpu_seconds'] <= budget['B_gpu_seconds'],
    budget_utilization=metric['physical_gpu_seconds']/budget['B_gpu_seconds'],
    gpu_seconds_per_binding_valid_request=metric['physical_gpu_seconds']/4000,
    resident_gpu_time_reduction_fraction=1-metric['physical_gpu_seconds']/budget['U_ref_gpu_seconds'],
    joint_slo_margin_requests=metric['counts']['joint_pass']-3800,
    mean_ttft_change_ms=metric['metrics']['ttft_ms']['mean']-parent['metrics']['ttft_ms']['mean'],
    p95_ttft_change_ms=metric['metrics']['ttft_ms']['p95_type1']-parent['metrics']['ttft_ms']['p95_type1'],
    n_correct=metric['n_correct'], ranking_eligible=False, independent_holdout=False,
    confidence_interval=None, complete_g1_g2=False,
    note='W0-only development observation; near-threshold attainment and unresolved independent numerical proof remain explicit. No same-key rerun. W1/W2 use the same configuration.'))

counts = metric['counts']
partition = dict(ttft_only_fail=counts['tpot_pass']-counts['joint_pass'],
    tpot_only_fail=counts['ttft_pass']-counts['joint_pass'],
    both_fail=counts['n']-counts['ttft_pass']-counts['tpot_pass']+counts['joint_pass'])
assert sum(partition.values()) == counts['n']-counts['joint_pass']

run = Path(metric['source_run'])
launch = read(run/'launch.json')
assert launch['pass'] and launch['service_path_removed'] and launch['native_gpu_context_release_confirmed']
identities = [read(RAW/name) for name in ('completion_identity.json',)]
aux = Path(read(run/'launch.launch/exec_receipt.json')['auxiliary_path'])
if aux.exists(): identities.append(p.scope_identity(aux.name))
closures = []
for identity in identities:
    path = Path(identity['path'])
    if path.exists():
        assert p.scope_still_owned(identity) and not p.owned_pids(path)
        result = p.stop_scope_identity(identity, grace_seconds=0)
        assert result['released'] and not result['targets']
    else: result = dict(already_removed=True, released=True)
    closures.append(dict(identity=identity, result=result))
group = Path(own['path'])
assert all(int(line.split()[1]) == 0 for line in (group/'memory.events').read_text().splitlines())
assert (group/'memory.swap.current').read_text().strip() == '0'
save(OUT/'closure.json', dict(kind='d812_closed_max3_resource_observation_v1', passed=True,
    actual_descriptor=dict(requests=requests, receipts=receipts, worker_receipts=dict(workers), configuration=expected),
    counts=counts, violation_partition=partition, shortfall_to_3800=max(0,3800-counts['joint_pass']),
    metric_source=ref(metric_path), comparisons=comparisons,
    candidate_disposition='retain_d812_single_w0_latency_and_budget_observation_pending_w1_w2',
    observed_latency_feasible=metric['observed_latency_feasible'],
    n_correct=metric['n_correct'], ranking_eligible=False, confidence_interval=None,
    primary_targets_achieved=False, new_replays=0,
    decision='Freeze this single W0 observation: 3802/4000 satisfy common joint latency limits, with reduced GPU time versus D752 and U below the frozen W0 budget. The 2-request margin is descriptive, not a robustness guarantee. Retain the same max3 configuration for W1/W2; do not repeat this key, change thresholds or claim complete G1/G2, cross-workload superiority or independent numerical adapter correctness. Preserve all prior points and the complete remaining matrix.',
    closures=closures, protected_publication_files=len(q['protected']),
    analysis_launcher_failure=None,
    resources={k:(group/k).read_text().strip() for k in ('memory.peak','memory.events','memory.swap.current')}))
with (OUT/'seal.py.snapshot').open('xb') as stream: stream.write(Path(__file__).read_bytes())
print(json.dumps(dict(passed=True, descriptor_requests=requests, receipts=receipts, workers=dict(workers), comparisons=comparisons, violation_partition=partition), indent=2))
