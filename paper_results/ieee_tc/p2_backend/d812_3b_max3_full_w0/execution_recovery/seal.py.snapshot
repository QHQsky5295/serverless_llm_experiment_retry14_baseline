"""Reuse D752's streamed descriptor/closure audit for the max3 observation."""
import hashlib
import json
from pathlib import Path

_raw = Path(__file__).resolve().parent
_template = _raw.parent / 'd752_20261023/seal.py'
_source = _template.read_text()
_replacements = [
    ('d752_3b_dense_alias_validation_full_w0', 'd812_3b_max3_full_w0'),
    ('assert requests == 4000 and len(workers) == 4',
     'assert requests == 4000 and len(workers) == 3'),
    ('D749_direct_parent', 'D752_direct_parent'),
    ('d749_3b_fresh_host_descriptor_full_w0/completion/full4000.json',
     'd752_3b_dense_alias_validation_full_w0/completion/full4000.json'),
    ('d752_closed_fresh_descriptor_observation_v1',
     'd812_closed_max3_resource_observation_v1'),
    ('retain_d751_w0_latency_feasible_not_complete_g1_g2',
     'retain_d812_single_w0_latency_and_budget_observation_pending_w1_w2'),
    ('Freeze this single W0 observation: common joint latency attainment exceeds 95%, but physical GPU time increased versus D749. Retain D751 without claiming resource improvement, complete G1/G2, cross-workload superiority, or independent numerical adapter correctness. Do not repeat this key. Preserve direct-parent and historical comparisons, all failed candidates, and the complete remaining matrix.',
     'Freeze this single W0 observation: 3802/4000 satisfy common joint latency limits, with reduced GPU time versus D752 and U below the frozen W0 budget. The 2-request margin is descriptive, not a robustness guarantee. Retain the same max3 configuration for W1/W2; do not repeat this key, change thresholds or claim complete G1/G2, cross-workload superiority or independent numerical adapter correctness. Preserve all prior points and the complete remaining matrix.'),
]
for _old, _new in _replacements:
    assert _old in _source, _old
    _source = _source.replace(_old, _new)
_insertion = '''
budget_path = ROOT/'paper_results/ieee_tc/main_comparison/d657_3b_references/resident_references.json'
budget = read(budget_path)['W0']
parent = read(ROOT/'paper_results/ieee_tc/p2_backend/d752_3b_dense_alias_validation_full_w0/completion/full4000.json')
save(OUT/'resource_quality_observation.json', dict(
    kind='d812_single_w0_resource_quality_observation_v1',
    current=ref(metric_path), reference=ref(budget_path),
    parent_comparison=comparisons[0],
    budget_gpu_seconds=budget['B_gpu_seconds'],
    observed_within_budget=metric['physical_gpu_seconds'] <= budget['B_gpu_seconds'],
    budget_utilization=metric['physical_gpu_seconds']/budget['B_gpu_seconds'],
    gpu_seconds_per_binding_valid_request=metric['physical_gpu_seconds']/4000,
    resident_gpu_time_reduction_fraction=1-metric['physical_gpu_seconds']/budget['U_ref_gpu_seconds'],
    joint_slo_margin_requests=metric['counts']['joint_pass']-3800,
    mean_ttft_change_ms=metric['metrics']['ttft_ms']['mean']-parent['metrics']['ttft_ms']['mean'],
    p95_ttft_change_ms=metric['metrics']['ttft_ms']['p95_type1']-parent['metrics']['ttft_ms']['p95_type1'],
    n_correct=metric['n_correct'], ranking_eligible=False, independent_holdout=False,
    confidence_interval=None, complete_g1_g2=False,
    note='W0-only development observation; near-threshold attainment and unresolved independent numerical proof remain explicit. No same-key rerun. W1/W2 use the same configuration.'))
'''
assert 'counts = metric[\'counts\']' in _source
_source = _source.replace("counts = metric['counts']", _insertion + "\ncounts = metric['counts']", 1)
with (_raw/'seal_template.json').open('x') as _stream:
    json.dump(dict(path=str(_template), sha256=hashlib.sha256(
        _template.read_bytes()).hexdigest(), replacements=_replacements), _stream, indent=2)
    _stream.write('\n')
with (_raw/'seal_program.py.snapshot').open('x') as _stream:
    _stream.write(_source)
exec(compile(_source, str(_raw/'seal_program.py.snapshot'), 'exec'), globals())
