"""Resume D732 before commit: explicitly retain three small gitignored test logs."""
import ast
import json
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path
ROOT = Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
RAW = Path(__file__).resolve().parent
OUT = ROOT/'paper_results/ieee_tc/p2_backend/d732_3b_round_file_full_w0/prelaunch'
BASE = ROOT/'paper_results/ieee_tc/p2_backend/d731_shared_file_observation'
sys.path.insert(0, str(ROOT))
from scripts import ieee_tc_preflight as p
def read(path): return json.loads(path.read_text())
def save(path, value):
    with path.open('x') as f:
        json.dump(value, f, indent=2, allow_nan=False)
        f.write('\n')
def call(args):
    return subprocess.check_output(args, cwd=ROOT, text=True, stderr=subprocess.STDOUT, timeout=60).strip()
assert os.sched_getaffinity(0) == {2,3,26,27}
own = p.scope_identity(p.cg_path().name)
save(RAW/'resume_identity.json', own)
assert not call(['nvidia-smi','--query-compute-apps=pid','--format=csv,noheader'])
q = read(OUT/'qualification.json')
for name, sha in (q['refs'] | q['protected']).items():
    assert p.digest(Path(name)) == sha, name
for item in read(BASE/'manifest.json')['files']:
    assert p.digest(Path(item['path'])) == item['sha256']
for item in read(OUT/'manifest.json')['files']:
    assert p.digest(ROOT/item['path']) == item['sha256']
previous = read(RAW/'start_identity.json')
assert p.scope_still_owned(previous) and not p.owned_pids(Path(previous['path']))
closed = p.stop_scope_identity(previous, grace_seconds=0)
assert closed['released'] and not closed['targets']
save(OUT/'initial_start_stop.json', dict(
    reason='git add refused three small *.log evidence files under the existing ignore rule; no commit, remote operation or GPU run had started.',
    previous_scope=previous, closure=closed))
with (OUT/'resume_start.py.snapshot').open('x') as f:
    f.write(Path(__file__).read_text())
paths = ['scripts/run_all_experiments.py','tests/test_ieee_tc_planning_snapshot.py',
 'tests/test_ieee_tc_transfer_pressure.py','scripts/ieee_tc/run_d293_7b_prefetch_validation_100.sh',
 'configs/ieee_tc/20261022_d732_3b_round_file_full_w0.yaml',
 'docs/ieee_tc/D731_SHARED_FILE_OBSERVATION_20261022.md',
 'docs/ieee_tc/D732_3B_ROUND_FILE_FULL_W0_20261022.md','docs/ieee_tc/EXECUTION_STATUS.md']
paths += [str(f.relative_to(ROOT)) for folder in (OUT,BASE) for f in sorted(folder.iterdir()) if f.is_file()]
assert len(paths) == len(set(paths))
assert set(call(['git','diff','--cached','--name-only']).splitlines()) <= set(paths)
assert 'configs/generated/lora_manifest_1000.json' not in paths
secret = re.compile(r'-----BEGIN (?:OPENSSH |RSA |EC )?PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]+|(?im:^[ \t]*(?:password|passwd|secret|api_key|PRIME_REMOTE_TOKEN)[ \t]*=[ \t]*[\x22\x27]?[A-Za-z0-9+/]{8,})')
for name in paths:
    assert not secret.search((ROOT/name).read_text()), name
logs = [s for s in paths if s.endswith('.log')]
assert len(logs) == 3 and all((ROOT/s).stat().st_size < 10000 for s in logs)
ordinary = [s for s in paths if s not in logs]
call(['git','add','--',*ordinary])
call(['git','add','-f','--',*logs])
assert set(call(['git','diff','--cached','--name-only']).splitlines()) == set(paths)
call(['git','diff','--cached','--check','--',*ordinary])
call(['git','-c','core.whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol','diff','--cached','--check','--',*logs])
call(['git','commit','-m','tc: qualify shared control-round file observations and prepare full 3B W0 (D731-D732)'])
head = call(['git','rev-parse','HEAD'])
ref = 'refs/heads/backup/d732-round-file-full-20261022'
call(['git','push','faaslora_origin','HEAD:'+ref])
assert call(['git','ls-remote','faaslora_origin',ref]).split()[0] == head
save(RAW/'backup.json', dict(passed=True, head=head, ref=ref, files=paths, v2_synchronized=False))
gate = p.preflight([ROOT,RAW],32*p.GIB)
save(RAW/'launch_gate.json', gate)
assert gate['preflight_pass'], gate['issues']
assert not (RAW/'3b_round_file_full_w0').exists() and not Path('/dev/shm/tc-d732-3b-w0').exists()
session = 'tc-d732-3b-round-file-full-w0'
assert subprocess.run(['tmux','has-session','-t',session],stderr=subprocess.DEVNULL).returncode != 0
call(['bash',str(RAW/'start_remote.sh')])
call(['/usr/bin/python3','-B',str(RAW/'check_remote_health_stdlib.py')])
call(['tmux','new-session','-d','-s',session,'-c',str(ROOT),shlex.join(['bash',str(RAW/'run_and_release.sh')])])
save(RAW/'start_receipt.json', dict(launched=True, head=head, backup_ref=ref, tmux=session,
    identity=own, scripts={str(f):p.digest(f) for f in RAW.iterdir() if f.suffix in ('.py','.sh')}))
print(json.dumps(dict(launched=True, head=head, ref=ref, tmux=session)))
