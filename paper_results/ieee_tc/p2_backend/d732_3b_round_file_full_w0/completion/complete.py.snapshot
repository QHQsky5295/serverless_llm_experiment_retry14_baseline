"""D732 closure, mechanically reused from D729; execute only after release."""
import json
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
RAW = Path(__file__).resolve().parent
RUN = RAW / '3b_round_file_full_w0'
OUT = ROOT / 'paper_results/ieee_tc/p2_backend/d732_3b_round_file_full_w0/completion'
PYTHON = '/home/qhq/.venvs/primelora_vllm0300_tc_20260925/bin/python'
sys.path.insert(0, str(ROOT))
from scripts import ieee_tc_preflight as p


def read(path):
    return json.loads(path.read_text())


def save(path, value):
    with path.open('x') as stream:
        json.dump(value, stream, indent=2, allow_nan=False)
        stream.write('\n')


def ref(path):
    return dict(path=str(path), sha256=p.digest(path))


own = p.scope_identity(p.cg_path().name)
save(RAW / 'completion_identity.json', own)
group = Path(own['path'])
events_before = (group / 'memory.events').read_text()
assert os.sched_getaffinity(0) == {2, 3, 26, 27}
assert not subprocess.check_output(
    ['nvidia-smi', '--query-compute-apps=pid', '--format=csv,noheader'], text=True).strip()
launch = read(RUN / 'launch.json')
assert all(launch[k] is True for k in
           ('pass', 'service_path_removed', 'native_gpu_context_release_confirmed'))
assert all(launch[k] == 0 for k in
           ('service_returncode', 'watchdog_returncode', 'replay_returncode'))
stop = (RAW / 'remote_stop.log').read_text()
assert stop.count('ActiveState=inactive') == 3 and stop.count('MainPID=0') == 3
paths = [line for line in stop.splitlines()
         if line.startswith('/home/lab14/primelora_remote/tc/d80_20260927/3b/transfers-')
         and line.endswith('.jsonl')]
assert len(paths) == 1
for local, remote in (
    ('remote_transfers.jsonl', paths[0]),
    ('remote_monitor.log', '/home/lab14/primelora_remote/tc/d732_20261022/remote_monitor.log'),
):
    with (RAW / local).open('xb') as stream:
        subprocess.run(['ssh', '-o', 'BatchMode=yes', 'primelora-artifact-174', 'cat', remote],
                       stdout=stream, stderr=subprocess.PIPE, check=True, timeout=60)

OUT.mkdir(parents=True, exist_ok=False)
metric = OUT / 'full4000.json'
base = [PYTHON, '-B', '-m', 'scripts.ieee_tc.audit_d703_3b_full', '--raw', str(RUN)]
commands = [
    ('metrics', base + ['--reevaluate-common-slo', str(metric), '--expected-count', '4000']),
    ('context', base + ['--audit-closed-outcome', str(OUT / 'closed_outcome.json'),
                        '--metric-audit', str(metric)]),
    ('stages', base + ['--diagnose-common-slo', str(OUT / 'stages'), '--metric-audit', str(metric)]),
]
for name, command in commands:
    with (RAW / ('analysis_' + name + '.log')).open('x') as log:
        subprocess.run(command, cwd=ROOT, stdout=log, stderr=subprocess.STDOUT, check=True)

# Reuse D725 profile binding; do not invoke D703's historical profile audit.
import ijson
with (RUN / 'launch.launch/physical_deployment/main_outcome.json').open('rb') as stream:
    contract = next(ijson.items(stream, 'launch_contract', use_float=True))
profiles = ROOT / 'paper_results/ieee_tc/p2_backend/d725_3b_graph_profile/export'
assert contract['replay_scope'] == 'full_source_v1'
assert contract['service_profile_id'] == p.digest(profiles / 'service.json')
assert contract['preparation_profile_id'] == p.digest(profiles / 'preparation.json')
save(OUT / 'actual_profile_binding.json', dict(
    passed=True, launch_contract=contract,
    prelaunch=ref(OUT.parent / 'prelaunch/qualification.json'),
    service=ref(profiles / 'service.json'), preparation=ref(profiles / 'preparation.json')))

qualification = read(OUT.parent / 'prelaunch/qualification.json')
for path, sha in (qualification['refs'] | qualification['protected']).items():
    assert p.digest(Path(path)) == sha, path
actual = read(metric)
old_path = ROOT / 'paper_results/ieee_tc/p2_backend/d729_3b_bulk_loader_full_w0/completion/full4000.json'
old = read(old_path)
comparison = dict(
    kind='d732_vs_d729_single_run_observation_v1', previous=ref(old_path), current=ref(metric),
    joint_slo_delta_percentage_points=100 * (actual['joint_slo_fraction'] - old['joint_slo_fraction']),
    gpu_seconds_reduction_fraction=(old['physical_gpu_seconds'] - actual['physical_gpu_seconds']) / old['physical_gpu_seconds'],
    n_correct=actual['n_correct'], ranking_eligible=False, confidence_interval=None,
    scope='Known W0 development workload; not independent held-out or cross-workload superiority.')
save(OUT / 'comparison.json', comparison)
assert (group / 'memory.events').read_text() == events_before
assert (group / 'memory.swap.current').read_text().strip() == '0'
save(OUT / 'analysis_resources.json', dict(identity=own, resources={
    key: (group / key).read_text().strip()
    for key in ('memory.peak', 'memory.events', 'memory.swap.current')}))
with (OUT / 'complete.py.snapshot').open('xb') as stream:
    stream.write(Path(__file__).read_bytes())
save(OUT / 'manifest.json', dict(files=[
    dict(path=str(path.relative_to(ROOT)), sha256=p.digest(path))
    for path in sorted(OUT.rglob('*')) if path.is_file()]))
print(json.dumps(dict(counts=actual['counts'], joint_slo_fraction=actual['joint_slo_fraction'],
    physical_gpu_seconds=actual['physical_gpu_seconds'], metrics=actual['metrics'],
    n_correct=actual['n_correct'], comparison=comparison), indent=2))
