"""Back up measured initialization and exactly bound Full; invoke the existing starter."""
import json, os, re, subprocess, sys
from pathlib import Path
ROOT=Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
RAW=Path(__file__).resolve().parent
OUT=ROOT/'paper_results/ieee_tc/p2_backend/d880_private_host_full_w2'
PROFILE=ROOT/'paper_results/ieee_tc/p2_backend/d879_private_host_profile'
sys.path.insert(0,str(ROOT))
from scripts import ieee_tc_preflight as p
def read(path):return json.loads(path.read_text())
def save(path,value):
    with path.open('x') as f:json.dump(value,f,indent=2,allow_nan=False);f.write('\n')
def git(*args):return subprocess.check_output(['git',*args],cwd=ROOT,text=True,stderr=subprocess.STDOUT,timeout=55).strip()
assert os.sched_getaffinity(0)=={2,3,26,27}
identity=p.scope_identity(p.cg_path().name);save(RAW/'backup_identity.json',identity)
assert git('branch','--show-current')=='retry14_continuous_queue_v2'
assert git('rev-parse','HEAD')=='ec6dfedf9a1d6f0c24f66bcea48fce7d92aff61c'
assert not git('diff','--cached','--name-only')
q=read(OUT/'prelaunch/qualification.json');assert q['passed']
for name,sha in q['refs'].items():assert p.digest(Path(name))==sha,name
assert not p.owned_pids(Path(q['identity']['path']))
assert read(PROFILE/'completion/summary.json')['passed']
for row in read(PROFILE/'completion/manifest.json')['files']:
    assert p.digest(Path(row['path']))==row['sha256'],row['path']
assert p.digest(ROOT/'configs/generated/lora_manifest_1000.json')=='3b69bd0a6888aa56e98c3b9efb61234860d4b80f25729cfea6b79126d19127df'
paths=['scripts/ieee_tc/run_d293_7b_prefetch_validation_100.sh',
    'configs/ieee_tc/20261026_d880_3b_max3_full_w2.yaml',
    'docs/ieee_tc/D880_PRIVATE_HOST_FULL_W2_20261026.md','docs/ieee_tc/EXECUTION_STATUS.md']
paths += [str(path.relative_to(ROOT)) for directory in (OUT,PROFILE/'export',PROFILE/'completion')
          for path in sorted(directory.rglob('*')) if path.is_file()]
secret=re.compile(r'-----BEGIN (?:OPENSSH |RSA |EC )?PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]+')
for name in paths:assert not secret.search((ROOT/name).read_text())
git('diff','--check','--',*paths);git('add','--',*paths)
assert set(git('diff','--cached','--name-only').splitlines())==set(paths)
git('diff','--cached','--check')
git('commit','-m','tc: bind measured private HOST initialization and launch complete 3B W2 (D880)')
head=git('rev-parse','HEAD');ref='refs/heads/backup/d880-private-host-full-w2-20261026'
save(RAW/'commit.json',dict(commit=head,ref=ref,paths=paths))
git('-c','http.version=HTTP/1.1','push','faaslora_origin','HEAD:'+ref)
assert git('ls-remote','faaslora_origin',ref).split()==[head,ref]
save(RAW/'backup.json',dict(passed=True,commit=head,ref=ref,final_v2_synced=False))
subprocess.run(['/usr/bin/python3','-B',str(RAW/'start.py')],cwd=ROOT,check=True,timeout=55)
