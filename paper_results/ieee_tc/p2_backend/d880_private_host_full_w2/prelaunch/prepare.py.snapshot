"""Bind the completed D879 measurements to the same Full candidate before replay."""
import ast, copy, json, os, subprocess, sys
from pathlib import Path
import yaml
ROOT=Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
RAW=Path(__file__).resolve().parent
OUT=ROOT/'paper_results/ieee_tc/p2_backend/d880_private_host_full_w2/prelaunch'
PROFILE=ROOT/'paper_results/ieee_tc/p2_backend/d879_private_host_profile'
sys.path.insert(0,str(ROOT))
from scripts import ieee_tc_preflight as p
def read(path):return json.loads(path.read_text())
def save(path,value):
    with path.open('x') as f:json.dump(value,f,indent=2,allow_nan=False);f.write('\n')
assert os.sched_getaffinity(0)=={2,3,26,27} and os.environ['CUDA_VISIBLE_DEVICES']==''
identity=p.scope_identity(p.cg_path().name);save(RAW/'prepare_identity.json',identity)
assert not subprocess.check_output(['nvidia-smi','--query-compute-apps=pid','--format=csv,noheader'],text=True).strip()
assert read(PROFILE/'completion/summary.json')['passed']
manifest=read(PROFILE/'export/manifest.json');contract=read(PROFILE/'development_contract.json')
assert manifest['passed'] and manifest['campaign']=='D879_20261026'
gate=p.preflight([ROOT,RAW],32*p.GIB);save(RAW/'preflight.json',gate)
assert gate['preflight_pass'],gate['issues']
source=ROOT/'configs/ieee_tc/20261026_d876_3b_max3_full_w2.yaml'
destination=ROOT/'configs/ieee_tc/20261026_d880_3b_max3_full_w2.yaml'
old=yaml.safe_load(source.read_text());new=copy.deepcopy(old)
new['model']['ieee_admission_profile']=copy.deepcopy(contract['model_config']['ieee_admission_profile'])
for name,field in (('service','ieee_service_profile'),('preparation','ieee_preparation_profile')):
    path=PROFILE/'export'/f'{name}.json'
    sha=p.digest(path);assert sha==manifest[name+'_profile']['profile_sha256']
    new['resource_coordination'][field]=dict(path=str(path),sha256=sha,context=manifest['context'],ewma_beta=.5)
for section,field in [('experiment','output_dir'),('storage','nvme_cache_dir'),('storage','host_cache_dir')]:
    new[section][field]=new[section][field].replace('d876','d880')
restored=copy.deepcopy(new)
restored['model']['ieee_admission_profile']=old['model']['ieee_admission_profile']
for field in ('ieee_service_profile','ieee_preparation_profile'):
    restored['resource_coordination'][field]=old['resource_coordination'][field]
for section,field in [('experiment','output_dir'),('storage','nvme_cache_dir'),('storage','host_cache_dir')]:
    restored[section][field]=old[section][field]
assert restored==old
assert new['model']['ieee_host_construction']=='private_cpu_core_commit_v1'
assert new['workload']['total_requests']==4000 and new['resource_coordination']['max_instances']==3
from scripts.run_all_experiments import ScenarioRunner,_prepare_scenario_runtime_model_config,_prepare_dedicated_subprocess_model_cfg
from faaslora.experiment.instance_pool import FrozenServiceProfiles
runtime=_prepare_scenario_runtime_model_config(new['model'],new['workload'],new['resource_coordination'])
child,_=_prepare_dedicated_subprocess_model_cfg(runtime,device_id=0,runtime_gpu_ids=[0])
assert FrozenServiceProfiles.model_identity(child)==FrozenServiceProfiles.model_identity(contract['model_config'])
runner=ScenarioRunner.__new__(ScenarioRunner);runner.model_cfg=runtime;runner.coord_cfg=new['resource_coordination']
runner._initial_runtime_pending=True
runner._service_profiles=runner._load_ieee_service_profiles();runner._load_ieee_preparation_profiles()
with destination.open('x') as f:yaml.safe_dump(new,f,sort_keys=False)
for name in ('start_remote.sh','stop_remote.sh','run_and_release.sh','check_remote_health_stdlib.py','start.py'):
    text=(RAW.parent/'d876_20261026'/name).read_text().replace('d876','d880').replace('D876','D880')
    with (RAW/name).open('x') as f:f.write(text)
    if name.endswith('.sh'):subprocess.run(['bash','-n',str(RAW/name)],check=True)
    else:ast.parse(text)
text=(RAW.parent/'d870_20261026/complete.py').read_text().replace('d870','d880').replace('D870','D880')
text=text.replace('d880_3b_staged_union_full_w2','d880_private_host_full_w2')
text=text.replace('d725_3b_graph_profile/export','d879_private_host_profile/export')
text=text.replace('Reuse D725 profile binding','Use D879 measured profile binding')
text=text.replace('D880_STAGED_UNION_FULL_W2_20261026.md','D880_PRIVATE_HOST_FULL_W2_20261026.md')
ast.parse(text)
with (RAW/'complete.py').open('x') as f:f.write(text)
launcher=ROOT/'scripts/ieee_tc/run_d293_7b_prefetch_validation_100.sh'
subprocess.run(['bash','-n',str(launcher)],check=True)
case=launcher.read_text().split('  d880)\n',1)[1].split('    ;;',1)[0]
assert 'PREFIX_COUNT=\n' in case and 'SCENARIO=tc_ieee_full' in case
assert launcher.read_text().count('== d880 ||')==2
seal=RAW.parent.parent/'slora_qualification/d435_20261011/protected_before.json'
protected=p.verify_seal(seal);assert protected['pass']
user=ROOT/'configs/generated/lora_manifest_1000.json'
assert p.digest(user)=='3b69bd0a6888aa56e98c3b9efb61234860d4b80f25729cfea6b79126d19127df'
OUT.mkdir(parents=True,exist_ok=False)
refs=[p.PLAN,source,destination,launcher,PROFILE/'development_contract.json',PROFILE/'export/manifest.json',
    PROFILE/'export/service.json',PROFILE/'export/preparation.json',PROFILE/'completion/summary.json',
    ROOT/'docs/ieee_tc/METRIC_PROTOCOL_FROZEN_V1.md',ROOT/'docs/ieee_tc/METRIC_PROTOCOL_SINGLE_RUN_V2.md',
    ROOT/'paper_results/ieee_tc/protocols/20261017_3b_slo_d648_frozen.json',
    ROOT/'paper_results/ieee_tc/main_comparison/d657_3b_references/resident_references.json',
    ROOT/'scripts/run_all_experiments.py',ROOT/'faaslora/memory/gpu_monitor.py',ROOT/'faaslora/memory/residency_manager.py',
    ROOT/'faaslora/scheduling/core_interleave.py',ROOT/'faaslora/scheduling/vllm_ieee_scheduler.py']
for path in sorted(RAW.iterdir()):
    if path.suffix in ('.py','.sh'):
        refs.append(path)
        with (OUT/(path.name+'.snapshot')).open('xb') as f:f.write(path.read_bytes())
save(OUT/'qualification.json',dict(passed=True,identity=identity,refs={str(path):p.digest(path) for path in refs},
    protected={str(user):p.digest(user)},protected_147=protected,requests=4000,new_gpu_replays=0,
    model_identity_matched=True,service_classes=len(runner._service_profiles.profiles),
    config_change='D876 candidate unchanged; matching measured D879 initialization and output/cache namespaces',
    extra_full_prefix=False,frozen_slo_changed=False,resident_reference_changed=False,
    n_correct=None,ranking_eligible=False,resources=p.cgroup_snapshot(Path(identity['path']))))
print(json.dumps(dict(passed=True,requests=4000,service_classes=len(runner._service_profiles.profiles),model_identity_matched=True)))
