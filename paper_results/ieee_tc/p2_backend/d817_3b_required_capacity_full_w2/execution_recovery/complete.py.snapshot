"""Reuse the closed D813 analysis for D817 W2; defer the legacy delivery audit.

This is offline accounting only. D816 permits deferred file preparation, so the
old all-published assertion is not an appropriate delivery classification.
"""
import hashlib
import json
from pathlib import Path

_raw = Path(__file__).resolve().parent
_template = _raw.parent / 'd813_20261025/completion_program.py.snapshot'
_sha = hashlib.sha256(_template.read_bytes()).hexdigest()
assert _sha == '51a5b1f967b619ef86be93ca74a28dae928639f5e5024b9d3d7b4806165c5ed8'
_source = _template.read_text()
_replacements = [
    ('3b_max3_full_w1', '3b_max3_full_w2'),
    ('d813_3b_max3_full_w2', 'd817_3b_required_capacity_full_w2'),
    ('d813_20261025', 'd817_20261025'),
    ('D813_3B_MAX3_FULL_W1_20261025.md', 'D817_REQUIRED_CAPACITY_FULL_W2_20261025.md'),
    ('d813_single_w1_frozen_resource_reference_observation_v1',
     'd817_single_w2_frozen_resource_reference_observation_v1'),
    ('W1', 'W2'),
]
for _old, _new in _replacements:
    assert _old in _source, _old
    _source = _source.replace(_old, _new)
_legacy = """    ('context', base + ['--audit-closed-outcome', str(OUT / 'closed_outcome.json'),
                        '--metric-audit', str(metric)]),
"""
assert _source.count(_legacy) == 1
_source = _source.replace(_legacy, '')
_marker = "metric = OUT / 'full4000.json'"
assert _source.count(_marker) == 1
_source = _source.replace(_marker, """save(OUT / 'delivery_audit_status.json', dict(
    status='pending_attempt_level_delivery_audit',
    reason='D816 permits deferred preparation; do not apply the legacy all-published assertion.',
    no_delivery_correctness_or_zero_cost_inference=True))
""" + _marker)
with (_raw/'completion_template.json').open('x') as _stream:
    json.dump(dict(path=str(_template), sha256=_sha, replacements=_replacements,
        analysis_change='Same native metrics/stages and W2 reference; separate attempt-aware remote closure remains required.'),
        _stream, indent=2)
    _stream.write('\n')
with (_raw/'completion_program.py.snapshot').open('x') as _stream:
    _stream.write(_source)
exec(compile(_source, str(_raw/'completion_program.py.snapshot'), 'exec'), globals())
