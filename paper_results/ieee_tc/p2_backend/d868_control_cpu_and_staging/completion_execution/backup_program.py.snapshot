"""D826 adaptation of the D752 explicit-path, protected-result backup procedure."""
import ast
import hashlib
import json
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
RAW = Path(__file__).resolve().parent
OUT = ROOT / 'paper_results/ieee_tc/p2_backend/d868_control_cpu_and_staging'
sys.path.insert(0, str(ROOT))
from scripts import ieee_tc_preflight as p


def read(path):
    return json.loads(path.read_text())


def save(path, value):
    with path.open('x') as stream:
        json.dump(value, stream, indent=2, allow_nan=False)
        stream.write('\n')


def call(args):
    return subprocess.check_output(args, cwd=ROOT, text=True,
                                   stderr=subprocess.STDOUT, timeout=60).strip()


assert os.sched_getaffinity(0) == {2, 3, 26, 27}
own = p.scope_identity(p.cg_path().name)
save(RAW / 'backup_completion_identity.json', own)
assert not call(['nvidia-smi', '--query-compute-apps=pid', '--format=csv,noheader'])
resources = read(RAW/'resources.json')
assert not Path(resources['identity']['path']).exists()
assert all(v == 0 for v in resources['resources']['memory.events'].values())
assert resources['resources']['memory.swap.current'] == 0
diagnosis = read(OUT/'summary.json')
assert diagnosis['passed'] and diagnosis['new_gpu_replays'] == 0
assert not diagnosis['production_changes'] and not diagnosis['ranking_eligible']
assert not diagnosis['numerical_correctness_qualified']
for row in diagnosis['source_refs']:
    assert p.digest(Path(row['path'])) == row['sha256'], row['path']
counts = diagnosis['counts']
assert counts['total_requests'] == counts['host_allocation_receipts'] == 4000
assert not counts['missing_host_allocation_request_ids']
assert counts['before_positive_staged_storage'] == 416
assert counts['after_positive_staged_storage'] == 413
assert sum(counts['after_storage_observation_counts'].values()) == 4000
q = {'protected': {str(ROOT/'configs/generated/lora_manifest_1000.json'):
    '3b69bd0a6888aa56e98c3b9efb61234860d4b80f25729cfea6b79126d19127df'}}
evolving = {ROOT/'docs/ieee_tc/EXECUTION_STATUS.md',
    ROOT/'docs/ieee_tc/D868_CONTROL_CPU_AND_STAGING_20261026.md'}
seal = RAW.parent.parent / 'slora_qualification/d435_20261011/protected_before.json'
assert p.digest(seal) == '79df0c64c0d88236bc20b439d735f8dcab113f06582421151742aa63a5a2be54'
protected = {name: row['sha256'] for name, row in read(seal)['entries'].items()}
assert len(protected) == 147
protected.update(q['protected'])
for name, sha in protected.items():
    assert p.digest(Path(name)) == sha, name
manifest = read(OUT/'manifest.json')
for row in manifest['outputs']:
    assert p.digest(Path(row['path'])) == row['sha256'], row['path']
files = [path for path in sorted(OUT.iterdir()) if path.is_file()]
evidence = OUT / 'completion_execution'
evidence.mkdir(exist_ok=False)
small = ('analyze.py', 'identity.json', 'resources.json',
         'backup_results.py', 'backup_program.py.snapshot')
for name in small:
    source = RAW / name
    if name.endswith('.py'):
        ast.parse(source.read_text())
    target = evidence / (name + '.snapshot' if name.endswith('.py') else name + '.txt' if name.endswith('.log') else name)
    with target.open('xb') as stream:
        stream.write(source.read_bytes())
    assert p.digest(target) == p.digest(source)
    files.append(target)
remote_sha = None  # No remote service or GPU run in D868.
save(evidence / 'manifest.json', dict(
    files=[dict(path=str(path.relative_to(ROOT)), sha256=p.digest(path))
           for path in files if path.parent == evidence],
    remote_monitor_sha256=remote_sha, protected_files=len(protected),
    procedure_source=str(RAW.parent / 'd867_20261026/backup_program.py.snapshot')))
files += [evidence / 'manifest.json', *sorted(evolving)]
paths = [str(path.relative_to(ROOT)) for path in files]
assert len(paths) == len(set(paths))
assert 'configs/generated/lora_manifest_1000.json' not in paths
assert not call(['git', 'diff', '--cached', '--name-only'])
secret = re.compile(r'-----BEGIN (?:OPENSSH |RSA |EC )?PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]+|(?im:^[ \t]*(?:password|passwd|secret|api_key|PRIME_REMOTE_TOKEN)[ \t]*=[ \t]*[\x22\x27]?[A-Za-z0-9+/]{8,})')
for path in files:
    assert not secret.search(path.read_text()), str(path)
call(['git', 'diff', '--check', '--', *[str(x.relative_to(ROOT)) for x in evolving]])
call(['git', 'add', '--', *paths])
assert set(call(['git', 'diff', '--cached', '--name-only']).splitlines()) == set(paths)
ordinary = [x for x in paths if not x.endswith(('.csv', '.snapshot'))]
csvs = [x for x in paths if x.endswith('.csv')]
snapshots = [x for x in paths if x.endswith('.snapshot')]
call(['git', 'diff', '--cached', '--check', '--', *ordinary])
call(['git', '-c', 'core.whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol',
      'diff', '--cached', '--check', '--', *csvs])
call(['git', '-c', 'core.whitespace=blank-at-eol,space-before-tab,-blank-at-eof',
      'diff', '--cached', '--check', '--', *snapshots])
save(RAW / 'backup_precommit_check.json', dict(passed=True, files=paths,
     protected_files=len(protected), syntax_checked=True,
     qualification='D868 stream analysis passed: 4000 receipts, complete accounting partitions, validated D863 CPU rows and source/output SHA. No production changes or new GPU run.'))
call(['git', 'commit', '-m', 'tc: preserve D868 native control CPU and live staging evidence'])
head = call(['git', 'rev-parse', 'HEAD'])
ref = 'refs/heads/backup/d868-control-cpu-20261026'
call(['git', '-c', 'http.version=HTTP/1.1', 'push', 'faaslora_origin', 'HEAD:' + ref])
assert call(['git', '-c', 'http.version=HTTP/1.1', 'ls-remote', 'faaslora_origin', ref]).split()[0] == head
save(RAW / 'backup_completion.json', dict(passed=True, head=head, ref=ref,
     files=paths, v2_synchronized=False, protected_files=len(protected),
     remote_monitor_sha256=remote_sha))
print(json.dumps(dict(passed=True, head=head, ref=ref, files=len(paths)), indent=2))

