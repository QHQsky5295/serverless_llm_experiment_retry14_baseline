"""Reuse D817's complete W2 accounting for D826, without a new replay.

Only the execution identity and the explicit D825 qualification schema change.
The metric/stage analyzers, frozen SLO and resource reference remain unchanged.
"""
import hashlib
import json
from pathlib import Path

_raw = Path(__file__).resolve().parent
_template = _raw.parent / 'd817_20261025/completion_program.py.snapshot'
_sha = hashlib.sha256(_template.read_bytes()).hexdigest()
assert _sha == '5d44215f8d09bccb1488b79eb8ff7f68a12dff939067b05b48bfd0c6a717440d'
_source = _template.read_text()
_replacements = [
    ('d817_3b_required_capacity_full_w2', 'd826_3b_single_verification_full_w2'),
    ('d817_20261025', 'd826_20261025'),
    ('D817_REQUIRED_CAPACITY_FULL_W2_20261025.md',
     'D826_SINGLE_VERIFICATION_FULL_W2_20261025.md'),
    ('d817_single_w2_frozen_resource_reference_observation_v1',
     'd826_single_w2_frozen_resource_reference_observation_v1'),
]
for _old, _new in _replacements:
    assert _old in _source, _old
    _source = _source.replace(_old, _new)

# D826 records its reused D825 qualification explicitly, not under `protected`.
_old = """for path, sha in qualification['protected'].items():
    assert p.digest(Path(path)) == sha, path
"""
_new = """assert qualification['passed'] is True
protected = ROOT/'paper_results/ieee_tc/p2_backend/d825_single_destination_verification/closure.json'
assert p.digest(protected) == qualification['reused'][str(protected)]
for path, sha in read(protected)['user_protected'].items():
    assert p.digest(Path(path)) == sha, path
seal_path = RAW.parent.parent/'slora_qualification/d435_20261011/protected_before.json'
assert p.digest(seal_path) == '79df0c64c0d88236bc20b439d735f8dcab113f06582421151742aa63a5a2be54'
seal = p.verify_seal(seal_path)
assert seal['pass'] and seal['entry_count'] == 147
save(OUT/'protected_147_after.json', seal)
save(OUT/'owner_publication_audit_status.json', dict(
    status='pending_actual_full_transfer_evidence_audit',
    final_content_verification_required=True,
    stream_content_verification_not_required_for_owner_publication=True))
"""
assert _source.count(_old) == 1
_source = _source.replace(_old, _new)
compile(_source, str(_raw/'completion_program.py.snapshot'), 'exec')
with (_raw/'completion_template.json').open('x') as _stream:
    json.dump(dict(source=str(_template), sha256=_sha, replacements=_replacements,
        changes='Reuse native metrics/stages and W2 references; use recorded D825 user protection and immutable 147-file seal. Actual delivery/owner confirmation audit remains separate.'),
        _stream, indent=2)
    _stream.write('\n')
with (_raw/'completion_program.py.snapshot').open('x') as _stream:
    _stream.write(_source)
exec(compile(_source, str(_raw/'completion_program.py.snapshot'), 'exec'), globals())
