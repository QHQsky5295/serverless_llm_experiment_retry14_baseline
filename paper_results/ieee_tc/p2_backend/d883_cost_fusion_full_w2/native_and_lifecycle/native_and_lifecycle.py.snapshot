"""D883 offline receipt coverage plus retained D823 paired-stage accounting.

No replay, production change, new performance formula, or numerical proof.
"""
import collections
import json
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
RAW = Path(__file__).resolve().parent
OUT = ROOT/'paper_results/ieee_tc/p2_backend/d883_cost_fusion_full_w2'
sys.path.insert(0, str(ROOT))
import ijson
from scripts import ieee_tc_preflight as p
from scripts.ieee_tc.audit_d703_3b_full import compare_stage_audits

def read(path):
    return json.loads(path.read_text())

def ref(path):
    return dict(path=str(path), sha256=p.digest(path))

def save(path, value):
    with path.open('x') as stream:
        json.dump(value, stream, indent=2, allow_nan=False)
        stream.write('\n')

assert os.sched_getaffinity(0) == {2, 3, 26, 27}
assert os.environ['CUDA_VISIBLE_DEVICES'] == ''
identity = p.scope_identity(p.cg_path().name)
group = Path(identity['path'])
assert (group/'memory.high').read_text().strip() == str(3*p.GIB)
assert (group/'memory.max').read_text().strip() == str(4*p.GIB)
assert (group/'memory.swap.max').read_text().strip() == '0'
assert not subprocess.check_output(['nvidia-smi', '--query-compute-apps=pid',
    '--format=csv,noheader'], text=True).strip()
closure = read(OUT/'delivery_closure/resolved.json')
assert closure['passed'] and not Path(closure['identity']['path']).exists()
save(RAW/'native_lifecycle_identity.json', identity)
metric = read(OUT/'completion/full4000.json')
source = next(r for r in metric['source_refs']
    if Path(r['path']).name.startswith('experiment_results_full'))
path = Path(source['path'])
assert p.digest(path) == source['sha256']
library = RAW.parent/'d747_20261023/_ieee_native_host_descriptor.cpython-312-x86_64-linux-gnu.so'
expected = 'b76733db910a0041409ce375e7b5a281dabadd6d0e5796699bf8fe574e293044'
assert p.digest(library) == expected
counts = collections.Counter()
seen = set()
with path.open('rb') as stream:
    for row in ijson.items(stream, 'detailed_results.tc_ieee_full.requests.item', use_float=True):
        assert row['request_id'] not in seen and row['success'] is True
        seen.add(row['request_id'])
        receipt = row['gpu_reference_evidence']['receipt']
        actual = receipt['native_host_descriptor']
        assert actual == dict(kind='fresh_native_tensor_descriptor_v1', library=str(library),
            sha256=expected, torch_version='2.13.0+cu130', python_abi='cpython-312',
            tensor_state_cached=False)
        assert receipt['acquired'] is True
        counts[(receipt['owner_id'], receipt['worker_pid'], receipt['worker_rank'])] += 1
assert len(seen) == 4000
target = OUT/'native_and_lifecycle'
target.mkdir(exist_ok=False)
save(target/'actual_native_descriptor.json', dict(passed=True, all_requests=4000,
    owners=[dict(owner_id=k[0], worker_pid=k[1], worker_rank=k[2], requests=v)
        for k,v in sorted(counts.items())],
    native_host_descriptor=actual,
    source_refs=[source, ref(library), ref(ROOT/'faaslora/memory/native_host_descriptor.py'),
        ref(ROOT/'faaslora/memory/gpu_monitor.py'), ref(Path(__file__))],
    scope='All request acquisition receipts report the default per-tensor descriptor entry and exact qualified library. This is executed-worker configuration coverage, not a per-call invocation count or independent numerical adapter proof.',
    n_correct=None, ranking_eligible=False))
compare_stage_audits(
    ROOT/'paper_results/ieee_tc/p2_backend/d870_3b_staged_union_full_w2/completion/stages',
    OUT/'completion/stages', target/'paired_stages')
resources = p.cgroup_snapshot(group)
assert all(v == 0 for v in resources['memory.events'].values())
assert resources['memory.swap.current'] == 0
save(target/'resources.json', dict(identity=identity, resources=resources))
with (target/'native_and_lifecycle.py.snapshot').open('xb') as stream:
    stream.write(Path(__file__).read_bytes())
save(target/'manifest.json', dict(files=[ref(x) for x in sorted(target.rglob('*')) if x.is_file()]))
print(json.dumps(dict(passed=True, requests=len(seen), owners=len(counts), output=str(target)), indent=2))
