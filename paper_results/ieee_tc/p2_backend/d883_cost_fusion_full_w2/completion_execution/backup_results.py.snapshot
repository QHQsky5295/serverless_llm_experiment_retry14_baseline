"""D883: reuse D870's explicit-path, protected-result completion backup.

Only campaign identity, actual remote-monitor SHA and test description change.
No new measurement, broad staging, final-V2 overwrite or production change.
"""
import hashlib
from pathlib import Path

raw = Path(__file__).resolve().parent
template = raw.parent / 'd870_20261026/backup_program.py.snapshot'
assert hashlib.sha256(template.read_bytes()).hexdigest() == (
    '69dc17343e383a099672db522f523fc46c59ca51211e0596dfcf9ac5bebb74cb')
source = template.read_text()
changes = (
    ('d870_3b_staged_union_full_w2', 'd883_cost_fusion_full_w2'),
    ('D870_STAGED_UNION_FULL_W2_20261026.md',
     'D883_COST_FUSION_FULL_W2_20261026.md'),
    ('60708643ace365638c6b9f22d32beeb838504468db453ebda06730f933c97661',
     '61a83ec4af79aec8254d76e66b603806c945332233ebd443b129297c82be88b2'),
    ('Reuse D869 323 semantic checks and D870 4 run-contract checks.',
     'Reuse D882 322 semantic checks and D883 4 run-contract checks.'),
    ('tc: preserve D870 full W2 staged-union trade-off and lifecycle evidence',
     'tc: preserve D883 complete W2 cost-fusion observation and lifecycle evidence'),
    ('refs/heads/backup/d870-complete-20261026',
     'refs/heads/backup/d883-complete-20261026'),
)
for old, new in changes:
    assert source.count(old) == 1, old
    source = source.replace(old, new)
target = raw / 'backup_program.py.snapshot'
compile(source, str(target), 'exec')
with target.open('x') as stream:
    stream.write(source)
exec(compile(source, str(target), 'exec'), globals())
