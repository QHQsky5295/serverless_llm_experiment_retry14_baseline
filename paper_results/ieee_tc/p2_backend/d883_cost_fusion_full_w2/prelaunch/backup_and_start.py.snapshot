"""D880 explicit backup/start sequence, D883 paths and reused qualification."""
import json, os, re, subprocess, sys
from pathlib import Path
ROOT=Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
RAW=Path(__file__).resolve().parent
OUT=ROOT/'paper_results/ieee_tc/p2_backend/d883_cost_fusion_full_w2'
sys.path.insert(0,str(ROOT))
from scripts import ieee_tc_preflight as p
def read(path):return json.loads(path.read_text())
def save(path,value):
    with path.open('x') as f:json.dump(value,f,indent=2,allow_nan=False);f.write('\n')
def git(*args):return subprocess.check_output(['git',*args],cwd=ROOT,text=True,stderr=subprocess.STDOUT,timeout=55).strip()
assert os.sched_getaffinity(0)=={2,3,26,27}
identity=p.scope_identity(p.cg_path().name);save(RAW/'backup_identity.json',identity)
assert git('branch','--show-current')=='retry14_continuous_queue_v2'
assert git('rev-parse','HEAD')=='43934903a32987523bdd6a1864ee43fbc7a18668'
assert not git('diff','--cached','--name-only')
q=read(OUT/'prelaunch/qualification.json');assert q['passed']
for name,sha in q['refs'].items():assert p.digest(Path(name))==sha,name
assert not p.owned_pids(Path(q['identity']['path']))
for row in read(OUT/'prelaunch/manifest.json')['files']:
    assert p.digest(Path(row['path']))==row['sha256'],row['path']
assert p.digest(ROOT/'configs/generated/lora_manifest_1000.json')=='3b69bd0a6888aa56e98c3b9efb61234860d4b80f25729cfea6b79126d19127df'
paths=['scripts/ieee_tc/run_d293_7b_prefetch_validation_100.sh',
    'tests/test_ieee_tc_d456_diagnostic_contract.py',
    'configs/ieee_tc/20261026_d883_3b_max3_full_w2.yaml',
    'docs/ieee_tc/D883_COST_FUSION_FULL_W2_20261026.md','docs/ieee_tc/EXECUTION_STATUS.md']
paths += [str(path.relative_to(ROOT)) for path in sorted(OUT.rglob('*')) if path.is_file()]
secret=re.compile(r'-----BEGIN (?:OPENSSH |RSA |EC )?PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]+|(?im:^[ \t]*(?:password|passwd|secret|api_key|PRIME_REMOTE_TOKEN)[ \t]*=[ \t]*[\x22\x27]?[A-Za-z0-9+/]{8,})')
for name in paths:assert not secret.search((ROOT/name).read_text()),name
assert 'configs/generated/lora_manifest_1000.json' not in paths
git('diff','--check','--',*paths);git('add','--',*paths)
assert set(git('diff','--cached','--name-only').splitlines())==set(paths)
git('diff','--cached','--check')
git('commit','-m','tc: register matched full 3B W2 for replacement-cost fusion (D883)')
head=git('rev-parse','HEAD');ref='refs/heads/backup/d883-cost-fusion-full-w2-20261026'
save(RAW/'commit.json',dict(commit=head,ref=ref,paths=paths))
git('-c','http.version=HTTP/1.1','push','faaslora_origin','HEAD:'+ref)
assert git('-c','http.version=HTTP/1.1','ls-remote','faaslora_origin',ref).split()==[head,ref]
save(RAW/'backup.json',dict(passed=True,commit=head,ref=ref,final_v2_synced=False))
subprocess.run(['/usr/bin/python3','-B',str(RAW/'start.py')],cwd=ROOT,check=True,timeout=55)
