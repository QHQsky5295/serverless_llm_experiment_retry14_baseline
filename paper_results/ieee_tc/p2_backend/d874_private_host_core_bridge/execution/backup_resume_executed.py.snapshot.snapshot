"""Back up only the verified D874 implementation and evidence; preserve the existing V2 divergence."""
import json
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
RAW = Path(__file__).resolve().parent
OUT = ROOT/'paper_results/ieee_tc/p2_backend/d874_private_host_core_bridge'
sys.path.insert(0, str(ROOT))
from scripts import ieee_tc_preflight as p

assert os.sched_getaffinity(0) == {2,3,26,27}
scope = p.scope_identity(p.cg_path().name)
with (RAW/'backup_resume_identity.json').open('x') as handle:
    json.dump(scope, handle, indent=2)
def git(*args):
    return subprocess.check_output(['git', *args], cwd=ROOT, text=True)
def save(name, value):
    with (RAW/name).open('x') as handle:
        json.dump(value, handle, indent=2)
assert git('rev-parse','HEAD').strip() == 'ac931b559657507fb9428f280b87f15dcb373ea0'
closure = json.loads((OUT/'closure.json').read_text())
assert closure['passed']
for path, sha in closure['user_protected'].items():
    assert p.digest(Path(path)) == sha
for row in json.loads((OUT/'final_manifest.json').read_text())['files']:
    assert p.digest(Path(row['path'])) == row['sha256']
assert p.digest(Path(closure['doc']['path'])) == closure['doc']['sha256']
files = [ROOT/'docs/ieee_tc/D874_PRIVATE_HOST_CORE_BRIDGE_20261026.md',
         ROOT/'docs/ieee_tc/EXECUTION_STATUS.md',
         ROOT/'tests/test_ieee_tc_core_interleave.py',
         ROOT/'faaslora/scheduling/core_interleave.py',
         ROOT/'faaslora/scheduling/vllm_ieee_scheduler.py',
         ROOT/'scripts/run_all_experiments.py',
         ROOT/'faaslora/memory/gpu_monitor.py',
         ROOT/'faaslora/memory/residency_manager.py',
         *[path for path in sorted(OUT.rglob('*')) if path.is_file()]]
paths = [str(path.relative_to(ROOT)) for path in files]
assert len(paths) == len(set(paths))
assert all('lora_manifest_1000.json' not in path for path in paths)
assert all(not path.startswith(('figs/paper/', 'paper_results/final_v2/')) for path in paths)
branch = 'refs/heads/backup/d874-private-host-core-20261026'
assert not git('ls-remote','faaslora_origin', branch).strip()
git('diff','--check')
git('add','--',*paths)
assert set(git('diff','--cached','--name-only').splitlines()) == set(paths)
raw_logs = [path for path in paths if path.endswith('/tests.txt')]
ordinary = [path for path in paths if not path.endswith(('.csv','.snapshot')) and path not in raw_logs]
csvs = [path for path in paths if path.endswith('.csv')]
snapshots = [path for path in paths if path.endswith('.snapshot')]
git('diff','--cached','--check','--',*ordinary)
raw_check = subprocess.run(['git', '-c', 'core.whitespace=-blank-at-eol,-blank-at-eof,space-before-tab',
    'diff', '--cached', '--check', '--', *raw_logs], cwd=ROOT, text=True, capture_output=True)
assert raw_check.returncode == 2 and not raw_check.stderr
assert raw_check.stdout.strip() == 'paper_results/ieee_tc/p2_backend/d874_private_host_core_bridge/tests.txt:297: leftover conflict marker'
assert (OUT/'tests.txt').read_text().splitlines()[296] == '======= 1 failed, 231 passed, 19 warnings, 102 subtests passed in 12.40s ======='
# Exact captured pytest summary only. All source/docs still receive strict diff checks.

if csvs:
    git('-c','core.whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol','diff','--cached','--check','--',*csvs)
git('-c','core.whitespace=blank-at-eol,space-before-tab,-blank-at-eof','diff','--cached','--check','--',*snapshots)
added = '\n'.join(line[1:] for line in git('diff','--cached','--unified=0').splitlines()
                  if line.startswith('+') and not line.startswith('+++'))
patterns = [r'-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----',
            r'\b(?:ghp_|github_pat_)[A-Za-z0-9_]{20,}', r'\bAKIA[0-9A-Z]{16}\b',
            r'(?i)(?:password|passwd|api_key|access_token)\s*[=:]\s*[\"\x27][^\"\x27\n]{8,}[\"\x27]']
assert not any(re.search(pattern, added) for pattern in patterns), 'possible staged secret: inspect locally, do not print content'
save('precommit.json',dict(paths=paths,files=[dict(path=str(path),sha256=p.digest(path)) for path in files],
    checks=['closed analysis and strict count/source checks', 'script compile', 'diff check',
            'explicit staging', 'protected user SHAs', 'added-text secret patterns'],
    scope=scope, backup_ref=branch, final_v2_synced=False))
git('commit','-m','tc: connect private HOST construction to native core completion and shutdown')
commit = git('rev-parse','HEAD').strip()
save('commit.json',dict(commit=commit,backup_ref=branch,files=paths,final_v2_synced=False))
subprocess.run(['git','push','faaslora_origin','HEAD:'+branch],cwd=ROOT,check=True,timeout=120)
remote = git('ls-remote','faaslora_origin',branch).strip().split()
assert remote == [commit, branch]
assert not git('diff','--cached','--name-only').strip()
save('backup.json',dict(passed=True,commit=commit,remote='faaslora_origin',ref=branch,
    remote_verified=True,final_v2_synced=False,explicit_files=len(paths),scope=scope))
print(json.dumps(dict(passed=True,commit=commit,ref=branch,files=len(paths),final_v2_synced=False)))
