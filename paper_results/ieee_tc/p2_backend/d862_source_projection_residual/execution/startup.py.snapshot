"""Reuse D847's existing startup/control and physical interval audit."""
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys

ROOT = Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
RAW = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))
from scripts import ieee_tc_preflight as preflight

identity = preflight.scope_identity(preflight.cg_path().name)
group = Path(identity['path'])
assert (group/'memory.high').read_text().strip() == str(3*preflight.GIB)
assert (group/'memory.max').read_text().strip() == str(4*preflight.GIB)
assert (group/'memory.swap.max').read_text().strip() == '0'
assert os.sched_getaffinity(0) == {2,3,26,27}
assert os.environ['CUDA_VISIBLE_DEVICES'] == ''
assert not subprocess.check_output(['nvidia-smi','--query-compute-apps=pid','--format=csv,noheader'], text=True).strip()
template = RAW.parent/'d847_20261025/startup_executed.py.snapshot'
assert hashlib.sha256(template.read_bytes()).hexdigest() == 'e3c82c62823ede4af9a2447b57f7ce3da2aee825feba1f7ca96dedf1be2ec773'
source = template.read_text()
retention_block = """    retention_path = raw/'compression_receipt.json'
    retention = read(retention_path)
    assert retention['source'] == str(outcome_path)
    assert retention['source_sha256'] == retention['audit_sha256']
    outcome_path = Path(retention['archive'])
    assert digest(outcome_path) == retention['archive_sha256']
"""
assert source.count(retention_block) == 1
source = source.replace(retention_block, '')
changes = {
    'd847_3b_scaling_feedback/startup': 'd862_source_projection_residual/startup',
    'd847_closed_run_startup_feedback_v1': 'd862_closed_run_startup_feedback_v1',
    'd840_3b_single_thread_decoder_full_w2': 'd858_3b_single_lease_full_w2',
    'd846_3b_staging_identity_full_w2': 'd861_3b_source_projection_full_w2',
    '20261025_d840_3b_max3_full_w2.yaml': '20261026_d858_3b_max3_full_w2.yaml',
    '20261025_d846_3b_max3_full_w2.yaml': '20261026_d861_3b_max3_full_w2.yaml',
    "'D840'": "'D858'", "'D846'": "'D861'",
    "gzip.open(outcome_path, 'rb')": "outcome_path.open('rb')",
    "ref(Path(report['source_run'])/'compression_receipt.json'), ": '',
}
for old in changes:
    assert old in source, old
source = re.sub('|'.join(re.escape(k) for k in sorted(changes,key=len,reverse=True)),
                lambda match: changes[match.group(0)], source)
compile(source, str(RAW/'startup_executed.py.snapshot'), 'exec')
with (RAW/'startup_executed.py.snapshot').open('x') as stream:
    stream.write(source)
with (RAW/'startup_template.json').open('x') as stream:
    json.dump(dict(template=str(template), sha256=preflight.digest(template), changes=changes,
                   source_form='Existing uncompressed originals; no restore or rescan of weights.'), stream, indent=2)
    stream.write('\n')
exec(compile(source,str(RAW/'startup_executed.py.snapshot'),'exec'),globals())
with (RAW/'startup_resources.json').open('x') as stream:
    json.dump(dict(scope=identity,resources=preflight.cgroup_snapshot(group)),stream,indent=2)
    stream.write('\n')
