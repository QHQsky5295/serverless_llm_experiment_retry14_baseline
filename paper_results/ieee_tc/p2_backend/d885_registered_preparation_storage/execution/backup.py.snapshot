"""Reuse tested explicit-path backup; do not treat backup as final V2 sync."""
from pathlib import Path

raw = Path(__file__).resolve().parent
source = (raw.parent/'d871_20261026/backup_executed.py.snapshot').read_text()
changes = (
    ('D871 evidence', 'D885 candidate'),
    ('d871_current_remote_preparation', 'd885_registered_preparation_storage'),
    ('bcc3585698e1d7021b310217ff771cc87da00eea', '5b016894afd343a5bc4696cde8b59e4cf5b17630'),
    ('D871_CURRENT_PREPARATION_BOUNDARY_20261026.md', 'D885_REGISTERED_PREPARATION_STORAGE_20261026.md'),
    ('backup/d871-current-preparation-20261026', 'backup/d885-registered-preparation-storage-20261026'),
    ('tc: preserve D871 current remote preparation and native execution boundary',
     'tc: share qualified registered preparation HOST graph within one native transaction'),
    ("ROOT/'docs/ieee_tc/EXECUTION_STATUS.md',",
     "ROOT/'docs/ieee_tc/EXECUTION_STATUS.md',\n"
     "         ROOT/'faaslora/memory/gpu_monitor.py',\n"
     "         ROOT/'faaslora/memory/residency_manager.py',\n"
     "         ROOT/'tests/test_ieee_tc_worker_observation.py',\n"
     "         ROOT/'tests/test_ieee_tc_hit_host_transaction.py',"),
)
for old, new in changes:
    assert old in source, old
    source = source.replace(old, new)
# D884 exposed this inherited empty-list bug. Retain snapshots verbatim and
# apply CSV whitespace rules only to real CSV paths.
old = "git('-c','core.whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol','diff','--cached','--check','--',*csvs)"
assert old in source
source = source.replace(old, 'if csvs:\n    ' + old)
compile(source, str(raw/'backup_executed.py.snapshot'), 'exec')
with (raw/'backup_executed.py.snapshot').open('x') as stream:
    stream.write(source)
exec(compile(source, str(raw/'backup_executed.py.snapshot'), 'exec'), globals())
