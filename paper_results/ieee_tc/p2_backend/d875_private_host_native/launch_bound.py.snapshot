"""Use the current Full toolchain/descriptor, not D724's obsolete first attempt."""
import json
import os
from pathlib import Path
import sys

ROOT = Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
RAW = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))
from scripts import ieee_tc_preflight as p
from scripts.ieee_tc_native_toolchain import bind_native_toolchain

failed = json.loads((RAW/'native_argfix_launch.json').read_text())
assert failed['native_gpu_context_release_confirmed'] and failed['service_path_removed']
old = json.loads((RAW/'native_private_host.json').read_text())
assert old['pass'] is False and old['stage'] == 'engine_initialization'
env, receipt = bind_native_toolchain(os.environ,
    python='/home/qhq/.venvs/primelora_vllm0300_tc_20260925/bin/python',
    contract=str(ROOT/'configs/ieee_tc/native_toolchain_cuda130_v1.json'),
    expected_sha='328b202599d90b9e037ebad53bc7696a9997be2f0f412aaaeda2c1a0cc9c5b1c')
os.environ.update(env)
os.environ.update(FAASLORA_WORKER_START_TIMEOUT_S='600', FAASLORA_KEEP_DEDICATED_WORKER_LOGS='1',
    HF_HUB_OFFLINE='1', TRANSFORMERS_OFFLINE='1', PYTHONNOUSERSITE='1')
descriptor = RAW.parent/'d747_20261023/_ieee_native_host_descriptor.cpython-312-x86_64-linux-gnu.so'
assert p.digest(descriptor) == 'b76733db910a0041409ce375e7b5a281dabadd6d0e5796699bf8fe574e293044'
os.environ['FAASLORA_IEEE_HOST_DESCRIPTOR_LIBRARY'] = str(descriptor)
os.environ['FAASLORA_IEEE_HOST_DESCRIPTOR_SHA256'] = p.digest(descriptor)
with (RAW/'toolchain.json').open('x') as stream:
    json.dump(receipt, stream, indent=2)
source = (RAW/'launch.py').read_text().replace("'--trace'", "'--replay-trace'")
source = source.replace("RAW/'launch_identity.json'", "RAW/'launch_bound_identity.json'")
source = source.replace("RAW/'native_launch.json'", "RAW/'native_bound_launch.json'")
source = source.replace("RAW/'native_private_host.json'", "RAW/'native_private_host_bound.json'")
snapshot = RAW/'launch_bound_executed.py.snapshot'
with snapshot.open('x') as stream:
    stream.write(source)
exec(compile(source, str(snapshot), 'exec'))
