"""Initialized planning uses fresh complete graphs, not descriptive reports.

Metadata/real-owner and actual transport tests, not native model performance.
"""
import asyncio
import copy
import json
import os
from pathlib import Path
import tempfile
import time
from types import SimpleNamespace as NS
import unittest
from unittest.mock import AsyncMock, Mock, patch

from scripts.run_all_experiments import InferenceEngine, SubprocessInferenceEngineProxy
from scripts import dedicated_engine_worker as worker
from tests import test_ieee_tc_transfer_pressure as fixtures
from faaslora.preloading.planning_cpu import execution_preparation_bundle


def projection(native):
    value = copy.deepcopy(native)
    value.pop('native_staging_footprints', None)
    value.pop('native_host_allocator', None)
    value['native_footprints'].pop('host_tensor_views', None)
    return value


def without_provenance(value):
    if isinstance(value, dict):
        return {key: without_provenance(item) for key, item in value.items()
                if key not in ('plan_sha256', 'planning_sha256', 'source_snapshot_id',
                               'native_staging_footprints', 'native_host_allocator', 'host_tensor_views',
                               'file_plan_id', 'captured_at')}
    if isinstance(value, (tuple, list)):
        return type(value)(without_provenance(item) for item in value)
    return value


class PlanningSnapshot(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        # This class checks exact input/output and publication, not placement.
        # The planning_cpu suite separately exercises real spawn and cancellation.
        fixtures.setUpModule()

    @classmethod
    def tearDownClass(cls):
        fixtures.tearDownModule()

    def test_real_planner_and_route_collector_share_one_measurement(self):
        from faaslora.experiment.instance_pool import InstanceSlot
        factory, (fixture, runner, queue, template, native) = self.make()
        slot = InstanceSlot(template.instance_id, engine=template.engine, coordinator=None,
            preparation_cost_model=template.preparation_cost_model)
        native['device_uuid'] = 'GPU-planning-fixture'
        runner.instance_pool = NS(get_slots=lambda: [slot])
        runner._ieee_route_confirmed_snapshot_cache = True
        runner._ieee_source_observation_stats = {}
        runner._ieee_source_observation_waves = {}
        slot.engine.ieee_request_sources = AsyncMock(side_effect=AssertionError('duplicate native read'))
        plan = factory.plan(runner, slot)
        async def route():
            for aid in native['registered_cpu_adapter_ids']:
                values, meta = await runner._ieee_collect_confirmed_snapshot_cache(
                    (slot,), requested_adapter_ids=[aid])
                self.assertEqual(values[0][0].captured_monotonic_s, native['captured_monotonic_s'])
                self.assertEqual(meta['full_authoritative_read_replica_count'], 0)
        asyncio.run(route())
        slot.engine.ieee_request_sources.assert_not_awaited()
        slot.engine.ieee_gpu_reference.assert_awaited_once_with(operation='routing_source_snapshot')
        self.assertEqual(plan['source_view']['native'], projection(native))
        self.assertEqual([c.artifact_id for c in plan['selected']['gpu']], ['a', 'd'])
        self.assertFalse(plan['physical_resources_reserved'])

    def test_initialized_planner_publishes_the_same_received_measurement(self):
        from faaslora.clock import local_monotonic_clock_id
        from faaslora.experiment.instance_pool import NativeSourceSnapshot
        factory, (fixture, runner, queue, slot, native) = self.make()
        expected = NativeSourceSnapshot.from_native(projection(native),
            expected_clock_id=local_monotonic_clock_id(), received_monotonic_s=time.monotonic())
        with patch.object(runner, '_ieee_publish_planning_sources',
                          side_effect=AssertionError('controller revalidated the full graph')), \
             patch.object(runner, '_ieee_publish_validated_planning_sources', return_value=True) as publish:
            plan = factory.plan(runner, slot)
        publish.assert_called_once_with(slot, expected, device_uuid=native.get('device_uuid'),
                                        expected_engine=slot.engine)
        slot.engine.ieee_gpu_reference.assert_awaited_once_with(operation='routing_source_snapshot')
        self.assertEqual(plan['source_view']['native'], projection(native))

    def test_failed_or_cancelled_planning_never_publishes(self):
        for error in (ValueError('invalid-plan'), asyncio.CancelledError()):
            with self.subTest(error=type(error).__name__):
                factory, (fixture, runner, queue, slot, native) = self.make()
                with patch.object(runner._stack, 'plan_ieee_owned_preparation_async',
                                  new=AsyncMock(side_effect=error)), \
                     patch.object(runner, '_ieee_publish_validated_planning_sources') as publish:
                    with self.assertRaises(type(error)):
                        factory.plan(runner, slot)
                publish.assert_not_called()
                self.assertFalse(fixture.owner.leases)
                self.assertFalse(fixture.owner.materializations)

    def test_state_updated_during_planning_is_not_overwritten(self):
        from dataclasses import replace
        from faaslora.experiment.instance_pool import InstanceSlot
        for advance_epoch in (False, True):
            with self.subTest(advance_epoch=advance_epoch):
                factory, (fixture, runner, queue, template, native) = self.make()
                native['device_uuid'] = 'GPU-planning-fixture'
                slot = InstanceSlot(template.instance_id, engine=template.engine, coordinator=None,
                    preparation_cost_model=template.preparation_cost_model)
                runner.instance_pool = NS(get_slots=lambda: [slot])
                runner._ieee_route_confirmed_snapshot_cache = True
                original = runner._stack.plan_ieee_owned_preparation_async
                observed = []
                async def planning(**kw):
                    plan = await original(**kw)
                    state, _ = plan.native_source_publication()
                    fresh = replace(state.identity_view(), epoch=state.epoch+int(advance_epoch),
                                    captured_monotonic_s=time.monotonic())
                    self.assertTrue(runner._ieee_publish_identity_frontier(slot, fresh))
                    observed.append(fresh)
                    return plan
                with patch.object(runner._stack, 'plan_ieee_owned_preparation_async', side_effect=planning):
                    plan = factory.plan(runner, slot)
                self.assertEqual(runner._ieee_route_identity_frontier[slot.instance_id], observed[0])
                self.assertFalse(runner._ieee_route_full_cache)
                self.assertIsNone(slot.native_source_state)
                self.assertEqual(plan.native_source_publication()[0].captured_monotonic_s,
                                 native['captured_monotonic_s'])

    def make(self):
        factory = fixtures.OwnedPreparationPlanning()
        self.addCleanup(factory.doCleanups)
        data = factory.make()
        fixture, runner, queue, slot, native = data
        self.addCleanup(lambda: asyncio.run(queue.close()))
        native['native_footprints']['host_tensor_views'] = [{'fixture_description': True}]
        native['native_staging_footprints'] = {'fixture_description': True}
        native['native_host_allocator'] = {'fixture_description': True}
        original = slot.engine.ieee_gpu_reference.side_effect
        async def observe(**kw):
            value = await original(**kw)
            return projection(value) if kw['operation'] == 'routing_source_snapshot' else value
        slot.engine.ieee_gpu_reference.side_effect = observe
        slot.engine.ieee_gpu_reference.reset_mock()
        return factory, data

    def test_initialized_planner_uses_complete_native_graph_not_compact_wire(self):
        factory, (fixture, runner, queue, slot, native) = self.make()
        slot.engine.ieee_routing_sources = AsyncMock(side_effect=AssertionError('compact wire'))
        slot.engine.ieee_request_sources = AsyncMock(side_effect=AssertionError('target-scoped capacity'))
        plan = factory.plan(runner, slot)
        slot.engine.ieee_gpu_reference.assert_awaited_once_with(operation='routing_source_snapshot')
        actual = plan['source_view']['native']
        self.assertEqual(actual, projection(native))
        self.assertEqual(actual['native_footprints']['host_tensor_storage_bytes'], 1024)
        self.assertEqual(len(actual['native_footprints']['host_allocations']), 2)
        self.assertEqual(actual['replacement_protected_adapter_ids'], [])
        self.assertEqual([c.artifact_id for c in plan['selected']['gpu']], ['a', 'd'])
        self.assertEqual(plan['remaining_bytes'], dict(gpu=1048576, host=0, nvme=90112))
        self.assertFalse(plan['physical_resources_reserved'])

    def test_full_and_projected_runner_plans_objectives_match_in_both_modes(self):
        factory, (fixture, runner, queue, slot, native) = self.make()
        endpoint = slot.engine.ieee_gpu_reference.side_effect
        for mode in ('handoff', 'residency'):
            with self.subTest(mode=mode):
                outputs = []
                for full in (True, False):
                    async def observe(**kw):
                        self.assertEqual(kw, {'operation': 'routing_source_snapshot'})
                        return copy.deepcopy(native) if full else projection(native)
                    slot.engine.ieee_gpu_reference.side_effect = observe
                    async def run():
                        plan = await runner._plan_ieee_preparation_for_slot(slot=slot, mode=mode)
                        return await execution_preparation_bundle(runner._stack, plan,
                            size_edges_bytes=runner._preparation_profiles.size_edges_bytes)
                    outputs.append(asyncio.run(run()))
                self.assertEqual(without_provenance(outputs[0]), without_provenance(outputs[1]))
                self.assertNotEqual(outputs[0][0]['source_snapshot_id'], outputs[1][0]['source_snapshot_id'])
        slot.engine.ieee_gpu_reference.side_effect = endpoint

    def test_every_epoch_reads_fresh_protection_and_never_reuses_selection(self):
        factory, (fixture, runner, queue, slot, native) = self.make()
        first = factory.plan(runner, slot)
        victim = native['slot_adapter_ids'][0]
        native['epoch'] += 1
        native['replacement_protected_adapter_ids'] = [victim]
        second = factory.plan(runner, slot)
        self.assertEqual(slot.engine.ieee_gpu_reference.await_count, 2)
        self.assertEqual(first['source_view']['native']['replacement_protected_adapter_ids'], [])
        self.assertEqual(second['source_view']['native']['replacement_protected_adapter_ids'], [victim])
        self.assertGreater(second['source_view']['native']['epoch'], first['source_view']['native']['epoch'])
        self.assertNotEqual(first['selected']['gpu'], second['selected']['gpu'])

    def test_global_union_alias_credit_and_protection_corruption_are_rejected(self):
        factory, (fixture, runner, queue, slot, native) = self.make()
        original = copy.deepcopy(native)
        mutations = {
            'union': lambda x: x['native_footprints'].__setitem__('host_tensor_storage_bytes', 0),
            'alias': lambda x: x['native_footprints']['host_allocations'][0].__setitem__('adapter_ids', []),
            'credit': lambda x: x['native_footprints']['host_adapter_footprints'][0].__setitem__('exclusive_storage_bytes', 0),
            'gpu': lambda x: x['native_footprints'].__setitem__('pool_allocated_bytes', 1),
            'missing_protection': lambda x: x.pop('replacement_protected_adapter_ids'),
        }
        for name, corrupt in mutations.items():
            with self.subTest(name=name):
                native.clear(); native.update(copy.deepcopy(original))
                corrupt(native)
                with self.assertRaises(ValueError):
                    factory.plan(runner, slot)
        self.assertFalse(fixture.owner.leases)
        self.assertFalse(fixture.owner.materializations)

    def test_cancel_observation_never_submits_plan_or_reserves_movement(self):
        factory, (fixture, runner, queue, slot, native) = self.make()
        async def run():
            entered = asyncio.Event()
            async def wait(**kw):
                self.assertEqual(kw, {'operation': 'routing_source_snapshot'})
                entered.set()
                await asyncio.Future()
            slot.engine.ieee_gpu_reference.side_effect = wait
            with patch('faaslora.preloading.planning_cpu.execute_planning_message') as planner:
                task = asyncio.create_task(runner._plan_ieee_preparation_for_slot(slot=slot, mode='residency'))
                await entered.wait()
                task.cancel()
                with self.assertRaises(asyncio.CancelledError): await task
                planner.assert_not_called()
            self.assertFalse(fixture.owner.leases)
            self.assertFalse(fixture.owner.materializations)
        asyncio.run(run())


class CapacityConsumer(unittest.IsolatedAsyncioTestCase):
    async def test_deferred_capacity_still_requires_full_allocator_observation(self):
        fixture = fixtures.DeferredNativeHostCapacity()
        runner, queue, engine, state, calls = await fixture.make()
        try:
            await runner._refresh_ieee_deferred_host_capacity()
            engine.ieee_gpu_reference.assert_awaited_once_with(operation='source_snapshot')
            state['accounted_tensor_bytes'] = 800
            await runner._refresh_ieee_deferred_host_capacity()
            await asyncio.sleep(0)
            self.assertEqual(len(calls), 4)
        finally:
            await queue.close()


class ControlRoundFileObservation(unittest.TestCase):
    """Real file owner and selector; controlled independent native reports."""

    @classmethod
    def setUpClass(cls):
        # Reuse the serialized selector fixture, not a process per small test.
        # Existing planning_cpu tests own actual spawn/cancel qualification.
        fixtures.setUpModule()

    @classmethod
    def tearDownClass(cls):
        fixtures.tearDownModule()

    def make(self, count=4):
        factory = fixtures.OwnedPreparationPlanning()
        self.addCleanup(factory.doCleanups)
        files, runner, queue, first, native = factory.make(native_owner_count=count)
        first.engine.ieee_gpu_reference.reset_mock()
        self.addCleanup(lambda: asyncio.run(queue.close()))
        slots = [first]
        reports = [native]
        for index in range(1, count):
            report = copy.deepcopy(native)
            report['owner_id'] = 'controlled-native-' + str(index)
            report['epoch'] += index
            engine = NS(model_cfg=dict(first.engine.model_cfg))

            async def observe(*, operation, _report=report, **kw):
                if operation == 'routing_source_snapshot':
                    return copy.deepcopy(_report)
                if operation == 'snapshot':
                    return dict(owner_id=_report['owner_id'], worker_pid=os.getpid(),
                                clock_id=_report['clock_id'])
                if operation == 'configure_host_budget':
                    return dict(configured=True, owner_id=_report['owner_id'],
                        worker_pid=os.getpid(), tensor_budget_bytes=kw['tensor_budget_bytes'],
                        clock_id=_report['clock_id'])
                raise AssertionError(operation)

            engine.ieee_gpu_reference = AsyncMock(side_effect=observe)
            # As in activation, HOST binding precedes ready pool publication.
            asyncio.run(runner._attach_ieee_host_budget(engine))
            self.addCleanup(os.close, runner._ieee_host_budget_members[id(engine)]['pidfd'])
            engine.ieee_gpu_reference.reset_mock()
            slots.append(NS(engine=engine, instance_id='replica-' + str(index),
                preparation_cost_model=first.preparation_cost_model))
            reports.append(report)
        runner.instance_pool = NS(get_slots=lambda: slots)
        runner.coord_cfg = dict(getattr(runner, 'coord_cfg', {}),
                               ieee_residency_file_observation='control_round_v1')
        runner._hierarchical_residency_enabled = True
        runner._coordination_enabled = True
        return files, runner, slots, reports

    def test_one_fresh_file_read_four_independent_native_plans(self):
        files, runner, slots, reports = self.make()
        plans = {}

        async def plan_only(**kw):
            self.assertEqual(kw.pop('capacity_only'), False)
            plan = await runner._plan_ieee_preparation_for_slot(**kw)
            plans[kw['slot'].instance_id] = plan.snapshot()
            return dict(plan=plan)

        async def run():
            with patch.object(files.owner, 'preparation_snapshot',
                              wraps=files.owner.preparation_snapshot) as read, \
                 patch.object(runner, '_run_ieee_owned_preparation_plan', side_effect=plan_only):
                runner._schedule_ieee_residency_epochs()
                first_tasks = dict(runner._ieee_residency_tasks)
                runner._schedule_ieee_residency_epochs()
                self.assertEqual(runner._ieee_residency_tasks, first_tasks)
                self.assertEqual(read.call_count, 1)
                await asyncio.gather(*first_tasks.values())
                runner._reap_ieee_residency_tasks()
                self.assertEqual(read.call_count, 1)
                views = [plans[s.instance_id]['source_view'] for s in slots]
                self.assertTrue(all(v['files'] == views[0]['files'] for v in views))
                self.assertEqual({v['native']['owner_id'] for v in views},
                                 {r['owner_id'] for r in reports})
                self.assertEqual(len({p['plan_sha256'] for p in plans.values()}), 4)
                self.assertTrue(all(not p['physical_resources_reserved'] for p in plans.values()))
                self.assertFalse(files.owner.leases)
                self.assertFalse(files.owner.materializations)
                for slot in slots:
                    slot.engine.ieee_gpu_reference.assert_awaited_once_with(operation='routing_source_snapshot')
                # With unchanged state, the ordinary per-replica entry chooses
                # the same candidates/objectives (observation times may differ).
                direct = await runner._plan_ieee_preparation_for_slot(slot=slots[0], mode='residency')
                self.assertEqual(without_provenance(direct.snapshot()),
                                 without_provenance(plans[slots[0].instance_id]))
                self.assertEqual(read.call_count, 2)
                # A new control round must re-read; no epoch/TTL reuse.
                old_capture = views[0]['files']['captured_at']
                runner._schedule_ieee_residency_epochs()
                await asyncio.gather(*runner._ieee_residency_tasks.values())
                runner._reap_ieee_residency_tasks()
                self.assertEqual(read.call_count, 3)
                self.assertGreater(plans[slots[0].instance_id]['source_view']['files']['captured_at'], old_capture)
                records = runner._ieee_residency_epochs
                self.assertEqual(len({r['shared_file_observation']['round_id'] for r in records}), 2)
                self.assertTrue(all(r['shared_file_observation']['replicas'] == 4 for r in records))
        asyncio.run(run())

    def test_cancel_one_native_observation_does_not_cancel_or_wait_for_sibling(self):
        files, runner, slots, _ = self.make(count=2)

        async def run():
            entered = asyncio.Event()
            async def slow(**kw):
                self.assertEqual(kw, dict(operation='routing_source_snapshot'))
                entered.set()
                await asyncio.Future()
            slots[0].engine.ieee_gpu_reference.side_effect = slow
            async def plan_only(**kw):
                kw.pop('capacity_only')
                return dict(plan=await runner._plan_ieee_preparation_for_slot(**kw))
            with patch.object(runner, '_run_ieee_owned_preparation_plan', side_effect=plan_only):
                runner._schedule_ieee_residency_epochs()
                await entered.wait()
                pending = runner._ieee_residency_tasks[id(slots[0].engine)]
                sibling = runner._ieee_residency_tasks[id(slots[1].engine)]
                await asyncio.wait_for(asyncio.shield(sibling), 10)
                self.assertFalse(pending.done())
                pending.cancel()
                with self.assertRaises(asyncio.CancelledError):
                    await pending
                self.assertEqual([r['state'] for r in runner._ieee_residency_epochs],
                                 ['cancelled', 'completed'])
                self.assertFalse(files.owner.leases)
        asyncio.run(run())

    def test_disabled_path_still_reads_each_replica_and_empty_round_reads_nothing(self):
        files, runner, slots, _ = self.make(count=2)
        runner.coord_cfg.pop('ieee_residency_file_observation')
        async def plan_only(**kw):
            kw.pop('capacity_only')
            return dict(plan=await runner._plan_ieee_preparation_for_slot(**kw))
        async def run():
            with patch.object(files.owner, 'preparation_snapshot', wraps=files.owner.preparation_snapshot) as read, \
                 patch.object(runner, '_run_ieee_owned_preparation_plan', side_effect=plan_only):
                runner._schedule_ieee_residency_epochs()
                await asyncio.gather(*runner._ieee_residency_tasks.values())
                runner._reap_ieee_residency_tasks()
                self.assertEqual(read.call_count, 2)
                self.assertTrue(all('shared_file_observation' not in r for r in runner._ieee_residency_epochs))
                slots.clear()
                runner._schedule_ieee_residency_epochs()
                self.assertEqual(read.call_count, 2)
        asyncio.run(run())

    def test_shared_observation_cannot_be_used_for_handoff(self):
        _, runner, slots, _ = self.make(count=1)
        async def run():
            with self.assertRaisesRegex(ValueError, 'only for steady-state'):
                await runner._plan_ieee_preparation_for_slot(slot=slots[0], mode='handoff',
                    file_snapshot=runner._ieee_preparation_file_snapshot())
            slots[0].engine.ieee_gpu_reference.assert_not_awaited()
        asyncio.run(run())

    def test_received_shared_view_is_detached_and_still_uses_normal_executor(self):
        files, runner, slots, _ = self.make(count=1)
        snapshot = runner._ieee_preparation_file_snapshot()
        original = copy.deepcopy(snapshot)
        async def execute(**kw):
            self.assertEqual(kw['plan']['source_view']['files'], original)
            self.assertIs(kw['target_engine'], slots[0].engine)
            self.assertFalse(kw['capacity_only'])
            # A later mutation of a caller's dict cannot alter frozen bytes.
            snapshot['epoch'] += 1000
            snapshot['artifacts'].clear()
            self.assertEqual(kw['plan']['source_view']['files'], original)
            return []
        async def run():
            with patch.object(files.owner, 'preparation_snapshot', side_effect=AssertionError('second read')), \
                 patch.object(runner, '_run_ieee_file_preparation_plan', side_effect=execute) as executor:
                result = await runner._run_ieee_owned_preparation_plan(slot=slots[0], mode='residency',
                                                                       file_snapshot=snapshot)
                self.assertEqual(result['results'], [])
                executor.assert_awaited_once()
        asyncio.run(run())

    def test_shared_round_executes_remote_host_gpu_and_closes_real_ownership(self):
        factory = fixtures.MixedOwnedPreparation()
        self.addCleanup(factory.doCleanups)
        files, runner, queue, slot, owner, _, loads = factory.make(remote_gpu=True)
        runner.instance_pool = NS(get_slots=lambda: [slot])
        runner.coord_cfg = dict(getattr(runner, 'coord_cfg', {}),
                               ieee_residency_file_observation='control_round_v1')
        runner._hierarchical_residency_enabled = True
        runner._coordination_enabled = True
        async def run():
            try:
                self.assertFalse((files.nvme/'a').exists())
                runner._schedule_ieee_residency_epochs()
                await asyncio.gather(*runner._ieee_residency_tasks.values())
                runner._reap_ieee_residency_tasks()
                self.assertEqual((files.nvme/'a'/'weights').read_bytes(), b'a'*12288)
                self.assertEqual(loads, [('host', 'a'), ('gpu', 'a')])
                self.assertEqual(runner._ieee_residency_epochs[0]['state'], 'completed')
                factory.check_clean(files, runner, owner)
            finally:
                await queue.close()
        asyncio.run(run())


class PlanningTransport(unittest.IsolatedAsyncioTestCase):
    async def roundtrip(self, cancelled=False):
        ready = asyncio.get_running_loop().create_future()
        entered, proceed, completed = asyncio.Event(), asyncio.Event(), asyncio.Event()
        calls = []
        observed = dict(kind='native_lora_sources_v1', owner_id='fixture-owner', epoch=7,
            native_footprints={'host_allocations': [{'allocation_id': 0}],
                               'pool_tensor_views': [{'dtype': 'torch.float16'}]},
            replacement_protected_adapter_ids=[123])
        class FakeEngine:
            # Real public forwarder; only native collective computation is stubbed.
            ieee_gpu_reference = InferenceEngine.ieee_gpu_reference
            def __init__(self, cfg, *args):
                self.model_cfg = dict(cfg, ieee_gpu_references=True)
                self.backend, self._engine_dead = 'vllm', False
                self.engine = NS(collective_rpc=self.collective)
            async def collective(self, method, *, kwargs):
                calls.append((method, kwargs))
                entered.set()
                if cancelled: await proceed.wait()
                completed.set()
                return [copy.deepcopy(observed)]
            async def initialize(self): pass
            async def shutdown(self): pass
        with tempfile.TemporaryDirectory() as root:
            payload = Path(root)/'payload.json'
            payload.write_text(json.dumps(dict(repo_root=str(Path.cwd()), model_cfg={}, cost_model={})))
            with patch('scripts.run_all_experiments.InferenceEngine', FakeEngine), \
                 patch.object(worker, '_write_ready', side_effect=lambda path, value: ready.set_result(value)):
                serving = asyncio.create_task(worker._run_worker(payload, Path(root)/'ready.json'))
                address = await asyncio.wait_for(ready, 2.)
                proxy = SubprocessInferenceEngineProxy(process=NS(poll=Mock(return_value=None)),
                    host=address['host'], port=address['port'], model_cfg={'timing_contract':'ieee_tc_native_v1'},
                    cost_model={}, device_id=0, workdir=Path(root), log_path=Path(root)/'none')
                task = asyncio.create_task(proxy.ieee_gpu_reference(operation='routing_source_snapshot'))
                try:
                    if cancelled:
                        await asyncio.wait_for(entered.wait(), 2.)
                        task.cancel()
                        with self.assertRaises(asyncio.CancelledError): await task
                        self.assertFalse(proxy._native_rpc_uncertain)  # Read-only, not a resource lease.
                        proceed.set()
                        await asyncio.wait_for(completed.wait(), 2.)
                        result = await proxy.ieee_gpu_reference(operation='routing_source_snapshot')
                    else:
                        result = await asyncio.wait_for(task, 2.)
                    self.assertEqual({k: result[k] for k in observed}, observed)
                    self.assertTrue(all(call == ('ieee_gpu_reference', {'operation':'routing_source_snapshot'}) for call in calls))
                    self.assertEqual(len(calls), 2 if cancelled else 1)
                finally:
                    proceed.set()
                    task.cancel()
                    await asyncio.gather(task, return_exceptions=True)
                    for channel in list(proxy._rpc_channels): await proxy._drop_rpc_channel(channel)
                    await proxy._rpc('shutdown')
                    await asyncio.wait_for(serving, 2.)

    async def test_actual_worker_proxy_and_engine_keep_complete_graph(self):
        await self.roundtrip()

    async def test_cancelled_read_has_no_resource_claim_and_fresh_read_still_works(self):
        await self.roundtrip(cancelled=True)


if __name__ == '__main__':
    unittest.main()
