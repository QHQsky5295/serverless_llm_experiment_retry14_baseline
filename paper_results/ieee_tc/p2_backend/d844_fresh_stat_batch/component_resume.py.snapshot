        resource_limitation='Failure exited before end-of-scope resource summary; peak/events not invented.',
        scope_inactive=True, scope_path_removed=True), stream, indent=2)
with (RAW/'component_resume_program.py.snapshot').open('x') as stream:
    stream.write(source)
exec(compile(source, str(RAW/'component_resume_program.py.snapshot'), 'exec'),
