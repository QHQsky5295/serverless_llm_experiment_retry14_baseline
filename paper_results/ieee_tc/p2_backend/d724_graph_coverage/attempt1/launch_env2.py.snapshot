"""Attempt 2: restore the qualified build environment after a pre-request PATH error."""
import json
import os
from pathlib import Path
import subprocess
import sys

ROOT=Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
RAW=Path(__file__).resolve().parent
sys.path.insert(0,str(ROOT))
from scripts import ieee_tc_preflight as p

def save(name,value):
    with (RAW/name).open('x') as f:
        json.dump(value,f,indent=2,allow_nan=False);f.write('\n')

own=p.scope_identity(p.cg_path().name)
save('start2_identity.json',own)
assert os.sched_getaffinity(0)=={2,3,26,27}
q=json.loads((RAW/'qualification.json').read_text())
assert q['passed']
assert not p.owned_pids(Path(q['identity']['path']))
closed=p.stop_scope_identity(q['identity'],grace_seconds=0)
assert closed['released'] and not closed['targets']
save('qualification_closure2.json',dict(passed=True,identity=q['identity'],closure=closed))
for path,sha in q['refs'].items():assert p.digest(Path(path))==sha,path
backup=json.loads((RAW/'backup2.json').read_text())
assert backup['passed']
assert subprocess.check_output(['git','rev-parse','HEAD'],cwd=ROOT,text=True).strip()==backup['head']
assert not subprocess.check_output(['nvidia-smi','--query-compute-apps=pid','--format=csv,noheader'],text=True).strip()
os.environ['FAASLORA_TC_NVML_BINDING']='/home/qhq/anaconda3/envs/LLM_vllm0102/lib/python3.12/site-packages/pynvml.py'
os.environ['FAASLORA_TC_NVML_SHA256']='4251429c25f1615a4166f395d3c09fe0732bfb023864c4b7f12813373e5696ea'
receipt=Path('/home/qhq/serverless_llm_experiment/results/ieee_tc/p2_backend_qualification/runtime_20260926/cuda_import_attempt3.json')
assert p.digest(receipt)=='cf38bbf8d3b80b30d88ac38e27722d389a24ae516565708cfc924937589079cf'
trace=Path('/home/qhq/serverless_llm_baselines/results/paper_experiments/03_main_comparison/20260509_134259_llama32_3b_main_s8/shared_artifacts/llama32_3b_r4000_a500_seed42_z1p0_hot48_rot500_s8_mainv1_trace.json')
assert p.digest(trace)=='4ea5d026da3820301e753ad6b03ea776e25a5c3f01921933bd124598eb26018d'
os.environ['PATH']='/home/qhq/.venvs/primelora_vllm0300_tc_20260925/bin:'+os.environ['PATH']
os.environ['CUDA_HOME']='/usr/local/cuda-13.0'
os.environ['FLASHINFER_NVCC']='/usr/local/cuda-13.0/bin/nvcc'
os.environ['MAX_JOBS']='2'
os.environ['VLLM_CACHE_ROOT']='/home/qhq/.cache/vllm'
assert subprocess.check_output(['ninja','--version'],text=True).strip()
failed=json.loads((RAW/'native_launch.json').read_text())
assert failed['pass'] is False and failed['service_path_removed'] and failed['native_gpu_context_release_confirmed']
for name in ('start_identity.json','backup_identity.json'):
    prior=json.loads((RAW/name).read_text())
    assert not p.owned_pids(Path(prior['path']))
    assert p.stop_scope_identity(prior,grace_seconds=0)['released']
command=['/usr/bin/env','CUDA_VISIBLE_DEVICES=0','VLLM_NO_USAGE_STATS=1','PYTHONUNBUFFERED=1',
 'PYTORCH_ALLOC_CONF=pinned_max_cached_size_mb:0,pinned_use_background_threads:True',
 '/home/qhq/.venvs/primelora_vllm0300_tc_20260925/bin/python','-B',str(ROOT/'scripts/ieee_tc_preflight.py'),
 'backend-model-check','--runtime-receipt',str(receipt),
 '--config',str(ROOT/'configs/ieee_tc/20261022_d724_3b_graph_native.yaml'),
 '--model-profile','llama32_3b_main_modelscope','--replay-trace',str(trace),
 '--request-count','16','--qualification-mode','native_execution_metadata',
 '--output',str(RAW/'native_execution2.json')]
result=p.gated_launch(command,RAW/'native_launch2.json',predicted_growth=2*p.GIB)
save('native_launch2.json',result)
print(json.dumps(dict(passed=result['pass'],service=result.get('service_unit'))))
raise SystemExit(0 if result['pass'] else 2)
