"""Reuse D817 full-launch/checkpoint procedure for the D820 qualified channel."""
import ast
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys

ROOT = Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
RAW = Path(__file__).resolve().parent
OUT = ROOT / 'paper_results/ieee_tc/p2_backend/d822_3b_shared_pressure_full_w2/prelaunch'
sys.path.insert(0, str(ROOT))
from scripts import ieee_tc_preflight as p

def read(path): return json.loads(path.read_text())
def save(path, value):
    with path.open('x') as handle:
        json.dump(value, handle, indent=2, allow_nan=False, sort_keys=True)
        handle.write('\n')
def call(args):
    return subprocess.check_output(args, cwd=ROOT, text=True, stderr=subprocess.STDOUT, timeout=55).strip()

assert os.sched_getaffinity(0) == {2, 3, 26, 27}
own = p.scope_identity(p.cg_path().name)
save(RAW / 'start_identity.json', own)
group = Path(own['path'])
assert (group / 'memory.high').read_text().strip() == str(3*p.GIB)
assert (group / 'memory.max').read_text().strip() == str(4*p.GIB)
assert (group / 'memory.swap.max').read_text().strip() == '0'
assert not call(['nvidia-smi','--query-compute-apps=pid','--format=csv,noheader'])
assert not call(['git','diff','--cached','--name-only'])
assert call(['git','branch','--show-current']) == 'retry14_continuous_queue_v2'
assert call(['git','rev-parse','HEAD']) == '32ba734e0f25c78f445180427d0b7b64fbdab737'
assert not (RAW / '3b_max3_full_w2').exists() and not Path('/dev/shm/tc-d822-3b-w2').exists()
OUT.mkdir(parents=True, exist_ok=False)
native_dir = ROOT / 'paper_results/ieee_tc/p2_backend/d821_shared_pressure_native/completion'
native = read(native_dir / 'summary.json')
assert native['passed'] and native['requests'] == 48 and native['service_and_auxiliary_removed']
assert native['remote_stopped'] and not native['profile_exported']
assert p.digest(Path(native['source']['path'])) == native['source']['sha256']
closed = read(RAW.parent / 'd821_20261025/completion_identity.json')
assert 'ActiveState=inactive' in call(['systemctl','--user','show',closed['unit'],'-p','ActiveState'])
assert not Path(closed['path']).exists()
reused = {str(native_dir / 'summary.json'):p.digest(native_dir / 'summary.json')}
qualified = ROOT / 'paper_results/ieee_tc/p2_backend/d820_shared_pressure_integration/coordinator_contract/qualification.json'
q = read(qualified)
assert q['passed']
refs = dict(q['sources'])
for path, sha in (q['sources'] | q['user_protected']).items():
    assert p.digest(Path(path)) == sha, path
reused[str(qualified)] = p.digest(qualified)
old = read(ROOT / 'paper_results/ieee_tc/p2_backend/d817_3b_required_capacity_full_w2/prelaunch/qualification.json')
for path, sha in old['refs'].items():
    if (path.endswith(('.json','.so','.md')) and 'D817_' not in path and 'EXECUTION_STATUS' not in path
            and '/d817_20261025/' not in path):
        assert p.digest(Path(path)) == sha, path
        refs[path] = sha
seal = p.verify_seal(RAW.parent.parent / 'slora_qualification/d435_20261011/protected_before.json')
assert seal['pass'] and seal['entry_count'] == 147
save(OUT / 'protected_147.json', seal)
tests = call(['/home/qhq/anaconda3/envs/LLM_vllm0102/bin/python','-B','-m','unittest',
    'tests.test_ieee_tc_d456_diagnostic_contract.D822FullContract',
    'tests.test_ieee_tc_d456_diagnostic_contract.D817FullContract',
    'tests.test_ieee_tc_d456_diagnostic_contract.D814FullContract.test_only_frozen_adapter_view_changes_in_qualified_launch','-v'])
assert 'Ran 5 tests' in tests and tests.endswith('OK')
save(OUT / 'execution_contract_tests.json', dict(passed=True, output=tests, new_tests=2, affected_existing_tests=3))
secret = re.compile(r'-----BEGIN (?:OPENSSH |RSA |EC )?PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]+|(?im:^[ \t]*(?:password|passwd|secret|api_key|PRIME_REMOTE_TOKEN)[ \t]*=[ \t]*[\x22\x27]?[A-Za-z0-9+/]{8,})')
for path in sorted(RAW.iterdir()):
    if path.suffix not in ('.py','.sh'): continue
    if path.suffix == '.py': ast.parse(path.read_text())
    else: call(['bash','-n',str(path)])
    assert not secret.search(path.read_text()), path
    with (OUT / (path.name + '.snapshot')).open('xb') as handle: handle.write(path.read_bytes())
    refs[str(path)] = p.digest(path)
files = ['configs/ieee_tc/20261025_d822_3b_max3_full_w2.yaml',
    'scripts/ieee_tc/run_d293_7b_prefetch_validation_100.sh',
    'tests/test_ieee_tc_d456_diagnostic_contract.py',
    'docs/ieee_tc/D821_SHARED_PRESSURE_NATIVE_20261025.md',
    'docs/ieee_tc/D822_SHARED_PRESSURE_FULL_W2_20261025.md','docs/ieee_tc/EXECUTION_STATUS.md']
call(['bash','-n',str(ROOT / files[1])])
for name in files: refs[str(ROOT / name)] = p.digest(ROOT / name)
save(OUT / 'qualification.json', dict(passed=True, identity=own, refs=refs, reused=reused,
    full_source_count=4000, diagnostic_prefix_count=None,
    changes='three exclusive paths and coordination pressure transport only',
    source_tests_reused=55, new_execution_contract_tests=2, affected_existing_tests=3,
    native_source_requests_reused=48, additional_gpu_microtests=0,
    numerical_correctness_qualified=False, native_load_nonzero_pressure_pending=True,
    resources=p.cgroup_snapshot(group)))
save(OUT / 'manifest.json', dict(files=[dict(path=str(path.relative_to(ROOT)),sha256=p.digest(path)) for path in sorted(OUT.iterdir()) if path.is_file()]))
files += [str(path.relative_to(ROOT)) for path in sorted(OUT.iterdir()) if path.is_file()]
files += [str(path.relative_to(ROOT)) for path in sorted(native_dir.iterdir()) if path.is_file()]
assert 'configs/generated/lora_manifest_1000.json' not in files
for name in files: assert not secret.search((ROOT / name).read_text()), name
call(['git','diff','--check','--',*files])
call(['git','add','--',*files])
assert set(call(['git','diff','--cached','--name-only']).splitlines()) == set(files)
call(['git','diff','--cached','--check'])
call(['git','commit','-m','tc: close D821 native check and register shared-pressure full W2 D822'])
head = call(['git','rev-parse','HEAD'])
ref = 'refs/heads/backup/d822-shared-pressure-fullw2-20261025'
save(RAW / 'commit.json', dict(head=head,ref=ref,files=files))
call(['git','-c','http.version=HTTP/1.1','push','faaslora_origin','HEAD:'+ref])
assert call(['git','-c','http.version=HTTP/1.1','ls-remote','faaslora_origin',ref]).split()[0] == head
save(RAW / 'backup.json', dict(passed=True,head=head,ref=ref,v2_synchronized=False))
gate = p.preflight([ROOT,RAW],32*p.GIB)
save(RAW / 'launch_gate.json', gate)
assert gate['preflight_pass'], gate['issues']
session = 'tc-d822-3b-shared-pressure-full-w2'
assert subprocess.run(['tmux','has-session','-t',session],stderr=subprocess.DEVNULL).returncode != 0
call(['bash',str(RAW / 'start_remote.sh')])
call(['/usr/bin/python3','-B',str(RAW / 'check_remote_health_stdlib.py')])
call(['tmux','new-session','-d','-s',session,'-c',str(ROOT),shlex.join(['bash',str(RAW / 'run_and_release.sh')])])
save(RAW / 'start_receipt.json', dict(launched=True,head=head,backup_ref=ref,tmux=session,
    identity=own,qualification_sha256=p.digest(OUT / 'qualification.json')))
print(json.dumps(dict(launched=True,head=head,ref=ref,tmux=session)))
