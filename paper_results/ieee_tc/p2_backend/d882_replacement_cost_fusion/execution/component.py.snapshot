"""Resume only the component check; retain journal counts and first failure."""
from pathlib import Path

raw = Path(__file__).resolve().parent
source = (raw/'analyze.py').read_text()
start = source.index("source = RAW.parent/'d870_")
end = source.index('# Use the PRE-EDIT', start)
source = source[:start] + source[end:]
source = source.replace("RAW/'analysis_identity.json'", "RAW/'component_identity.json'")
source = source.replace("OUT/'analysis_resources.json'", "OUT/'component_resources.json'")
source = source.replace("assert captured and all(row['file_fallbacks'] is not None for row in captured)",
    "save(OUT/'captured_cases.json', dict(cases=captured))\nassert captured and any(row['file_fallbacks'] is not None for row in captured)")
source = source.replace("namespace['native_host_replacement_costs'](**row))",
    "namespace['native_host_replacement_costs'](**row) if row['file_fallbacks'] is not None else None)")
source = source.replace('passed=True, counts=counts, component_cases=results',
    'passed=True, component_cases=results')
with (raw/'component_executed.py.snapshot').open('x') as handle:
    handle.write(source)
exec(compile(source, str(raw/'component_executed.py.snapshot'), 'exec'), globals())
