"""D863: apply D722's existing iteration partition to this native observation.

No new observer, GPU replay, model change, or counterfactual latency subtraction.
Incomplete observations remain explicit rather than requiring another replay.
"""
import hashlib
from pathlib import Path

raw=Path(__file__).resolve().parent
template=raw.parent/'d722_20261022/audit_iterations.py'
assert hashlib.sha256(template.read_bytes()).hexdigest()=='8ed329b749fd6d7fa1e9d328cb5f38c086f08bd55fe255125642dda29448b4f9'
source=template.read_text()
start=source.index('    bindings = {')
end=source.index('    passed = False',start)
source=source[:start]+'''    qualification=json.loads((ROOT/'paper_results/ieee_tc/p2_backend/d863_3b_native_prefix1000/prelaunch_attempt2/qualification.json').read_text())
    bindings={Path(k):v for k,v in qualification['refs'].items()
              if k != str(ROOT/'docs/ieee_tc/EXECUTION_STATUS.md')}
    protected={Path(k):v for k,v in qualification['protected'].items()}
    bindings[ROOT/'scripts/analyze_control_path_overhead.py']='b3126b6c9c1e83aa2a499ae95bb4f4341f76a296d53d56453b567f01964f153e'
    for path,sha in (bindings|protected).items(): assert p.digest(path)==sha,path
''' + source[end:]
start=source.index("        with (RAW/'tests.log').open('x')")
end=source.index("        summary = json.loads(",start)
source=source[:start]+'''        # The D722 strict analyzer is byte-identical; reuse its tests.
        assert json.loads((RAW/'analysis_execution.json').read_text())['passed']
''' + source[end:]
changes=(
    ("OUT = RAW/'analysis1'", "OUT = RAW/'iterations1'"),
    ("BASE = ROOT/'paper_results/ieee_tc/p2_backend/d684_3b_control_prefix1/completion'", "BASE = RAW/'analysis1'"),
    ("save(RAW/'identity.json', identity)", "save(RAW/'iteration_identity.json', identity)"),
    ("assert summary['processes'] == summary['complete_processes'] == 4", "assert summary['processes'] == 3"),
    ("assert summary['diagnostic_count'] == summary['complete_request_observations'] == 1000", "assert summary['diagnostic_count'] == 1000"),
    ("BASE/'completion.json'", "BASE/'audit.json'"),
    ("        assert all(w['observation_complete'] == 'True' for w in windows)\n", ""),
    ("assert len(streams) == 4", "assert len(streams) == summary['processes']"),
    ("assert header['host_inventory_timing'] == 'fresh_inventory_v1'", "assert header.get('host_inventory_timing') is None"),
    ('summarize_core_host_spans(events, include_iterations=True, host_inventory=True)', 'summarize_core_host_spans(events, include_iterations=True, host_inventory=False)'),
    ("            assert audit['complete'] and not audit['truncated'] and audit['closed']\n", ""),
    ("steps=iteration['step_count'],observer_ns=audit['observer_ns'],write_ns=audit['write_ns'],", "steps=iteration['step_count'],observer_ns=audit['observer_ns'],write_ns=audit['write_ns'],\n                complete=audit['complete'],truncated=audit['truncated'],closed=audit['closed'],"),
    ("                assert audit['first_ns'] <= a <= b <= audit['last_ns']\n", ""),
    ("('client','input_nonclient','step','host_inventory','host_allocator_stats')", "('client','input_nonclient','step')"),
    ("timing_tpot_miss=w['timing_tpot_miss'] == 'True',first_ns=a,last_ns=b,", "timing_tpot_miss=w['timing_tpot_miss'] == 'True',first_ns=a,last_ns=b,\n                    observation_complete=w['observation_complete'] == 'True',"),
    ("        assert sum(r['spans'] for r in processes) == 312160\n", ""),
    ("        assert sum(r['timing_tpot_miss'] for r in requests) == 62\n", ""),
    ("groups.append(dict(group=label,timing_tpot_miss=miss,count=len(rows),", "groups.append(dict(group=label,timing_tpot_miss=miss,count=len(rows),\n                    complete_observations=sum(r['observation_complete'] for r in rows),"),
    ("BASE/'analysis_manifest.json'", "BASE/'common_slo.json'"),
    ("kind='d722_reused_d684_iteration_composition_v1'", "kind='d863_native_iteration_composition_v1'"),
    ("source_contract='D684 intrusive 1000-request prefix, not D719 Full'", "source_contract='D863 diagnostic W2 original first1000; D857 production with observation, not uninstrumented D858 Full'"),
    ("processes=4,spans=312160,steps=len(steps),requests=1000,clock_id=summary['clock_id'],", "processes=len(processes),spans=sum(r['spans'] for r in processes),steps=len(steps),requests=len(requests),clock_id=summary['clock_id'],\n            complete_request_observations=sum(r['observation_complete'] for r in requests),"),
    ("                'HOST inventory is nested in control, not additive to the request partition.',\n", ""),
    ("'D684 predates D703/D719 changes; this is historical mechanism evidence, not current configuration qualification.'", "'D863 is intrusive mechanism evidence; unavailable/truncated intervals remain unknown and cannot be assigned to output delivery.'"),
    ("save(RAW/'execution.json'", "save(RAW/'iteration_execution.json'"),
    ('protected_files=144', 'protected_files=147'),
)
for old,new in changes:
    assert old in source,old
    source=source.replace(old,new)
exec(compile(source,str(template),'exec'),globals())
