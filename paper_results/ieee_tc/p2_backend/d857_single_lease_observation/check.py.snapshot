"""Bounded existing CPU tests for one-observation file read acquisition."""
import json
import os
from pathlib import Path
import subprocess
import sys
import time
import unittest

ROOT = Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
RAW = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))
from scripts import ieee_tc_preflight as p

stage = sys.argv[1]
assert stage in ('before', 'after')
scope = p.scope_identity(p.cg_path().name)
group = Path(scope['path'])
assert os.sched_getaffinity(0) == {2,3,26,27}
assert (group/'memory.high').read_text().strip() == str(3*p.GIB)
assert (group/'memory.max').read_text().strip() == str(4*p.GIB)
assert (group/'memory.swap.max').read_text().strip() == '0'
assert os.environ['CUDA_VISIBLE_DEVICES'] == ''
assert not subprocess.check_output(['nvidia-smi','--query-compute-apps=pid','--format=csv,noheader'],text=True).strip()
assert p.check_plan() == 'd7acd08127d4f4513b23af6dd57a9647cf047570f2b563e361e716ccb0b32b83'
assert os.statvfs(ROOT).f_bavail*os.statvfs(ROOT).f_frsize >= 150*p.GIB
seal = RAW.parent.parent/'slora_qualification/d435_20261011/protected_before.json'
assert p.verify_seal(seal)['pass']
user = ROOT/'configs/generated/lora_manifest_1000.json'
assert p.digest(user) == '3b69bd0a6888aa56e98c3b9efb61234860d4b80f25729cfea6b79126d19127df'
source = ROOT/'faaslora/memory/residency_manager.py'
with (RAW/(stage+'_source.py.snapshot')).open('xb') as stream:
    stream.write(source.read_bytes())
base = 'tests.test_ieee_tc_file_observation.FreshFileObservation.'
names = [base+'test_read_lease_identity_and_footprint_use_one_fresh_inventory',
         base+'test_read_lease_second_pass_mutation_withdraws_before_install']
if stage == 'after':
    names = ['tests.test_ieee_tc_file_observation',
             'tests.test_ieee_tc_request_lifecycle.LocalSourceOwnership',
             'tests.test_ieee_tc_request_lifecycle.ConfirmedFilePublication']
    names += ['tests.test_ieee_tc_transfer_pressure.NativeHostPreparation.'+name for name in
        ('test_native_host_first_load_observes_and_pins_file_atomically',
         'test_native_host_reuse_observes_and_pins_file_atomically')]
started = time.monotonic()
with (RAW/(stage+'.log')).open('x') as log:
    suite = unittest.defaultTestLoader.loadTestsFromNames(names)
    result = unittest.TextTestRunner(stream=log, verbosity=2).run(suite)
import torch
assert not torch.cuda.is_initialized()
assert p.verify_seal(seal)['pass']
with (RAW/(stage+'.json')).open('x') as stream:
    json.dump(dict(passed=result.wasSuccessful(), tests=result.testsRun,
        errors=len(result.errors), failures=len(result.failures),
        elapsed_seconds=time.monotonic()-started, names=names, scope=scope,
        source_sha256=p.digest(source), test_sha256=p.digest(ROOT/'tests/test_ieee_tc_file_observation.py'),
        resources={k:(group/k).read_text().strip() for k in
                   ('memory.peak','memory.events','memory.swap.current')},
        protected_147_unchanged=True,native_cuda_initialized=False),stream,indent=2)
print(json.dumps(dict(stage=stage,tests=result.testsRun,errors=len(result.errors),
                     failures=len(result.failures),passed=result.wasSuccessful())))
if stage == 'after':
    assert result.wasSuccessful()
