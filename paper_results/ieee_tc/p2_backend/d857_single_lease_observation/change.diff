+
+    def _read_lease_observation(self, path):
+        """Observe identity and footprint together under the acquiring owner's lock.
+
+        The inventory checks every path twice with fresh stat calls. Its private
+        captured metadata is usable only after the second check succeeds. No
+        owner mutation or async gap separates this observation from lease install;
+        a later acquisition must observe again, including an idempotent one.
+        """
+        source = Path(path).resolve(strict=True)
+        matches = [tier for tier, root in self.roots.items() if source.parent == root]
+        if len(matches) != 1 or not source.is_dir():
+            raise ValueError('source must be an existing adapter directory in one managed tier')
+        observed = {}
+        try:
+            footprint = _local_file_inventory({matches[0]: source},
+                allocation_bounds=self._file_allocations, _observed_stats=observed)
+            observation = (self._source_observation_from_stats(source, footprint, observed.items())
+                           if source in self._confirmed_sources else None)
+            record = self._validated_source(source, _observation=observation)
+        except (OSError, ValueError, RuntimeError):
+            # Inventory failure precedes validation; withdraw exactly once.
+            if source in self._confirmed_sources:
+                del self._confirmed_sources[source]
+                self.source_epoch += 1
+            raise
+        return source, matches[0], observed[str(source)], footprint, record
+
+    def _install_source_lease(self, source, tier, info, footprint, record, *, adapter_id, lease_id):
+        """Install from the same locked observation, without another tree scan."""
+        if not adapter_id or not lease_id or lease_id in self.released:
+            raise ValueError('source reference requires an unused lease and adapter identity')
+        identity = (adapter_id, str(source), tier, info.st_dev, info.st_ino)
+        previous = self.leases.get(lease_id)
+        if previous is not None and previous != identity:
+            raise ValueError('source lease cannot be rebound to another copy')
+        if record is not None and record['public']['adapter_id'] != adapter_id:
+            raise ValueError('source reference changed the verified adapter identity')
+        self.leases[lease_id] = identity
+        if previous is None and record is not None:
+            self._touch_file_source(record)
+        return dict(owner_id=self.owner_id, lease_id=lease_id, adapter_id=adapter_id,
+                    path=str(source), tier=tier, device=info.st_dev, inode=info.st_ino,
+                    state='held', content_verified=record is not None, capacity_reserved=False,
+                    confirmed_source=(copy.deepcopy(record['public']) if record else None),
+                    file_footprint={key: value for key, value in footprint.items()
+                                    if key not in ('allocations', 'tiers')})
diff --git a/tests/test_ieee_tc_file_observation.py b/tests/test_ieee_tc_file_observation.py
index e4439ee0..6f1c89d6 100644
--- a/tests/test_ieee_tc_file_observation.py
+++ b/tests/test_ieee_tc_file_observation.py
@@ -56,0 +57,75 @@ class FreshFileObservation(unittest.TestCase):
+    def test_read_lease_identity_and_footprint_use_one_fresh_inventory(self):
+        from collections import Counter
+        from faaslora.memory import residency_manager as module
+        fixture, owner, manifests, limits = self.make()
+        source = fixture.nvme / 'a'
+        expected_footprint = module._local_file_inventory({'nvme': source},
+            allocation_bounds=owner._file_allocations)
+        expected_footprint = {k: v for k, v in expected_footprint.items()
+                              if k not in ('allocations', 'tiers')}
+        file = next(p for p in source.rglob('*') if p.is_file())
+        original = os.stat
+        for confirmed in (True, False):
+            state = owner.source_snapshot('a')
+            publication = next(row for row in state['sources'] if row['tier'] == 'nvme')
+            counts = Counter()
+            def counted(path, *args, **kwargs):
+                if kwargs.get('follow_symlinks') is False and str(path) == str(file):
+                    self.assertTrue(owner.lock._is_owned())
+                    counts[str(path)] += 1
+                return original(path, *args, **kwargs)
+            lease = 'single-observation-' + str(confirmed)
+            previous_access = owner._file_access_sequence
+            held = None
+            try:
+                with (patch.object(os, 'stat', counted),
+                      patch.object(module, '_local_file_inventory',
+                                   wraps=module._local_file_inventory) as inventory):
+                    if confirmed:
+                        held = owner.acquire_confirmed(path=str(source), adapter_id='a', lease_id=lease,
+                            expected_owner_id=state['owner_id'], expected_epoch=state['epoch'],
+                            expected_content_sha256=publication['content_sha256'])
+                    else:
+                        held = owner.acquire(path=str(source), adapter_id='a', lease_id=lease)
+                self.assertEqual(inventory.call_count, 1, f'confirmed={confirmed}')
+                self.assertEqual(counts[str(file)], 2)
+                self.assertEqual(held['file_footprint'], expected_footprint)
+                self.assertEqual(held['confirmed_source'], publication)
+                self.assertEqual(owner._file_access_sequence, previous_access + 1)
+                self.assertTrue(held['content_verified'])
+                with owner.mutation(source) as allowed:
+                    self.assertFalse(allowed)
+                again = owner.acquire(path=str(source), adapter_id='a', lease_id=lease)
+                self.assertEqual(again, held)
+                self.assertEqual(owner._file_access_sequence, previous_access + 1)
+            finally:
+                if held is not None:
+                    owner.release(lease_id=lease, expected_owner_id=owner.owner_id)
+        self.assertFalse(owner.leases)
+
+    def test_read_lease_second_pass_mutation_withdraws_before_install(self):
+        fixture, owner, manifests, limits = self.make()
+        source = fixture.nvme / 'a'
+        state = owner.source_snapshot('a')
+        publication = next(row for row in state['sources'] if row['tier'] == 'nvme')
+        file = next(p for p in source.rglob('*') if p.is_file())
+        original, count = os.stat, 0
+        def changing(path, *args, **kwargs):
+            nonlocal count
+            if kwargs.get('follow_symlinks') is False and str(path) == str(file):
+                count += 1
+                if count == 2:
+                    value = original(path)
+                    os.utime(path, ns=(value.st_atime_ns, value.st_mtime_ns + 1_000_000_000))
+            return original(path, *args, **kwargs)
+        access = owner._file_access_sequence
+        with patch.object(os, 'stat', changing):
+            with self.assertRaisesRegex(RuntimeError, 'changed while collecting footprint'):
+                owner.acquire_confirmed(path=str(source), adapter_id='a', lease_id='must-not-exist',
+                    expected_owner_id=state['owner_id'], expected_epoch=state['epoch'],
+                    expected_content_sha256=publication['content_sha256'])
+        self.assertFalse(owner.leases)
+        self.assertNotIn(source, owner._confirmed_sources)
+        self.assertEqual(owner.source_epoch, state['epoch'] + 1)
+        self.assertEqual(owner._file_access_sequence, access)
+
