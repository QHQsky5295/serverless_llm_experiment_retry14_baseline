"""Reuse D733 interval analysis on closed D749; no GPU replay or instrumentation."""
import collections
import json
import os
import sys
from pathlib import Path
ROOT = Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
RAW = Path(__file__).resolve().parent
OUT = ROOT/'paper_results/ieee_tc/p2_backend/d750_d749_planner_intervals'
sys.path.insert(0, str(ROOT))
import ijson
from scripts import ieee_tc_preflight as p
from scripts.ieee_tc.audit_d402_serverlessllm_path import timing_stats

def save(path, value):
    with path.open('x') as f:
        json.dump(value, f, indent=2, allow_nan=False)
        f.write('\n')

assert os.sched_getaffinity(0) == {2, 3, 26, 27}
assert os.environ['CUDA_VISIBLE_DEVICES'] == ''
identity = p.scope_identity(p.cg_path().name)
save(RAW/'identity.json', identity)
OUT.mkdir(parents=True, exist_ok=False)
prior_path = ROOT/'paper_results/ieee_tc/p2_backend/d749_3b_fresh_host_descriptor_full_w0/completion/closed_outcome.json'
prior = json.loads(prior_path.read_text())
assert prior['passed'] and prior['all_allocations_released']
source = next(x for x in prior['source_refs'] if Path(x['path']).name == 'main_outcome.json')
path = Path(source['path'])
assert p.digest(path) == source['sha256']
with path.open('rb') as f:
    events = list(ijson.items(f, 'planning_cpu_events.item', use_float=True))
assert events
groups = []
for operation in sorted({e['operation'] for e in events}):
    rows = [e for e in events if e['operation'] == operation]
    metrics = collections.defaultdict(list)
    for e in rows:
        for key, a, b in (
            ('parent_freeze_ms', 'captured_monotonic_s', 'detached_monotonic_s'),
            ('async_wait_for_planner_ms', 'detached_monotonic_s', 'submitted_monotonic_s'),
            ('child_dispatch_ms', 'submitted_monotonic_s', 'worker_started_monotonic_s'),
            ('child_elapsed_ms', 'worker_started_monotonic_s', 'worker_finished_monotonic_s'),
            ('child_finish_to_parent_join_ms', 'worker_finished_monotonic_s', 'joined_monotonic_s')):
            assert e[b] >= e[a]
            metrics[key].append((e[b] - e[a]) * 1000)
        for key in ('input_bytes', 'output_bytes', 'initialized_execution_bytes'):
            if key in e:
                metrics[key].append(e[key])
        metrics['worker_cpu_ms'].append(e['worker_cpu_seconds'] * 1000)
        if operation == 'owned_execution_epoch':
            for key in ('frozen_validation_seconds', 'execution_objectives_seconds'):
                assert e[key] >= 0
                metrics[key.replace('_seconds', '_ms')].append(e[key] * 1000)
            residual = (e['worker_finished_monotonic_s'] - e['worker_started_monotonic_s']
                        - e['frozen_validation_seconds'] - e['execution_objectives_seconds'])
            assert residual >= 0
            metrics['unpartitioned_child_wall_ms'].append(residual * 1000)
    groups.append(dict(operation=operation, n=len(rows),
        states=dict(collections.Counter(e['state'] for e in rows)),
        metrics={key: dict(timing_stats(values), total=sum(values)) for key, values in metrics.items()}))
save(OUT/'planner.json', dict(kind='d750_d749_existing_planner_interval_partition_v1', passed=True,
    source=source, context=dict(path=str(prior_path), sha256=p.digest(prior_path)),
    reused_script=dict(path=str(ROOT/'results/ieee_tc/p2_backend_qualification/d733_20261022/planner.py'),
        sha256=p.digest(ROOT/'results/ieee_tc/p2_backend_qualification/d733_20261022/planner.py')),
    script_sha256=p.digest(Path(__file__)), scope=identity,
    events=len(events), groups=groups, new_gpu_replays=0, production_changes=False,
    limitation='Worker wall residual includes decoding, input construction, optimization, hashing and output serialization; it is NOT measured knapsack time. Async queue/dispatch/return delays are not controller CPU. No causal TTFT subtraction or performance gain is inferred.'))
with (OUT/'planner.py.snapshot').open('xb') as f:
    f.write(Path(__file__).read_bytes())
cg = p.cg_path()
save(OUT/'resources.json', dict(scope=identity, peak_bytes=int((cg/'memory.peak').read_text()),
    events=(cg/'memory.events').read_text(), swap_bytes=int((cg/'memory.swap.current').read_text())))
print(json.dumps(dict(passed=True, groups=groups), indent=2))
