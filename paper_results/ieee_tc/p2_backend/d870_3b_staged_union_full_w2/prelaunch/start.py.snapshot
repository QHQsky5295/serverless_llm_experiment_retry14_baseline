"""D870: reuse D734's bounded validation/backup/start sequence, no new runtime."""
import ast
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys

ROOT = Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
RAW = Path(__file__).resolve().parent
OUT = ROOT/'paper_results/ieee_tc/p2_backend/d870_3b_staged_union_full_w2/prelaunch'
PYTHON = '/home/qhq/.venvs/primelora_vllm0300_tc_20260925/bin/python'
sys.path.insert(0, str(ROOT))
from scripts import ieee_tc_preflight as p

def read(path): return json.loads(path.read_text())
def save(path, value):
    with path.open('x') as f:
        json.dump(value, f, indent=2, allow_nan=False)
        f.write('\n')
def call(args):
    return subprocess.check_output(args, cwd=ROOT, text=True,
        stderr=subprocess.STDOUT, timeout=55).strip()

assert os.sched_getaffinity(0) == {2, 3, 26, 27}
own = p.scope_identity(p.cg_path().name)
save(RAW/'start_identity.json', own)
group = Path(own['path'])
assert (group/'memory.high').read_text().strip() == str(3*p.GIB)
assert (group/'memory.max').read_text().strip() == str(4*p.GIB)
assert (group/'memory.swap.max').read_text().strip() == '0'
events_before = (group/'memory.events').read_text()
assert not call(['nvidia-smi', '--query-compute-apps=pid', '--format=csv,noheader'])
assert not call(['git', 'diff', '--cached', '--name-only'])
assert not call(['git', 'diff', '--name-only', 'HEAD', '--', 'faaslora', 'scripts/run_all_experiments.py'])
assert not (RAW/'3b_max3_full_w2').exists()
assert not Path('/dev/shm/tc-d870-3b-w2').exists()
OUT.mkdir(parents=True, exist_ok=False)
previous = read(ROOT/'paper_results/ieee_tc/p2_backend/d858_3b_single_lease_full_w2/prelaunch_resume/qualification.json')
changed = {str(ROOT/name) for name in (
    'scripts/ieee_tc/run_d293_7b_prefetch_validation_100.sh',
    'tests/test_ieee_tc_d456_diagnostic_contract.py',
    'docs/ieee_tc/EXECUTION_STATUS.md',
    'docs/ieee_tc/D846_STAGING_IDENTITY_FULL_W2_20261025.md',
    'docs/ieee_tc/D858_SINGLE_LEASE_FULL_W2_20261026.md')}
candidate_changes = call(['git', 'diff', '--name-only',
    '523bef06ccf940da26e156a1d51f432ae73f3604', 'HEAD', '--',
    'faaslora', 'scripts', 'tests']).splitlines()
changed.update(str(ROOT/name) for name in candidate_changes)
refs = {name: sha for name, sha in previous['refs'].items() if name not in changed and not name.startswith(str(ROOT/'docs/ieee_tc')+'/')}
refs.update({
    str(ROOT/'docs/ieee_tc/METRIC_PROTOCOL_FROZEN_V1.md'): '5f0732ef54d629b40cece42bdbf536e8e74c6505e3ec5d4c7e8742408ad80f22',
    str(ROOT/'docs/ieee_tc/METRIC_PROTOCOL_SINGLE_RUN_V2.md'): '193bf1535af1aa50f83d98dc2e944ecbdc7bd27aa96baeca82f0654e02f9357d',
    '/home/qhq/storage_audit_20260915/PrimeLoRA-PLAN.md': 'd7acd08127d4f4513b23af6dd57a9647cf047570f2b563e361e716ccb0b32b83',
})
protected = {str(ROOT/'configs/generated/lora_manifest_1000.json'):
    '3b69bd0a6888aa56e98c3b9efb61234860d4b80f25729cfea6b79126d19127df'}
seal = p.verify_seal(RAW.parent.parent/'slora_qualification/d435_20261011/protected_before.json')
assert seal['pass'] and seal['entry_count'] == 147
save(OUT/'protected_147.json', seal)
assert call(['git','branch','--show-current']) == 'retry14_continuous_queue_v2'
assert call(['git','rev-parse','HEAD']) == 'af824ab5967c1c28d988abd0db10e40bffcba36f'

qualified = ROOT/'paper_results/ieee_tc/p2_backend/d869_staged_union_projection'
qualification = read(qualified/'qualification.json')
assert qualification['passed'] and qualification['returncode'] == 0
assert 'Ran 323 tests' in (qualified/'tests.txt').read_text()
for name, sha in qualification['source_shas'].items():
    assert p.digest(Path(name)) == sha, name
for row in read(qualified/'manifest.json')['files']:
    assert p.digest(Path(row['path'])) == row['sha256'], row['path']
summary = read(qualified/'summary.json')
assert summary['candidate_status'] == 'qualified mechanics; complete-workload performance not yet measured'
assert not summary['production_promoted'] and not summary['full_performance_run']
descriptor = RAW.parent/'d747_20261023/_ieee_native_host_descriptor.cpython-312-x86_64-linux-gnu.so'
assert p.digest(descriptor) == 'b76733db910a0041409ce375e7b5a281dabadd6d0e5796699bf8fe574e293044'
save(OUT/'reused_d869.json', dict(cpu_tests=323, new_cpu_functional_tests=0,
    qualification_sha256=p.digest(qualified/'qualification.json'),
    manifest_sha256=p.digest(qualified/'manifest.json'),
    summary_sha256=p.digest(qualified/'summary.json'),
    descriptor=str(descriptor), descriptor_sha256=p.digest(descriptor),
    candidate_changes=candidate_changes, graph_mode=False,
    negative_component_means_retained=True, numerical_correctness_qualified=False))

for name, sha in (refs | protected).items():
    assert p.digest(Path(name)) == sha, name
files = [
    'configs/ieee_tc/20261026_d870_3b_max3_full_w2.yaml',
    'scripts/ieee_tc/run_d293_7b_prefetch_validation_100.sh',
    'tests/test_ieee_tc_d456_diagnostic_contract.py',
    'docs/ieee_tc/D870_STAGED_UNION_FULL_W2_20261026.md',
    'docs/ieee_tc/EXECUTION_STATUS.md',
]
for name in files + candidate_changes + [
    'scripts/run_all_experiments.py', 'faaslora/memory/residency_manager.py',
    'faaslora/utils/logger.py']:
    refs[str(ROOT/name)] = p.digest(ROOT/name)
for name in ('scripts/ieee_tc/run_d293_7b_prefetch_validation_100.sh',):
    call(['bash', '-n', str(ROOT/name)])
for path in sorted(RAW.iterdir()):
    if path.suffix not in ('.py', '.sh'):
        continue
    if path.suffix == '.py': ast.parse(path.read_text())
    else: call(['bash', '-n', str(path)])
    with (OUT/(path.name+'.snapshot')).open('xb') as f: f.write(path.read_bytes())
    refs[str(path)] = p.digest(path)
with (OUT/'tests.txt').open('x') as log:
    subprocess.run([PYTHON, '-B', '-m', 'unittest',
        'tests.test_ieee_tc_d456_diagnostic_contract.D870FullContract',
        'tests.test_ieee_tc_d456_diagnostic_contract.D858FullContract', '-v'],
        cwd=ROOT, stdout=log, stderr=subprocess.STDOUT, check=True, timeout=55)
assert (group/'memory.events').read_text() == events_before
assert (group/'memory.swap.current').read_text().strip() == '0'
save(OUT/'qualification.json', dict(passed=True, identity=own, refs=refs,
    protected=protected,
    targeted_tests=int(re.search(r'Ran (\d+) tests', (OUT/'tests.txt').read_text()).group(1)),
    full_source_count=4000, diagnostic_prefix_count=None, replay_profile='W2',
    replay_scope='full_source_v1', inference_policy_unchanged=True,
    new_production_instrumentation=False, cpu_time_profile=False,
    formal_performance_result=False, observer_enabled=False, source_cpu_tests_reused=323,
    numerical_correctness_qualified=False, performance_candidate_accepted=False, resources={key: (group/key).read_text().strip()
        for key in ('memory.peak', 'memory.events', 'memory.swap.current')}))
members = [dict(path=str(path.relative_to(ROOT)), sha256=p.digest(path))
           for path in sorted(OUT.iterdir()) if path.is_file()]
save(OUT/'manifest.json', dict(files=members))
files += [str(path.relative_to(ROOT)) for path in sorted(OUT.iterdir()) if path.is_file()]
secret = re.compile(r'-----BEGIN (?:OPENSSH |RSA |EC )?PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]+|(?im:^[ \t]*(?:password|passwd|secret|api_key|PRIME_REMOTE_TOKEN)[ \t]*=[ \t]*[\x22\x27]?[A-Za-z0-9+/]{8,})')
for name in files:
    assert not secret.search((ROOT/name).read_text()), name
assert 'configs/generated/lora_manifest_1000.json' not in files
call(['git', 'diff', '--check', '--', *files])
call(['git', 'add', '--', *files])
assert set(call(['git', 'diff', '--cached', '--name-only']).splitlines()) == set(files)
call(['git', 'diff', '--cached', '--check'])
call(['git', 'commit', '-m', 'tc: register full 3B W2 for staged union projection (D870)'])
head = call(['git', 'rev-parse', 'HEAD'])
branch = 'refs/heads/backup/d870-staged-union-fullw2-20261026'
save(RAW/'commit.json', dict(head=head, ref=branch, files=files))
call(['git', '-c', 'http.version=HTTP/1.1', 'push', 'faaslora_origin', 'HEAD:'+branch])
assert call(['git', '-c', 'http.version=HTTP/1.1', 'ls-remote', 'faaslora_origin', branch]).split()[0] == head
save(RAW/'backup.json', dict(passed=True, head=head, ref=branch, files=files, v2_synchronized=False))
gate = p.preflight([ROOT, RAW], 32*p.GIB)
save(RAW/'launch_gate.json', gate)
assert gate['preflight_pass'], gate['issues']
assert not call(['nvidia-smi', '--query-compute-apps=pid', '--format=csv,noheader'])
session = 'tc-d870-3b-staged-union-full-w2'
assert subprocess.run(['tmux', 'has-session', '-t', session], stderr=subprocess.DEVNULL).returncode != 0
call(['bash', str(RAW/'start_remote.sh')])
call(['/usr/bin/python3', '-B', str(RAW/'check_remote_health_stdlib.py')])
call(['tmux', 'new-session', '-d', '-s', session, '-c', str(ROOT),
      shlex.join(['bash', str(RAW/'run_and_release.sh')])])
save(RAW/'start_receipt.json', dict(launched=True, head=head, backup_ref=branch,
    tmux=session, identity=own, qualification_sha256=p.digest(OUT/'qualification.json')))
print(json.dumps(dict(launched=True, head=head, ref=branch, tmux=session)))
