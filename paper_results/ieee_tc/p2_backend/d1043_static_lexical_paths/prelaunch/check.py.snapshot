"""Reuse D1042's bounded CPU test wrapper; preserve parent and candidate outcomes."""
import json
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
RAW = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))
from scripts import ieee_tc_preflight as p

mode = sys.argv[1]
assert mode in ('parent', 'candidate')
identity = p.scope_identity(p.cg_path().name)
assert os.sched_getaffinity(0) == {2,3,26,27}
assert os.environ['CUDA_VISIBLE_DEVICES'] == ''
assert not subprocess.check_output(['nvidia-smi','--query-compute-apps=pid',
    '--format=csv,noheader'], text=True).strip()
tests = (['tests.test_ieee_tc_static_preparation.StaticPreparationOwner.'
          'test_static_candidate_paths_are_not_reconstructed_on_every_snapshot']
         if mode == 'parent' else
         ['tests.test_ieee_tc_static_preparation', 'tests.test_ieee_tc_file_observation'])
with (RAW/f'{mode}_tests.txt').open('x') as log:
    result = subprocess.run([sys.executable,'-B','-m','unittest',*tests,'-v'],
        cwd=ROOT, stdout=log, stderr=subprocess.STDOUT)
resources = p.cgroup_snapshot(p.cg_path())
assert resources['memory.high'] == 3*p.GIB and resources['memory.max'] == 4*p.GIB
assert resources['memory.swap.max'] == 0
with (RAW/f'{mode}_tests.json').open('x') as handle:
    json.dump(dict(passed=result.returncode==0, returncode=result.returncode,
        identity=identity,resources=resources,
        sources={name:p.digest(ROOT/name) for name in (
            'faaslora/memory/residency_manager.py',
            'tests/test_ieee_tc_static_preparation.py',
            'tests/test_ieee_tc_file_observation.py')},
        wrapper_sha256=p.digest(Path(__file__))), handle, indent=2)
raise SystemExit(result.returncode)
