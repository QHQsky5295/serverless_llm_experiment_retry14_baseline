"""D188-style alternating component comparison, existing tiny fixture only."""
import ast
import json
import os
from pathlib import Path
import subprocess
import sys
import time
from types import MethodType

ROOT = Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
RAW = Path(__file__).resolve().parent
PARENT = '0c7779926e8941a48cdc98300d4720bdbb54f0cc'
sys.path.insert(0, str(ROOT))
from scripts import ieee_tc_preflight as p
from faaslora.memory import residency_manager as module
from faaslora.storage.http_artifact_store import FrozenPreparationDescriptions
from tests.test_ieee_tc_file_observation import FreshFileObservation, without_capture_times

identity = p.scope_identity(p.cg_path().name)
assert os.sched_getaffinity(0) == {2,3,26,27} and os.environ['CUDA_VISIBLE_DEVICES'] == ''
assert not subprocess.check_output(['nvidia-smi','--query-compute-apps=pid',
    '--format=csv,noheader'], text=True).strip()
source = subprocess.check_output(['git','show',PARENT+':faaslora/memory/residency_manager.py'],
    cwd=ROOT, text=True)
cls = next(node for node in ast.parse(source).body
           if isinstance(node, ast.ClassDef) and node.name == 'LocalSourceReferences')
methods = [node for node in cls.body if isinstance(node, ast.FunctionDef) and node.name in
           ('preparation_snapshot','_static_preparation_targets')]
assert len(methods) == 2
namespace = dict(vars(module))
exec(compile(ast.Module(body=methods, type_ignores=[]), PARENT+':residency_manager.py','exec'), namespace)
versions = dict(parent=(namespace['preparation_snapshot'],namespace['_static_preparation_targets']),
    candidate=(module.LocalSourceReferences.preparation_snapshot,
               module.LocalSourceReferences._static_preparation_targets))
case = FreshFileObservation()
try:
    fixture,owner,manifests,limits = case.make()
    manifests.update({f'absent-{i}':dict(manifests['a']) for i in range(496)})
    manifests = FrozenPreparationDescriptions(manifests)
    expected = without_capture_times(owner.preparation_snapshot(manifests=manifests,limits=limits))
    rows = []
    for pair, order in enumerate((('parent','candidate'),('candidate','parent'),('parent','candidate')),1):
        for version in order:
            snapshot, targets = versions[version]
            owner._static_preparation_targets = MethodType(targets, owner)
            owner._preparation_target_binding = None
            owner._preparation_targets = None
            owner._preparation_target_paths = None
            start = time.perf_counter_ns()
            cold = snapshot(owner, manifests=manifests, limits=limits)
            cold_ms = (time.perf_counter_ns()-start)/1e6
            assert without_capture_times(cold) == expected
            cpu, wall = time.thread_time_ns(), time.perf_counter_ns()
            actual = snapshot(owner, manifests=manifests, limits=limits)
            wall_ms, cpu_ms = (time.perf_counter_ns()-wall)/1e6, (time.thread_time_ns()-cpu)/1e6
            assert without_capture_times(actual) == expected
            rows.append(dict(pair=pair,version=version,wall_ms=wall_ms,cpu_ms=cpu_ms,
                first_template_snapshot_ms=cold_ms,exact_output_match=True))
    resources = p.cgroup_snapshot(p.cg_path())
    assert resources['memory.high'] == 3*p.GIB and resources['memory.max'] == 4*p.GIB
    assert resources['memory.swap.max'] == 0
    with (RAW/'component_order_comparison.json').open('x') as handle:
        json.dump(dict(passed=True,identity=identity,resources=resources,rows=rows,
            parent_commit=PARENT,logical_candidates=len(manifests),
            confirmed_sources=len(owner._confirmed_sources),performance_result=False,
            fixture='existing FreshFileObservation with 496 existing-test absent names',
            source_sha256=p.digest(ROOT/'faaslora/memory/residency_manager.py'),
            parent_source_sha256=__import__('hashlib').sha256(source.encode()).hexdigest(),
            wrapper_sha256=p.digest(Path(__file__))),handle,indent=2)
    print(json.dumps(rows))
finally:
    case.doCleanups()

