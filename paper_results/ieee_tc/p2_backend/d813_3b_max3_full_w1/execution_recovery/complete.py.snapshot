"""Reuse D752's closed-run audit, binding D813 to the frozen W1 reference."""
import hashlib
import json
from pathlib import Path

_raw = Path(__file__).resolve().parent
_template = _raw.parent / 'd752_20261023/complete.py'
_source = _template.read_text()
_replacements = [
    ('3b_dense_alias_validation_full_w0', '3b_max3_full_w1'),
    ('d752_3b_max3_full_w1', 'd813_3b_max3_full_w1'),
    ('d752_20261023', 'd813_20261025'),
    ('D752_3B_DENSE_ALIAS_VALIDATION_FULL_W0_20261023.md',
     'D813_3B_MAX3_FULL_W1_20261025.md'),
]
for _old, _new in _replacements:
    assert _old in _source, _old
    _source = _source.replace(_old, _new)

_start = _source.index("old_path = ROOT / ")
_end = _source.index("save(OUT / 'comparison.json', comparison)", _start)
_source = _source[:_start] + '''
assert actual['workload'] == 'W1' and actual['full_replay'] and not actual['full_w0']
reference_path = ROOT/'paper_results/ieee_tc/main_comparison/d657_3b_references/resident_references.json'
assert p.digest(reference_path) == 'f030f92f7bc426c427c6fa0ea65c8dd315a39cf52fd922973fc507117f30ea7a'
reference = read(reference_path)['W1']
assert reference['workload'] == actual['workload']
assert reference['slo_eval_sha256'] == actual['common_slo_sha256']
comparison = dict(
    kind='d813_single_w1_frozen_resource_reference_observation_v1',
    current=ref(metric), reference=ref(reference_path), reference_workload='W1',
    reference_id=reference['reference_id'],
    reference_gpu_seconds=reference['U_ref_gpu_seconds'],
    budget_gpu_seconds=reference['B_gpu_seconds'],
    observed_within_budget=actual['physical_gpu_seconds'] <= reference['B_gpu_seconds'],
    budget_utilization=actual['physical_gpu_seconds']/reference['B_gpu_seconds'],
    gpu_seconds_reduction_fraction=1-actual['physical_gpu_seconds']/reference['U_ref_gpu_seconds'],
    gpu_seconds_per_binding_valid_request=actual['physical_gpu_seconds']/4000,
    joint_slo_delta_percentage_points=100*(actual['joint_slo_fraction']-reference['source_observed_joint_slo']),
    normalized_p95_ttft=actual['metrics']['ttft_ms']['p95_type1']/reference['Q_ref_p95_ttft_ms'],
    joint_slo_margin_requests=actual['counts']['joint_pass']-3800,
    n_correct=actual['n_correct'], ranking_eligible=False, confidence_interval=None,
    complete_g1_g2=False, independent_holdout=False,
    scope='Known W1 development observation versus the frozen W1 resident reference; no cross-workload improvement claim, independent numerical proof, or final ranking.')
''' + _source[_end:]

with (_raw/'completion_template.json').open('x') as _stream:
    json.dump(dict(path=str(_template), sha256=hashlib.sha256(
        _template.read_bytes()).hexdigest(), replacements=_replacements,
        comparison_change='Replace W0 direct-parent deltas with frozen D657 W1 resource-reference comparison.'),
        _stream, indent=2)
    _stream.write('\n')
with (_raw/'completion_program.py.snapshot').open('x') as _stream:
    _stream.write(_source)
exec(compile(_source, str(_raw/'completion_program.py.snapshot'), 'exec'), globals())
