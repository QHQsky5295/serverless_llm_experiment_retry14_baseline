"""Reuse D752 descriptor/closure checks without cross-workload causal deltas."""
import hashlib
import json
from pathlib import Path

_raw = Path(__file__).resolve().parent
_template = _raw.parent/'d752_20261023/seal.py'
_source = _template.read_text()
_replacements = [
    ('d752_3b_dense_alias_validation_full_w0', 'd813_3b_max3_full_w1'),
    ('assert requests == 4000 and len(workers) == 4',
     "assert requests == 4000\nassert len(workers) == read(OUT/'completion/closed_outcome.json')['physical_allocation_count']"),
    ('d752_closed_fresh_descriptor_observation_v1', 'd813_closed_w1_descriptor_observation_v1'),
    ('retain_d751_w0_latency_feasible_not_complete_g1_g2',
     'retain_d813_single_w1_observation_pending_w2'),
    ('Freeze this single W0 observation: common joint latency attainment exceeds 95%, but physical GPU time increased versus D749. Retain D751 without claiming resource improvement, complete G1/G2, cross-workload superiority, or independent numerical adapter correctness. Do not repeat this key. Preserve direct-parent and historical comparisons, all failed candidates, and the complete remaining matrix.',
     'Freeze this single W1 observation with its actual joint latency and budget feasibility. No same-key repeat, threshold change, independent numerical correctness claim, or final G1/G2 ranking. W2 remains required under the same configuration. Preserve all prior points and the complete remaining matrix.'),
]
for _old, _new in _replacements:
    assert _old in _source, _old
    _source = _source.replace(_old, _new)
_start = _source.index('comparisons = []')
_end = _source.index("counts = metric['counts']", _start)
_source = _source[:_start] + '''
assert metric['workload'] == 'W1' and metric['full_replay'] and not metric['full_w0']
comparisons = [read(OUT/'completion/comparison.json')]
protected_path = Path('/home/qhq/serverless_llm_experiment/results/ieee_tc/slora_qualification/d435_20261011/protected_before.json')
assert p.digest(protected_path) == '79df0c64c0d88236bc20b439d735f8dcab113f06582421151742aa63a5a2be54'
protected = read(protected_path)['entries']
assert len(protected) == 147
for name, entry in protected.items():
    assert p.digest(Path(name)) == entry['sha256'], name
save(OUT/'protected_147_after.json', dict(passed=True, files=len(protected), source=ref(protected_path)))
''' + _source[_end:]
_source = _source.replace("protected_publication_files=len(q['protected'])",
    "qualification_protected_files=len(q['protected']), protected_publication_and_user_files=len(protected)")
with (_raw/'seal_template.json').open('x') as _stream:
    json.dump(dict(path=str(_template), sha256=hashlib.sha256(
        _template.read_bytes()).hexdigest(), replacements=_replacements,
        comparison_change='Use only the frozen same-workload W1 reference; independently verify the existing 147-file protected manifest.'),
        _stream, indent=2)
    _stream.write('\n')
with (_raw/'seal_program.py.snapshot').open('x') as _stream:
    _stream.write(_source)
exec(compile(_source, str(_raw/'seal_program.py.snapshot'), 'exec'), globals())
