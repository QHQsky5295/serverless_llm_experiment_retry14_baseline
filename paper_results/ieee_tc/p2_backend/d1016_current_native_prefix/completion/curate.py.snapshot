"""D1016 closed-evidence curation; reuse D863 overlap and D703 delivery checks."""
import collections
import csv
import importlib.util
import json
import math
import os
from pathlib import Path
import shutil
import subprocess
import sys
import textwrap
import ijson

ROOT = Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
RAW = Path(__file__).resolve().parent
RUN = RAW/'d1016_attempt2_3b_native_prefix1000'
OUT = ROOT/'paper_results/ieee_tc/p2_backend/d1016_current_native_prefix/completion'
sys.path.insert(0, str(ROOT))
from scripts import ieee_tc_preflight as p
from scripts.analyze_control_path_overhead import core_interval_overlap
from scripts.ieee_tc.audit_d703_3b_full import write_exclusive_csv

def read(path): return json.loads(path.read_text())
def ref(path): return dict(path=str(path), sha256=p.digest(path))
def save(path, value):
    with path.open('x') as f:
        json.dump(value, f, indent=2, allow_nan=False); f.write('\n')

identity = p.scope_identity(p.cg_path().name)
group = Path(identity['path'])
assert os.sched_getaffinity(0) == {2, 3, 26, 27} and os.environ['CUDA_VISIBLE_DEVICES'] == ''
assert (group/'memory.high').read_text().strip() == str(3*p.GIB)
assert (group/'memory.max').read_text().strip() == str(4*p.GIB)
assert (group/'memory.swap.max').read_text().strip() == '0'
assert not subprocess.check_output(['nvidia-smi','--query-compute-apps=pid','--format=csv,noheader'],text=True).strip()
assert not OUT.exists()
assert read(RAW/'analysis_execution.json')['passed']
launch = read(RUN/'launch.json')
assert launch['pass'] and launch['native_gpu_context_release_confirmed'] and launch['service_path_removed']
audit = read(RAW/'analysis1/audit.json')
assert audit['protocol_bound_count'] == 1000 and audit['component_observations_complete']
core = read(RAW/'analysis1/core_timing/summary.json')
for item in core['sources']: assert p.digest(Path(item['path'])) == item['sha256']
with (RAW/'analysis1/core_timing/decode_windows.csv').open() as f:
    windows = list(csv.DictReader(f))
assert len(windows) == 1000 and all(w['observation_complete'] == 'True' for w in windows)

# Unchanged per-owner interval intersections and grouping from the closed D863 audit.
template = RAW.parent/'d863_20261026_attempt2/finalize.py'
assert p.digest(template) == '0131c8685820ea0883252b24e74a3495535311350fb9f6b589673d4599ae3231'
source = template.read_text()
overlap_source = source[source.index('client_rows=[]'):source.index('# This specific diagnostic')]
exec(compile(overlap_source, str(template), 'exec'), globals())

outcome = RUN/'launch.launch/physical_deployment/main_outcome.json'
with outcome.open('rb') as f:
    transfers = next(ijson.items(f, 'remote_transfers', use_float=True))
ids = {row['http_transfer_id'] for row in transfers}
assert len(ids) == len(transfers)
remote = '/home/lab14/primelora_remote/tc/d80_20260927/3b/transfers-026842a3bec74f1b9e012bb813642067.jsonl'
expected = subprocess.check_output(['ssh','-o','BatchMode=yes','primelora-artifact-174',
    'sha256sum',remote],text=True).split()[0]
snapshot = RAW/'remote_transfer_log_snapshot.jsonl'
assert not snapshot.exists()
subprocess.run(['scp','-q','-o','BatchMode=yes','primelora-artifact-174:'+remote,str(snapshot)],check=True)
assert p.digest(snapshot) == expected
journal = RAW/'remote_transfers.jsonl'
matched = []
with snapshot.open() as f:
    for line in f:
        row = json.loads(line)
        if row.get('transfer_id') in ids: matched.append(row)
with journal.open('x') as f:
    for row in matched: f.write(json.dumps(row, sort_keys=True)+'\n')
spec = importlib.util.spec_from_file_location('d1016_artifact_health', ROOT/'faaslora/storage/http_artifact_store.py')
module = importlib.util.module_from_spec(spec); sys.modules[spec.name] = module; spec.loader.exec_module(module)
client = module.HttpArtifactStoreClient(endpoint='http://192.168.4.174:18080',
    token=Path('/home/qhq/.config/primelora-tc-d75/artifact.token').read_text().strip(),
    timeout_s=5, required_delivery_mode='prepublished_gzip_v1')
health = client.health()
assert health['clock_id'] == 'remote-process-monotonic:b7a04b62f38c4ae6adabb4da5c0fd8dc'
assert health['ok'] and health['delivery_mode'] == 'prepublished_gzip_v1'
save(RAW/'remote_health.json', {'3b':health, 'collection_phase':'post_run_existing_service'})
delivery_template = ROOT/'scripts/ieee_tc/audit_d703_3b_full.py'
assert p.digest(delivery_template) == '8a60e085434f8ec1d868efc0f8f44b23a9ef1262740cbc846a7e307f9be5d85c'
source = delivery_template.read_text()
start = source.index('    server_rows = ', source.index('def audit_closed_outcome'))
end = source.index('    watchdog = ', start)
raw = RUN  # Original helper's name for the same run; no remote-stop assumption.
exec(compile(textwrap.dedent(source[start:end]), str(delivery_template), 'exec'), globals())
delivery = dict(passed=True, transfers=len(transfers), wire_bytes=sum(t['transferred_bytes'] for t in transfers),
    all_server_client_ids_bytes_hashes_match=True, request_time_packing=False,
    remote_service_restarted=False, remote_service_stopped=False,
    remote_monitoring='No new remote resource monitor; no complete remote CPU-interference attribution.',
    remote_snapshot_path=remote, remote_snapshot_sha256=expected,
    source_refs=[ref(x) for x in (snapshot,journal,RAW/'remote_health.json',outcome,delivery_template)])

seal = p.verify_seal(RAW.parent.parent/'slora_qualification/d435_20261011/protected_before.json')
assert seal['pass'] and seal['entry_count'] == 147
assert p.digest(ROOT/'configs/generated/lora_manifest_1000.json') == '3b69bd0a6888aa56e98c3b9efb61234860d4b80f25729cfea6b79126d19127df'
assert p.digest(ROOT/'docs/ieee_tc/EXECUTION_STATUS.md') == '41a4db5bc464dfb885b20d2b5ac321a3631a1a02291d64ac823735505957e374'
assert not any((RAW/'d1016_attempt2_3b_native_prefix1000_nvme').iterdir())
host = Path('/dev/shm/tc-d1016_attempt2_3b_native_prefix1000')
assert not host.exists() or not any(host.iterdir())
OUT.mkdir(parents=True, exist_ok=False)
copies = {'native_audit.json':RAW/'analysis1/audit.json', 'common_slo.json':RAW/'analysis1/common_slo.json',
    'core_summary.json':RAW/'analysis1/core_timing/summary.json',
    'core_boundaries.csv':RAW/'analysis1/core_timing/boundaries.csv',
    'core_processes.csv':RAW/'analysis1/core_timing/processes.csv',
    'decode_windows.csv':RAW/'analysis1/core_timing/decode_windows.csv',
    'collection.json':RAW/'collection.json', 'analysis_execution.json':RAW/'analysis_execution.json',
    'analysis_template.json':RAW/'analysis_template.json',
    'analyze.py.snapshot':RAW/'analyze.py', 'curate.py.snapshot':Path(__file__)}
for name,path in copies.items():
    assert path.stat().st_size < 2*1024**2
    with (OUT/name).open('x') as f: f.write(path.read_text())  # Normalize CSV CRLF for Git.
write_exclusive_csv(OUT/'client_decode_overlaps.csv', client_rows)
write_exclusive_csv(OUT/'client_overlap_groups.csv', groups)
save(OUT/'delivery_closure.json', delivery)
save(OUT/'closure.json', dict(passed=True, n_correct=None, ranking_eligible=False,
    formal_performance_result=False, includes_observer_overhead=True,
    native_contract_requests=1000, observations_complete=1000,
    production_policy_changed=False, observer_changed=False, protected_files_unchanged=147,
    service_path_removed=True, work_caches_empty=True, remote_existing_service_reused=True,
    identity=identity, resources=p.cgroup_snapshot(group), disk_available_bytes=shutil.disk_usage(ROOT).free,
    caveats=['Host spans are not GPU kernel durations or counterfactual removable delay.',
             'Per-request overlaps are not additive service wall time; groups differ in output lengths.',
             'Diagnostic prefix is not a full 4000-request performance point.',
             'Independent numerical correctness remains unknown.'],
    sources=[ref(x) for x in (template, delivery_template, RAW.parent/'d1016_20261102/analyze.py',
        RAW.parent/'d723_20261022/analyze.py',RUN/'launch.json',journal)]))
save(OUT/'manifest.json', dict(files=[ref(x) for x in sorted(OUT.iterdir())]))
top = sorted((r for r in groups if r['group']=='short_2_64' and r['tpot_miss']),
             key=lambda r:r['total_overlap_ms'], reverse=True)
print(json.dumps(dict(passed=True, delivery_transfers=len(transfers), top_short_miss_controls=top[:8])))
