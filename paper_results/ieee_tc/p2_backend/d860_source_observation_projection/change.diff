diff --git a/faaslora/memory/residency_manager.py b/faaslora/memory/residency_manager.py
index 233efbd9..ca3fd287 100644
--- a/faaslora/memory/residency_manager.py
+++ b/faaslora/memory/residency_manager.py
@@ -874,4 +874,7 @@ class LocalSourceReferences:
-        footprint = _local_file_inventory({'source': path}, allocation_bounds=self._file_allocations)
-        observations = ((name, Path(name).lstat()) for allocation in footprint['allocations']
-                        for name in allocation['paths'])
-        return self._source_observation_from_stats(path, footprint, observations)
+        # Identity and capacity describe the same checked observation. Inventory
+        # exposes these stats only after its second fresh pass succeeds; a third
+        # per-path read here would instead mix a later identity with that footprint.
+        observed = {}
+        footprint = _local_file_inventory({'source': path}, allocation_bounds=self._file_allocations,
+                                          _observed_stats=observed)
+        return self._source_observation_from_stats(path, footprint, observed.items())
diff --git a/tests/test_ieee_tc_file_observation.py b/tests/test_ieee_tc_file_observation.py
index 6f1c89d6..d17e15b2 100644
--- a/tests/test_ieee_tc_file_observation.py
+++ b/tests/test_ieee_tc_file_observation.py
@@ -56,0 +57,71 @@ class FreshFileObservation(unittest.TestCase):
+    def test_source_views_project_checked_stats_without_a_third_pass(self):
+        from collections import Counter
+        from faaslora.memory import residency_manager as module
+        fixture, owner, manifests, limits = self.make()
+        source = fixture.nvme / 'a'
+        expected = owner.source_snapshot('a')
+        publication = next(row for row in expected['sources'] if row['tier'] == 'nvme')
+        held = owner.acquire_confirmed(path=str(source), adapter_id='a', lease_id='source-view',
+            expected_owner_id=expected['owner_id'], expected_epoch=expected['epoch'],
+            expected_content_sha256=publication['content_sha256'])
+        self.addCleanup(lambda: owner.release(lease_id='source-view', expected_owner_id=owner.owner_id))
+        expected_witness = owner.demand_witness(held, content_sha256=publication['content_sha256'])
+        file = next(p for p in source.rglob('*') if p.is_file())
+        original = os.stat
+        access = owner._file_access_sequence
+        for operation in ('snapshot', 'witness'):
+            with self.subTest(operation=operation):
+                counts = Counter()
+                def counted(path, *args, **kwargs):
+                    if kwargs.get('follow_symlinks') is False and str(path) == str(file):
+                        self.assertTrue(owner.lock._is_owned())
+                        counts[str(path)] += 1
+                    return original(path, *args, **kwargs)
+                with patch.object(os, 'stat', counted):
+                    if operation == 'snapshot':
+                        actual = owner.source_snapshot('a')
+                        self.assertEqual(actual['sources'], expected['sources'])
+                        self.assertFalse(actual['snapshot_holds_reference'])
+                    else:
+                        actual = owner.demand_witness(held, content_sha256=publication['content_sha256'])
+                        self.assertEqual(actual, expected_witness)
+                self.assertEqual(counts[str(file)], 2)
+                self.assertEqual(owner._file_access_sequence, access)
+                self.assertEqual(set(owner.leases), {'source-view'})
+
+    def test_source_view_second_pass_change_is_rejected_and_withdrawn(self):
+        for operation in ('snapshot', 'witness'):
+            with self.subTest(operation=operation):
+                fixture, owner, manifests, limits = self.make()
+                source = fixture.nvme / 'a'
+                state = owner.source_snapshot('a')
+                publication = next(row for row in state['sources'] if row['tier'] == 'nvme')
+                held = owner.acquire_confirmed(path=str(source), adapter_id='a', lease_id='changed-view',
+                    expected_owner_id=state['owner_id'], expected_epoch=state['epoch'],
+                    expected_content_sha256=publication['content_sha256'])
+                file = next(p for p in source.rglob('*') if p.is_file())
+                original, count = os.stat, 0
+                def changing(path, *args, **kwargs):
+                    nonlocal count
+                    if kwargs.get('follow_symlinks') is False and str(path) == str(file):
+                        count += 1
+                        if count == 2:
+                            value = original(path)
+                            os.utime(path, ns=(value.st_atime_ns, value.st_mtime_ns + 1_000_000_000))
+                    return original(path, *args, **kwargs)
+                epoch, access = owner.source_epoch, owner._file_access_sequence
+                try:
+                    with patch.object(os, 'stat', changing):
+                        with self.assertRaisesRegex(RuntimeError, 'changed while collecting footprint'):
+                            if operation == 'snapshot':
+                                owner.source_snapshot('a')
+                            else:
+                                owner.demand_witness(held, content_sha256=publication['content_sha256'])
+                    self.assertNotIn(source, owner._confirmed_sources)
+                    self.assertEqual(owner.source_epoch, epoch + 1)
+                    self.assertEqual(owner._file_access_sequence, access)
+                    # An invalid observation cannot silently retire a live reader.
+                    self.assertEqual(set(owner.leases), {'changed-view'})
+                finally:
+                    owner.release(lease_id='changed-view', expected_owner_id=owner.owner_id)
+
