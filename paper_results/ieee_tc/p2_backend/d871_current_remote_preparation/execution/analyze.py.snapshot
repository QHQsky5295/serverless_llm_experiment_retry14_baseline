"""D871: reuse D818/D833 on closed D870; no new GPU measurement.

Adapted from D849 analyze.py/control.py: campaign identities only, with the
obsolete D846 gzip-specific prerequisite removed (D870 remains uncompressed).
"""
import json
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
RAW = Path(__file__).resolve().parent
RUN = RAW.parent / 'd870_20261026/3b_max3_full_w2'
OUT = ROOT / 'paper_results/ieee_tc/p2_backend/d871_current_remote_preparation'
BASE = ROOT / 'paper_results/ieee_tc/p2_backend/d870_3b_staged_union_full_w2'
sys.path.insert(0, str(ROOT))
from scripts import ieee_tc_preflight as p
from scripts.ieee_tc.audit_d703_3b_full import (
    diagnose_remote_preparation, diagnose_prefetch_control,
)


def save(path, value):
    with path.open('x') as stream:
        json.dump(value, stream, indent=2, allow_nan=False)
        stream.write('\n')


assert os.sched_getaffinity(0) == {2, 3, 26, 27}
assert os.environ['CUDA_VISIBLE_DEVICES'] == ''
assert not subprocess.check_output(
    ['nvidia-smi', '--query-compute-apps=pid', '--format=csv,noheader'], text=True).strip()
assert p.digest(BASE / 'completion/full4000.json') == '8f7f186d6669b2aa3fe298e681c4f367397e21fd47402cb8f7a47ac175749291'
identity = p.scope_identity(p.cg_path().name)
group = Path(identity['path'])
save(RAW / 'identity.json', identity)
OUT.mkdir(parents=True, exist_ok=False)
before = p.cgroup_snapshot(group)
try:
    diagnose_remote_preparation(RUN, OUT / 'partition', BASE / 'completion/stages')
    diagnose_prefetch_control(RUN, OUT / 'control', OUT / 'partition',
                             BASE / 'settlement_analysis', BASE / 'completion/stages')
finally:
    save(OUT / 'resources.json', dict(
        identity=identity, before=before, after=p.cgroup_snapshot(group),
        program_sha256=p.digest(Path(__file__)),
        analyzer_sha256=p.digest(ROOT / 'scripts/ieee_tc/audit_d703_3b_full.py'),
        new_gpu_replays=0, production_changes=False, n_correct=None,
        confidence_interval=None))
