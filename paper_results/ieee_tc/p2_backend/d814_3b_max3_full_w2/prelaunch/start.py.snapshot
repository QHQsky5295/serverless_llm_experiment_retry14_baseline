"""Reuse the D752 launcher for same-config D814 W2; no new production policy."""
import ast, json, os, re, shlex, subprocess, sys
from pathlib import Path

ROOT = Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
RAW = Path(__file__).resolve().parent
CHECK = ROOT / 'paper_results/ieee_tc/p2_backend/d748_fresh_host_descriptor_integration'
OUT = ROOT / 'paper_results/ieee_tc/p2_backend/d814_3b_max3_full_w2/prelaunch'
sys.path.insert(0, str(ROOT))
from scripts import ieee_tc_preflight as p

def read(path): return json.loads(path.read_text())
def save(path, value):
    with path.open('x') as f:
        json.dump(value, f, indent=2, allow_nan=False)
        f.write('\n')
def call(args):
    return subprocess.check_output(args, cwd=ROOT, text=True, stderr=subprocess.STDOUT, timeout=55).strip()

assert os.sched_getaffinity(0) == {2, 3, 26, 27}
own = p.scope_identity(p.cg_path().name)
save(RAW / 'start_identity.json', own)
group = Path(own['path'])
assert (group/'memory.high').read_text().strip() == str(3*p.GIB)
assert (group/'memory.max').read_text().strip() == str(4*p.GIB)
assert (group/'memory.swap.max').read_text().strip() == '0'
assert not call(['nvidia-smi', '--query-compute-apps=pid', '--format=csv,noheader'])
assert not call(['git', 'diff', '--cached', '--name-only'])
assert not (RAW/'3b_max3_full_w2').exists()
assert not Path('/dev/shm/tc-d814-3b-w2').exists()
OUT.mkdir(parents=True, exist_ok=False)
q = read(CHECK/'qualification.json')
assert q['passed'] and q['default_inventory_ast_identical']
assert q['fresh_resize'] and q['native_loader_exact_tensor_and_clone']
assert len(q['graphs']) == 4 and not q['binary_rebuilt'] and q['new_full_runs'] == 0
for field in ('protected', 'source_shas'):
    for name, sha in q[field].items(): assert p.digest(Path(name)) == sha, name
for item in read(CHECK/'manifest.json')['files']:
    assert p.digest(ROOT/item['path']) == item['sha256'], item['path']
assert read(CHECK/'qualification_closure.json')['closure']['released']
closure = read(ROOT/'results/ieee_tc/p2_backend_qualification/d748_20261023/post_backup_release.json')
assert closure['passed'] and closure['closure']['released']
descriptor = q['descriptor']
assert p.digest(Path(descriptor['library'])) == descriptor['sha256']
native_path = ROOT/'results/ieee_tc/p2_backend_qualification/d747_20261023/native_descriptor.json'
assert p.digest(native_path) == q['reused_d747_cuda_sha256']
native = read(native_path)
assert native['pass'] and len(native['cases']) == 9 and len(native['inventory_equality']) == 4
save(OUT/'reused_qualification.json', dict(passed=True, qualification_path=str(CHECK/'qualification.json'),
    qualification_sha256=p.digest(CHECK/'qualification.json'), tests_reused=9, graphs_reused=4,
    native_cuda_sha256=p.digest(native_path), native_cuda_states_reused=9,
    library=descriptor, new_component_or_gpu_microtests=0, backup_closure=closure))


ALIAS = ROOT/'paper_results/ieee_tc/p2_backend/d751_dense_alias_validation_probe'
alias = read(ALIAS/'qualification/qualification.json')
assert alias['passed'] and alias['production_ast_matches_measured_candidate']
assert alias['new_gpu_replays'] == 0 and alias['protected'] == q['protected']
for name, sha in alias['sources'].items():
    assert p.digest(ROOT/name) == sha, name
for item in read(ALIAS/'manifest.json')['files']:
    assert p.digest(ROOT/item['path']) == item['sha256'], item['path']
assert read(ALIAS/'qualification/test_receipt.json')['returncode'] == 0
assert 'Ran 51 tests' in (ALIAS/'qualification/tests.txt').read_text()
assert read(ALIAS/'qualification/closure.json')['closure']['released']
alias_closure = read(ROOT/'results/ieee_tc/p2_backend_qualification/d751_20261023/post_backup_release.json')
assert alias_closure['passed'] and alias_closure['closure']['released']
save(OUT/'reused_alias_qualification.json', dict(passed=True,
    qualification_sha256=p.digest(ALIAS/'qualification/qualification.json'),
    manifest_sha256=p.digest(ALIAS/'manifest.json'), tests_reused=51,
    measured_candidate_ast_identical=True, sources=alias['sources'],
    new_component_or_gpu_microtests=0, backup_closure=alias_closure))

previous = read(ROOT/'paper_results/ieee_tc/p2_backend/d749_3b_fresh_host_descriptor_full_w0/prelaunch/qualification.json')
refs = {}
for name in ['/home/qhq/storage_audit_20260915/PrimeLoRA-PLAN.md',
             str(ROOT/'docs/ieee_tc/METRIC_PROTOCOL_FROZEN_V1.md'),
             str(ROOT/'docs/ieee_tc/METRIC_PROTOCOL_SINGLE_RUN_V2.md'),
             str(ROOT/'paper_results/ieee_tc/protocols/20261017_3b_slo_d648_frozen.json'),
             str(ROOT/'paper_results/ieee_tc/p2_backend/d725_3b_graph_profile/export/service.json'),
             str(ROOT/'paper_results/ieee_tc/p2_backend/d725_3b_graph_profile/export/preparation.json')]:
    assert p.digest(Path(name)) == previous['refs'][name], name
    refs[name] = previous['refs'][name]
refs.update(q['source_shas'])
refs.update({str(ROOT/name): sha for name, sha in alias['sources'].items()})
refs[descriptor['library']] = descriptor['sha256']
map_path = ROOT/'paper_results/ieee_tc/inputs/20261018_3b_w2_adapter_map_v1.json'
assert p.digest(map_path) == '28c97dc7c1ffcbad49801ec19bec2a9c4cf9c4915c88a7e5163e223ece315e23'
refs[str(map_path)] = p.digest(map_path)
reference = ROOT/'paper_results/ieee_tc/main_comparison/d657_3b_references/resident_references.json'
assert p.digest(reference) == 'f030f92f7bc426c427c6fa0ea65c8dd315a39cf52fd922973fc507117f30ea7a'
refs[str(reference)] = p.digest(reference)
files = ['configs/ieee_tc/20261025_d814_3b_max3_full_w2.yaml',
         'scripts/ieee_tc/run_d293_7b_prefetch_validation_100.sh',
         'tests/test_ieee_tc_d456_diagnostic_contract.py',
         'docs/ieee_tc/D814_3B_MAX3_FULL_W2_20261025.md',
         'docs/ieee_tc/EXECUTION_STATUS.md',
         'scripts/ieee_tc/audit_d703_3b_full.py',
         'tests/test_ieee_tc_diagnostic_plot.py',
         'docs/ieee_tc/D813_3B_MAX3_FULL_W1_20261025.md']
for name in files + ['scripts/run_all_experiments.py', 'faaslora/memory/residency_manager.py',
                     'scripts/run_all_experiments_user_scope.sh', 'scripts/ieee_tc_preflight.py']:
    refs[str(ROOT/name)] = p.digest(ROOT/name)
for path in sorted(RAW.iterdir()):
    if path.suffix not in ('.py', '.sh'): continue
    if path.suffix == '.py': ast.parse(path.read_text())
    else: call(['bash', '-n', str(path)])
    with (OUT/(path.name+'.snapshot')).open('xb') as f: f.write(path.read_bytes())
    refs[str(path)] = p.digest(path)
call(['bash', '-n', str(ROOT/'scripts/ieee_tc/run_d293_7b_prefetch_validation_100.sh')])
tests = call(['/home/qhq/anaconda3/envs/LLM_vllm0102/bin/python', '-B', '-m', 'unittest',
              'tests.test_ieee_tc_d456_diagnostic_contract.D814FullContract', '-v'])
save(OUT/'execution_contract_tests.json', dict(passed=True, output=tests))

# Reuse completed W0/native qualifications; verify the unchanged control, not
# another GPU smoke. Only the new W2 entry/identity checks execute here.
assert call(['git','branch','--show-current']) == 'retry14_continuous_queue_v2'
assert call(['git','rev-parse','HEAD']) == '6c6f452f30de84fc1d1819b2e63bc54ce4c54342'
parent = ROOT/'paper_results/ieee_tc/p2_backend/d812_3b_max3_full_w0'
prior = RAW.parent/'d813_20261025'
assert read(parent/'closure.json')['passed']
assert read(ROOT/'paper_results/ieee_tc/p2_backend/d813_3b_max3_full_w1/closure.json')['passed']
assert read(prior/'post_backup_release.json')['passed']
assert read(prior/'storage_closure.json')['passed']
prior_tests = read(parent/'prelaunch/execution_contract_tests.json')
assert prior_tests['passed'] and 'Ran 8 tests' in prior_tests['output']
for relative in ('faaslora/coordination/autoscaler.py', 'faaslora/experiment/instance_pool.py',
                 'faaslora/datasets/workload_generator.py', 'scripts/run_all_experiments.py'):
    original = subprocess.check_output(['git','show','0a065200744ae6a043e29338c44b917e21104710:'+relative], cwd=ROOT)
    assert original == (ROOT/relative).read_bytes(), relative
    refs[str(ROOT/relative)] = p.digest(ROOT/relative)
before = ast.parse(subprocess.check_output(['git','show',
    '0a065200744ae6a043e29338c44b917e21104710:tests/test_ieee_tc_d456_diagnostic_contract.py'], cwd=ROOT, text=True))
after = ast.parse((ROOT/'tests/test_ieee_tc_d456_diagnostic_contract.py').read_text())
def contract(tree):
    return ast.dump(next(n for n in tree.body if isinstance(n, ast.ClassDef) and n.name == 'D812FullContract'))
assert contract(before) == contract(after)
save(OUT/'reused_d812_control.json', dict(passed=True, tests_reused=8,
    prior_test_receipt_sha256=p.digest(parent/'prelaunch/execution_contract_tests.json'),
    control_and_request_path_unchanged=True, previous_full_closure_sha256=p.digest(parent/'closure.json'),
    new_gpu_microtests=0))
for relative, sha in {
    'scripts/replay_openai_trace.py':'04f3eb52c64c6d684dec3ecef1e6a450d687e0922430c2d77932917e4a38fc22',
    'scripts/run_serverlessllm_relayserve_continuation.sh':'337dceec7a528b7816e5a55e81d3c26f3feb1499976a4d049faa69809acec499',
}.items():
    assert p.digest(Path('/home/qhq/serverless_llm_baselines')/relative) == sha
seal = RAW.parent.parent/'slora_qualification/d435_20261011/protected_before.json'
protected = p.verify_seal(seal)
assert protected['pass'] and protected['entry_count'] == 147
save(OUT/'protected_147.json', protected)
audit_tests = call(['/home/qhq/.venvs/primelora_vllm0300_tc_20260925/bin/python','-B','-m','pytest',
    '-p','no:cacheprovider','-q','tests/test_ieee_tc_diagnostic_plot.py',
    '-k','d813 or d814 or registered_common_slo_population or unregistered_common_slo_population'])
assert '25 passed' in audit_tests
save(OUT/'arrival_audit_tests.json', dict(passed=True, output=audit_tests,
    new_view_tests=18, existing_population_tests=7))
import hashlib, tarfile
evidence = {name: prior/name for name in (
    'backup_completion.json','backup_completion_identity.json','post_backup_release.json',
    'post_backup_release.py','storage_maintenance.py',
    'close_storage.py','storage_identity.json','storage_closure.json')}
evidence['d813_start_template.py'] = prior/'start.py'
evidence['d752_start_template.py'] = RAW.parent/'d752_20261023/start.py'
archive = OUT/'prior_execution_evidence.tar.gz'
secret_members = re.compile(r'-----BEGIN (?:OPENSSH |RSA |EC )?PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]+|(?im:^[ \t]*(?:password|passwd|secret|api_key|PRIME_REMOTE_TOKEN)[ \t]*=[ \t]*[\x22\x27]?[A-Za-z0-9+/]{8,})')
for path in evidence.values():
    assert path.stat().st_size < 2*1024*1024
    assert not secret_members.search(path.read_text()), path
with tarfile.open(archive,'x:gz') as bundle:
    for name,path in evidence.items(): bundle.add(path,arcname=name,recursive=False)
with tarfile.open(archive,'r:gz') as bundle:
    assert set(bundle.getnames()) == set(evidence)
    for name,path in evidence.items():
        assert hashlib.sha256(bundle.extractfile(name).read()).hexdigest() == p.digest(path)
with (OUT/'evidence.sha256').open('x') as stream:
    stream.write(p.digest(archive)+'  '+str(archive)+'\n')
call(['sha256sum','-c',str(OUT/'evidence.sha256')])
storage_prefix = ROOT/'paper_results/ieee_tc/storage'
for name in ('20261025_d813_closed_outcome.json','20261025_d813_closed_outcome_verification.json',
             '20261025_d813_closed_outcome.py.snapshot'):
    files.append(str((storage_prefix/name).relative_to(ROOT)))
verification = read(storage_prefix/'20261025_d813_closed_outcome_verification.json')
assert verification['passed']
assert p.digest(storage_prefix/'20261025_d813_closed_outcome.json') == verification['receipt_sha256']
assert p.digest(storage_prefix/'20261025_d813_closed_outcome.py.snapshot') == verification['source_script_sha256']

save(OUT/'qualification.json', dict(passed=True, identity=own, refs=refs, protected=q['protected'],
    full_source_count=4000, diagnostic_prefix_count=None, configuration_only_three_paths_changed=True,
    candidate_environment={'FAASLORA_IEEE_HOST_DESCRIPTOR_LIBRARY': descriptor['library'],
                           'FAASLORA_IEEE_HOST_DESCRIPTOR_SHA256': descriptor['sha256'],
                           'FAASLORA_TC_REPLAY_PROFILE': 'W2',
                           'FAASLORA_TC_ADAPTER_MAP': str(ROOT/'paper_results/ieee_tc/inputs/20261018_3b_w2_adapter_map_v1.json'),
                           'FAASLORA_TC_ADAPTER_MAP_SHA256': '28c97dc7c1ffcbad49801ec19bec2a9c4cf9c4915c88a7e5163e223ece315e23'},
    reused_interface_tests=9, reused_alias_tests=51, new_execution_contract_tests=3, new_arrival_audit_tests=18, reused_d812_control_tests=8,
    formal_performance_result=False, numerical_scope='D711 retained; no automatic n_correct certification',
    resources=p.cgroup_snapshot(group)))
members = [dict(path=str(path.relative_to(ROOT)), sha256=p.digest(path)) for path in sorted(OUT.iterdir()) if path.is_file()]
save(OUT/'manifest.json', dict(files=members))
files += [str(path.relative_to(ROOT)) for path in sorted(OUT.iterdir()) if path.is_file()]
secret = re.compile(r'-----BEGIN (?:OPENSSH |RSA |EC )?PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]+|(?im:^[ \t]*(?:password|passwd|secret|api_key|PRIME_REMOTE_TOKEN)[ \t]*=[ \t]*[\x22\x27]?[A-Za-z0-9+/]{8,})')
for name in files:
    if name.endswith('.tar.gz'): continue  # member checks above
    assert not secret.search((ROOT/name).read_text()), name
assert 'configs/generated/lora_manifest_1000.json' not in files
call(['git', 'diff', '--check', '--', *files])
call(['git', 'add', '--', *files])
assert set(call(['git', 'diff', '--cached', '--name-only']).splitlines()) == set(files)
call(['git', 'diff', '--cached', '--check'])
call(['git', 'commit', '-m', 'tc: register same-config D814 3B W2 and audit recorded arrival views'])
head = call(['git', 'rev-parse', 'HEAD']); ref = 'refs/heads/backup/d814-max3-fullw2-20261025'
save(RAW/'commit.json', dict(head=head, ref=ref, files=files))
call(['git', 'push', 'faaslora_origin', 'HEAD:'+ref])
assert call(['git', 'ls-remote', 'faaslora_origin', ref]).split()[0] == head
save(RAW/'backup.json', dict(passed=True, head=head, ref=ref, files=files, v2_synchronized=False))
gate = p.preflight([ROOT, RAW], 32*p.GIB)
save(RAW/'launch_gate.json', gate)
assert gate['preflight_pass'], gate['issues']
assert not call(['nvidia-smi', '--query-compute-apps=pid', '--format=csv,noheader'])
session = 'tc-d814-3b-max3-full-w2'
assert subprocess.run(['tmux', 'has-session', '-t', session], stderr=subprocess.DEVNULL).returncode != 0
call(['bash', str(RAW/'start_remote.sh')])
call(['/usr/bin/python3', '-B', str(RAW/'check_remote_health_stdlib.py')])
call(['tmux', 'new-session', '-d', '-s', session, '-c', str(ROOT), shlex.join(['bash', str(RAW/'run_and_release.sh')])])
save(RAW/'start_receipt.json', dict(launched=True, head=head, backup_ref=ref,
    tmux=session, identity=own, qualification_sha256=p.digest(OUT/'qualification.json')))
print(json.dumps(dict(launched=True, head=head, ref=ref, tmux=session)))
