"""D826 adaptation of the D752 explicit-path, protected-result backup procedure."""
import ast
import hashlib
import json
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
RAW = Path(__file__).resolve().parent
OUT = ROOT / 'paper_results/ieee_tc/p2_backend/d884_registered_preparation_boundary'
sys.path.insert(0, str(ROOT))
from scripts import ieee_tc_preflight as p


def read(path):
    return json.loads(path.read_text())


def save(path, value):
    with path.open('x') as stream:
        json.dump(value, stream, indent=2, allow_nan=False)
        stream.write('\n')


def call(args):
    return subprocess.check_output(args, cwd=ROOT, text=True,
                                   stderr=subprocess.STDOUT, timeout=60).strip()



assert os.sched_getaffinity(0) == {2, 3, 26, 27}
own = p.scope_identity(p.cg_path().name)
save(RAW/'backup_resume_identity.json', own)
assert not call(['nvidia-smi', '--query-compute-apps=pid', '--format=csv,noheader'])
previous = read(RAW/'backup_completion_identity.json')
assert not Path(previous['path']).exists() and not p.scope_still_owned(previous)
evidence = OUT/'completion_execution'
doc = ROOT/'docs/ieee_tc/D884_REGISTERED_PREPARATION_BOUNDARY_20261026.md'
status = ROOT/'docs/ieee_tc/EXECUTION_STATUS.md'
files = sorted(path for path in OUT.rglob('*') if path.is_file()) + [doc, status]
expected_staged = {str(path.relative_to(ROOT)) for path in files}
assert set(call(['git','diff','--cached','--name-only']).splitlines()) == expected_staged
protected = read(OUT/'source_boundary.json')['unchanged_sources']
protected[str(ROOT/'configs/generated/lora_manifest_1000.json')] = '3b69bd0a6888aa56e98c3b9efb61234860d4b80f25729cfea6b79126d19127df'
for name, sha in protected.items(): assert p.digest(Path(name)) == sha, name
seal = RAW.parent.parent/'slora_qualification/d435_20261011/protected_before.json'
sealed = p.verify_seal(seal)
assert sealed['pass'] and sealed['entry_count'] == 147
for manifest_name in ('manifest.json', 'completion_execution/manifest.json'):
    for row in read(OUT/manifest_name)['files']:
        path = Path(row['path'])
        if not path.is_absolute(): path = ROOT/path
        assert p.digest(path) == row['sha256'], str(path)
for row in read(OUT/'summary.json')['source_refs']:
    assert p.digest(Path(row['path'])) == row['sha256'], row['path']
assert read(OUT/'summary.json')['passed']
for name in ('resume_backup.py','backup_resume_program.py.snapshot'):
    source = RAW/name
    ast.parse(source.read_text())
    target = evidence/(name+'.snapshot')
    with target.open('xb') as stream: stream.write(source.read_bytes())
    files.append(target)
failure = evidence/'backup_first_attempt.json'
save(failure, dict(status='publication_check_failed_before_commit',
    reason='Inherited CSV group was empty; git checked all staged snapshots under CSV trailing-blank rules.',
    original_snapshot_preserved=True, new_measurements=0, identity=previous,
    correction='Only run the CSV-specific whitespace command when CSV paths are present.'))
files.append(failure)
remote_sha = None
paths = [str(path.relative_to(ROOT)) for path in files]
assert len(paths) == len(set(paths)) and 'configs/generated/lora_manifest_1000.json' not in paths
secret = re.compile(r'-----BEGIN (?:OPENSSH |RSA |EC )?PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]+|(?im:^[ \t]*(?:password|passwd|secret|api_key|PRIME_REMOTE_TOKEN)[ \t]*=[ \t]*[\x22\x27]?[A-Za-z0-9+/]{8,})')
for path in files: assert not secret.search(path.read_text()), str(path)
call(['git','add','--',*paths])
assert set(call(['git','diff','--cached','--name-only']).splitlines()) == set(paths)
ordinary = [x for x in paths if not x.endswith(('.csv', '.snapshot'))]
csvs = [x for x in paths if x.endswith('.csv')]
snapshots = [x for x in paths if x.endswith('.snapshot')]
call(['git', 'diff', '--cached', '--check', '--', *ordinary])
if csvs:
    call(['git', '-c', 'core.whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol',
          'diff', '--cached', '--check', '--', *csvs])
call(['git', '-c', 'core.whitespace=blank-at-eol,space-before-tab,-blank-at-eof',
      'diff', '--cached', '--check', '--', *snapshots])
save(RAW / 'backup_precommit_check.json', dict(passed=True, files=paths,
     protected_files=len(protected), syntax_checked=True,
     qualification='D884 streamed authoritative journal audit: 4010 attempts, unique successful leases, 2845 allocation receipts and source/output SHA. No production changes or new GPU run.'))
call(['git', 'commit', '-m', 'tc: preserve D884 registered preparation boundary and evidence-limited next candidate'])
head = call(['git', 'rev-parse', 'HEAD'])
ref = 'refs/heads/backup/d884-preparation-boundary-20261026'
call(['git', '-c', 'http.version=HTTP/1.1', 'push', 'faaslora_origin', 'HEAD:' + ref])
assert call(['git', '-c', 'http.version=HTTP/1.1', 'ls-remote', 'faaslora_origin', ref]).split()[0] == head
save(RAW / 'backup_completion.json', dict(passed=True, head=head, ref=ref,
     files=paths, v2_synchronized=False, protected_files=len(protected),
     remote_monitor_sha256=remote_sha))
print(json.dumps(dict(passed=True, head=head, ref=ref, files=len(paths)), indent=2))

