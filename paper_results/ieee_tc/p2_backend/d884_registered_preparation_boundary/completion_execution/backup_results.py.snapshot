"""Reuse D868's explicit-path backup for D884's closed journal analysis."""
from pathlib import Path
import hashlib

raw = Path(__file__).resolve().parent
template = raw.parent/'d868_20261026/backup_program.py.snapshot'
source = template.read_text()
source = source.replace('d868_control_cpu_and_staging', 'd884_registered_preparation_boundary')
source = source.replace("resources = read(RAW/'resources.json')", "resources = read(OUT/'resources.json')")
start = source.index("diagnosis = read(OUT/'summary.json')")
end = source.index("q = {'protected':", start)
source = source[:start] + '''diagnosis = read(OUT/'summary.json')
assert diagnosis['passed'] and diagnosis['new_gpu_replays'] == 0
assert not diagnosis['production_changed'] and not diagnosis['ranking_eligible']
assert diagnosis['n_correct'] is None
for row in diagnosis['source_refs']:
    assert p.digest(Path(row['path'])) == row['sha256'], row['path']
counts = diagnosis['counts']
assert counts['attempts'] == 4010
assert counts['registered_activation'] == 1383
assert counts['registered_activation_no_staging_at_budget_precheck'] == 1303
assert counts['registered_activation_other_staging_or_reservation_at_precheck'] == 80
assert counts['staging_commit'] == 1462 and counts['missing_receipt'] == 6
assert len(read(OUT/'transactions.json')['transactions']) == 1383 + 1462
source_shas = {
    ROOT/'faaslora/memory/gpu_monitor.py': '33b9a1ec1423ef678612b8d9c70703d152e844e24dc720600105eb0e97338f58',
    ROOT/'faaslora/memory/residency_manager.py': 'c62acac49b5f1b78c2d3e18984faa902a22f9a2aa6b5d574b1d116205fb94e6f',
    Path('/home/qhq/storage_audit_20260915/PrimeLoRA-PLAN.md'): 'd7acd08127d4f4513b23af6dd57a9647cf047570f2b563e361e716ccb0b32b83',
    ROOT/'docs/ieee_tc/METRIC_PROTOCOL_FROZEN_V1.md': '5f0732ef54d629b40cece42bdbf536e8e74c6505e3ec5d4c7e8742408ad80f22',
    ROOT/'docs/ieee_tc/METRIC_PROTOCOL_SINGLE_RUN_V2.md': '193bf1535af1aa50f83d98dc2e944ecbdc7bd27aa96baeca82f0654e02f9357d',
}
native = Path('/home/qhq/.venvs/primelora_vllm0300_tc_20260925/lib/python3.12/site-packages/vllm')
source_shas.update({
    native/'lora/model_manager.py': '6695bb7d6373d8f29bb13d6ae31e2ef2a98f8c23a6f37f9147d67cafca5f3302',
    native/'utils/cache.py': '397e993cebeeb44f37104e6f9a48ac7b4f3f878e0294fd8899e22f161de379c5',
    native/'lora/worker_manager.py': '7807187ddfd128f6a6dc31820b435dc954f2e9122d254ce7d6484b44076e3522',
})
for path, sha in source_shas.items(): assert p.digest(path) == sha, str(path)
save(OUT/'source_boundary.json', dict(
    parent_head=call(['git', 'rev-parse', 'HEAD']),
    unchanged_sources={str(path): sha for path, sha in source_shas.items()},
    candidate_implemented=False, new_gpu_replays=0,
    source_script=dict(path=str(RAW/'backup_results.py'),sha256=p.digest(RAW/'backup_results.py')),
    reused_backup_template=dict(path=str(RAW.parent/'d868_20261026/backup_program.py.snapshot'),
        sha256=p.digest(RAW.parent/'d868_20261026/backup_program.py.snapshot'))))
''' + source[end:]
source = source.replace('D868_CONTROL_CPU_AND_STAGING_20261026.md',
                        'D884_REGISTERED_PREPARATION_BOUNDARY_20261026.md')
source = source.replace("manifest['outputs']", "manifest['files']")
source = source.replace("small = ('analyze.py', 'identity.json', 'resources.json',",
                        "small = ('analyze.py', 'identity.json',")
source = source.replace('No remote service or GPU run in D868.',
                        'No remote service or GPU run in D884.')
source = source.replace("procedure_source=str(RAW.parent / 'd867_20261026/backup_program.py.snapshot')",
                        "procedure_source=str(RAW.parent / 'd868_20261026/backup_program.py.snapshot')")
source = source.replace('D868 stream analysis passed: 4000 receipts, complete accounting partitions, validated D863 CPU rows and source/output SHA. No production changes or new GPU run.',
                        'D884 streamed authoritative journal audit: 4010 attempts, unique successful leases, 2845 allocation receipts and source/output SHA. No production changes or new GPU run.')
source = source.replace('tc: preserve D868 native control CPU and live staging evidence',
                        'tc: preserve D884 registered preparation boundary and evidence-limited next candidate')
source = source.replace('refs/heads/backup/d868-control-cpu-20261026',
                        'refs/heads/backup/d884-preparation-boundary-20261026')
generated = raw/'backup_program.py.snapshot'
compile(source, str(generated), 'exec')
with generated.open('x') as stream:
    stream.write(source)
exec(compile(source, str(generated), 'exec'), globals())
