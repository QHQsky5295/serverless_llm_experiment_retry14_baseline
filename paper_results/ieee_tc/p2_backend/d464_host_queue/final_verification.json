      "content": "\"\"\"Curate existing native100 evidence without changing source result fields.\"\"\"\nimport json\nfrom collections import Counter\nfrom pathlib import Path\nimport shutil\nimport subprocess\nimport sys\nROOT=Path('/home/qhq/serverless_llm_experiment_retry14_baseline')\nRAW=Path(__file__).resolve().parent\nOUT=ROOT/'paper_results/ieee_tc/p2_backend/d464_host_queue'\nsys.path.insert(0,str(ROOT))\nfrom scripts import ieee_tc_preflight as p\ndef load(x):return json.loads(x.read_text())\ndef save(path,value):\n    with path.open('x') as f:json.dump(value,f,indent=2,allow_nan=False)\nscope=p.scope_identity(p.cg_path().name);save(RAW/'curation_identity.json',scope)\nq=load(RAW/'actual_qualification.json');assert q['passed'] and q['protocol_bound_count']==100\nassert not q['ranking_eligible'] and not q['fixed_workload_complete4000']\nfor ref in q['refs']:assert p.digest(Path(ref['path']))==ref['sha256'],ref['path']\nrun=RAW/'7b_host_queue_validation_100'\noutcome_path=run/'launch.launch/physical_deployment/main_outcome.json'\nassert outcome_path.stat().st_size<128*1024*1024\nhost=load(outcome_path)['mechanism_events']['_ieee_native_host_preparations']\nassert len(host)==63 and len(host)==q['host_preparation_records']\nreasons=dict(Counter(row['trigger_reason'] for row in host))\n# The inherited data-only helper's optional reason label read `reason` instead\n# of the actual `trigger_reason`. Preserve its original output and explicitly\n# correct only the derived breakdown; no request or mechanism record changes.\ncorrected=dict(q)\ncorrected.pop('host_preparation_sources')\ncorrected['host_preparation_trigger_reasons']=reasons\ncorrected['derivation_note']='Original optional breakdown used absent reason; corrected to recorded trigger_reason. Source records/count/qualification unchanged.'\ncorrected['original_analysis']=dict(path=str(RAW/'actual_qualification.json'),sha256=p.digest(RAW/'actual_qualification.json'))\nsave(OUT/'actual_qualification.json',corrected)\nclosures={}\nfor name in ('cpu','guard_v2','qualification','backup','collection','analysis','storage'):\n    path=RAW/(name+'_closure.json');row=load(path)\n    assert row['passed'] and row['actual_recursive_procs_empty'] and not Path(row['identity']['path']).exists()\n    closures[name]=dict(path=str(path),sha256=p.digest(path),identity=row['identity'],resources=row['resources'])\nlocal=load(RAW/'local_cleanup.json')\nfor field in ('identity','service_aux'):assert not Path(local[field]['path']).exists()\nassert not subprocess.check_output(['nvidia-smi','--query-compute-apps=pid','--format=csv,noheader'],text=True).strip()\nseal=Path('/home/qhq/serverless_llm_experiment/results/ieee_tc/slora_qualification/d435_20261011/protected_before.json')\nprotected=p.verify_seal(seal);assert protected['pass'] and protected['entry_count']==147\ncompression=ROOT/'paper_results/ieee_tc/storage/20261012_d464_d458_lossless_compression.json'\nassert load(compression)['source_archive_round_trip_verified']\nresult=dict(kind='d464_native100_final_v1',passed=True,scope=scope,qualification=corrected,\n    protected=protected,closures=closures,local_cleanup=local,remote_cleanup=load(RAW/'remote_stop.json'),\n    source_execution_sha=load(RAW/'launch_gate.json')['head'],full4000_pending=True,\n    performance_hypothesis_accepted=False,free_bytes=shutil.disk_usage(ROOT).free,\n    refs=[dict(path=str(x),sha256=p.digest(x)) for x in\n          (RAW/'actual_qualification.json',OUT/'actual_qualification.json',compression,\n           RAW/'local_cleanup.json',RAW/'remote_stop.json',RAW/'preclosure_owned_empty.json')],\n    helper_sources=[dict(path=str(x),sha256=p.digest(x),content=x.read_text()) for x in\n                    (Path(__file__),RAW/'compress_closed.py',RAW/'close_final.py')])\nsave(OUT/'final_verification.json',result)\nprint(json.dumps(dict(passed=True,bound=100,native_tokens=q['native_tokens'],host_preparations=len(host),\n    trigger_reasons=reasons,joint_count=q['common_threshold_joint_count'],free_bytes=result['free_bytes'])))\n"
