"""Back up only the verified D859 evidence; preserve the existing V2 divergence."""
import json
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
RAW = Path(__file__).resolve().parent
OUT = ROOT/'paper_results/ieee_tc/p2_backend/d859_single_lease_residual_diagnosis'
sys.path.insert(0, str(ROOT))
from scripts import ieee_tc_preflight as p

assert os.sched_getaffinity(0) == {2,3,26,27}
scope = p.scope_identity(p.cg_path().name)
with (RAW/'backup_finish_identity.json').open('x') as handle:
    json.dump(scope, handle, indent=2)
def git(*args):
    return subprocess.check_output(['git', *args], cwd=ROOT, text=True)
def save(name, value):
    with (RAW/name).open('x') as handle:
        json.dump(value, handle, indent=2)
assert git('rev-parse','HEAD').strip() == '1b2127ad9d2536ba711fd809b8bb790c3b7ba1f4'
assert len(git('diff','--cached','--name-only').splitlines()) == 16
closure = json.loads((OUT/'closure.json').read_text())
assert closure['passed']
for path, sha in closure['user_protected'].items():
    assert p.digest(Path(path)) == sha
for row in json.loads((OUT/'final_manifest.json').read_text())['files']:
    assert p.digest(Path(row['path'])) == row['sha256']
assert p.digest(Path(closure['doc']['path'])) == closure['doc']['sha256']

# The prior recovery passed docs/JSON and CRLF CSV checks. Git retains default
# blank-at-eof unless explicitly disabled; preserve the second failed attempt
# and exact snapshots, changing only that artifact-class inspection option.
snapshot = OUT/'execution/backup_finish.py.snapshot'
with snapshot.open('xb') as handle:
    handle.write(Path(__file__).read_bytes())
files = [ROOT/'docs/ieee_tc/D859_SINGLE_LEASE_RESIDUAL_DIAGNOSIS_20261026.md',
         ROOT/'docs/ieee_tc/EXECUTION_STATUS.md',
         *[path for path in sorted(OUT.rglob('*')) if path.is_file()]]
paths = [str(path.relative_to(ROOT)) for path in files]
assert len(paths) == len(set(paths)) == 17
assert all('lora_manifest_1000.json' not in path for path in paths)
assert all(not path.startswith(('figs/paper/', 'paper_results/final_v2/')) for path in paths)
branch = 'refs/heads/backup/d859-residual-diagnosis-20261026'
assert not git('ls-remote','faaslora_origin', branch).strip()
git('diff','--check')
git('add','--',*paths)
assert set(git('diff','--cached','--name-only').splitlines()) == set(paths)

csv_paths = [path for path in paths if path.endswith('.csv')]
snapshot_paths = [path for path in paths if path.endswith('.py.snapshot')]
ordinary_paths = [path for path in paths if path not in csv_paths+snapshot_paths]
assert len(csv_paths) == 2 and len(snapshot_paths) == 5
for path in csv_paths:
    data = (ROOT/path).read_bytes()
    assert data.endswith(b'\r\n') and b'\n' not in data.replace(b'\r\n', b'')
for path in snapshot_paths:
    compile((ROOT/path).read_text(),path,'exec')
git('diff','--cached','--check','--',*ordinary_paths)
git('-c','core.whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol',
    'diff','--cached','--check','--',*csv_paths)
git('-c','core.whitespace=blank-at-eol,space-before-tab,-blank-at-eof',
    'diff','--cached','--check','--',*snapshot_paths)

added = '\n'.join(line[1:] for line in git('diff','--cached','--unified=0').splitlines()
                  if line.startswith('+') and not line.startswith('+++'))
patterns = [r'-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----',
            r'\b(?:ghp_|github_pat_)[A-Za-z0-9_]{20,}', r'\bAKIA[0-9A-Z]{16}\b',
            r'(?i)(?:password|passwd|api_key|access_token)\s*[=:]\s*[\"\x27][^\"\x27\n]{8,}[\"\x27]']
assert not any(re.search(pattern, added) for pattern in patterns), 'possible staged secret: inspect locally, do not print content'
save('finish_precommit.json',dict(paths=paths,files=[dict(path=str(path),sha256=p.digest(path)) for path in files],
    checks=['closed analysis and strict count/source checks', 'script compile', 'artifact-aware diff check (original bytes preserved)',
            'explicit staging', 'protected user SHAs', 'added-text secret patterns'],
    scope=scope, backup_ref=branch, final_v2_synced=False))
git('commit','-m','tc: preserve full W2 paired residual and delivery diagnosis (D859)')
commit = git('rev-parse','HEAD').strip()
save('finish_commit.json',dict(commit=commit,backup_ref=branch,files=paths,final_v2_synced=False))
subprocess.run(['git','push','faaslora_origin','HEAD:'+branch],cwd=ROOT,check=True,timeout=120)
remote = git('ls-remote','faaslora_origin',branch).strip().split()
assert remote == [commit, branch]
assert not git('diff','--cached','--name-only').strip()
save('finish_backup.json',dict(passed=True,commit=commit,remote='faaslora_origin',ref=branch,
    remote_verified=True,final_v2_synced=False,explicit_files=len(paths),scope=scope))
print(json.dumps(dict(passed=True,commit=commit,ref=branch,files=len(paths),final_v2_synced=False)))
