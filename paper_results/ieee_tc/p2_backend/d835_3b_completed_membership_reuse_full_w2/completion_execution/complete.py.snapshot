"""Reuse D832 full-W2 accounting after D835 physical release; no replay."""
import hashlib
import json
from pathlib import Path

_raw = Path(__file__).resolve().parent
_template = _raw.parent / 'd832_20261025/completion_program.py.snapshot'
_sha = hashlib.sha256(_template.read_bytes()).hexdigest()
assert _sha == '7c8f56f3b9c40babd29bd32c875d4a05b83881a4454734d02858f3247e9537bc'
_source = _template.read_text()
_replacements = (
    ('d832_3b_owned_file_readiness_full_w2', 'd835_3b_completed_membership_reuse_full_w2'),
    ('d832_20261025', 'd835_20261025'),
    ('D832_OWNED_FILE_READINESS_FULL_W2_20261025.md',
     'D835_COMPLETED_MEMBERSHIP_REUSE_FULL_W2_20261025.md'),
    ('d832_single_w2_frozen_resource_reference_observation_v1',
     'd835_single_w2_frozen_resource_reference_observation_v1'),
    ('d831_owned_file_readiness/closure.json', 'd834_completed_membership_reuse/closure.json'),
)
for _old, _new in _replacements:
    assert _old in _source, _old
    _source = _source.replace(_old, _new)
compile(_source, str(_raw / 'completion_program.py.snapshot'), 'exec')
with (_raw / 'completion_template.json').open('x') as _stream:
    json.dump(dict(source=str(_template), sha256=_sha, replacements=_replacements,
        changes='Run/output/qualification identities only; frozen full-W2 metrics, stages, profile, resource reference and protection checks unchanged. Actual delivery/owner/settlement and new membership counters remain separate audits.'),
        _stream, indent=2)
    _stream.write('\n')
with (_raw / 'completion_program.py.snapshot').open('x') as _stream:
    _stream.write(_source)
exec(compile(_source, str(_raw / 'completion_program.py.snapshot'), 'exec'), globals())
