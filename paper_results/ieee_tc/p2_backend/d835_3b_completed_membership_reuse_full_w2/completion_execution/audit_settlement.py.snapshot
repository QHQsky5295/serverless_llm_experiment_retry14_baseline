"""Apply the existing D832 settlement audit unchanged to the D835 run."""
import hashlib
import json
from pathlib import Path

_raw = Path(__file__).resolve().parent
_template = _raw.parent / 'd832_20261025/audit_settlement.py'
_sha = hashlib.sha256(_template.read_bytes()).hexdigest()
assert _sha == '06d04f8be10e5d6e8b3d59a931bd6e98a956d8bc4e1a155702cb3d5592be8ea0'
_source = _template.read_text()
_replacements = (
    ('d832_3b_owned_file_readiness_full_w2', 'd835_3b_completed_membership_reuse_full_w2'),
    ('d832_actual_owned_file_settlement_v1', 'd835_actual_owned_file_settlement_v1'),
    ('no failures/cancellations claimed in D832', 'no failures/cancellations claimed in D835'),
)
for _old, _new in _replacements:
    assert _old in _source, _old
    _source = _source.replace(_old, _new)
compile(_source, str(_raw / 'settlement_program.py.snapshot'), 'exec')
with (_raw / 'settlement_template.json').open('x') as _stream:
    json.dump(dict(source=str(_template), sha256=_sha, replacements=_replacements,
        changes='Output/run identities only; exact job/intent joins, actual pressure settlement, native token timing and overlap accounting unchanged.'), _stream, indent=2)
    _stream.write('\n')
with (_raw / 'settlement_program.py.snapshot').open('x') as _stream:
    _stream.write(_source)
exec(compile(_source, str(_raw / 'settlement_program.py.snapshot'), 'exec'), globals())
