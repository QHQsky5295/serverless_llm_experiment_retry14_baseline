"""Reuse the D846 explicit-file backup for the completed D858 observation."""
import hashlib
from pathlib import Path

_raw = Path(__file__).resolve().parent
_template = _raw.parent/'d846_20261025/backup_program.py.snapshot'
assert hashlib.sha256(_template.read_bytes()).hexdigest() == '1d4bd97aa0833c68824b6d1e4aaa18091d0d4bd11706369d686101964aedaee3'
_source = _template.read_text()
_replacements = (
    ('d846_3b_staging_identity_full_w2', 'd858_3b_single_lease_full_w2'),
    ('D846_STAGING_IDENTITY_FULL_W2_20261025.md', 'D858_SINGLE_LEASE_FULL_W2_20261026.md'),
    ('prelaunch/qualification.json', 'prelaunch_resume/qualification.json'),
    ("('start_identity.json', 'completion_identity.json', 'context_identity.json', 'settlement_resume_identity.json'):",
     "('start_identity.json', 'start_resume_identity.json', 'completion_identity.json', 'context_identity.json', 'settlement_resume_identity.json'):"),
    ("         'completion_program.py.snapshot', 'context_program.py.snapshot',",
     "         'context_program.py.snapshot',"),
    ("         'completion_template.json', 'delivery_template_reuse.json',",
     "         'completion_launcher_error.txt', 'delivery_template_reuse.json',"),
    ("target = evidence / (name + '.snapshot' if name.endswith('.py') else name)",
     "target = evidence / (name + '.snapshot' if name.endswith('.py') else name + '.txt' if name.endswith('.log') else name)"),
    ('1cd8fee097c86d8bc84081209ae082a2cc7e57190e018c6a83051a9114874e22',
     'be9b56b0fc063e977c5b9fd653fff25b5a884e7be1efd31b680e2fea794a9fea'),
    ('Reuse D845 67 targeted CPU checks and D846 23 run-contract checks. Complete 4000-request metrics/stages, delivery, native-owner and settlement audits passed; no new production change or replay during closure.',
     'Reuse D857 86 targeted CPU checks and D858 4 run-contract checks. Complete 4000-request metrics/stages, delivery, native-owner and settlement audits passed. Preserve the offline UUID-scope naming error; no production change or GPU replay during closure.'),
    ('tc: preserve D846 full W2 staging identity trade-off and delivery evidence',
     'tc: preserve D858 full W2 single-lease gains and remaining SLO gap'),
    ('backup/d846-complete-20261025', 'backup/d858-complete-20261026'),
)
for _old, _new in _replacements:
    assert _old in _source, _old
    _source = _source.replace(_old, _new)
compile(_source, str(_raw/'backup_program.py.snapshot'), 'exec')
with (_raw/'backup_program.py.snapshot').open('x') as _stream:
    _stream.write(_source)
exec(compile(_source, str(_raw/'backup_program.py.snapshot'), 'exec'), globals())
