"""Reuse D818/D594 pressure joins for D829, preserving their timing semantics."""
import hashlib
import json
from pathlib import Path

raw = Path(__file__).resolve().parent
template = raw.parent / 'd818_20261025/pressure.py'
assert hashlib.sha256(template.read_bytes()).hexdigest() == '6720d21fdfc515f6b5d1211f4788119d17228dbe2bd4a2a3b380bd8335ceb84a'
source = template.read_text()
for old, new in (
    ('d818_3b_remote_preparation', 'd829_3b_admitted_owner_anchor_full_w2/preparation_analysis'),
    ('d817_20261025', 'd829_20261025'),
    ("RAW/'resume_identity.json'", "RAW/'preparation_identity.json'"),
):
    assert old in source, old
    source = source.replace(old, new)
with (raw / 'pressure_template.json').open('x') as stream:
    json.dump(dict(path=str(template), sha256=hashlib.sha256(template.read_bytes()).hexdigest(),
                   changes='Run/output/preceding-scope identities only. No presumed post-preparation snapshot timing; owner anchor is historical.'), stream, indent=2)
with (raw / 'pressure_program.py.snapshot').open('x') as stream:
    stream.write(source)
exec(compile(source, str(template), 'exec'), globals())
