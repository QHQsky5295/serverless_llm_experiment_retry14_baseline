"""Reuse D847 explicit-file backup; no user changes or final-V2 force push."""
from pathlib import Path

RAW = Path(__file__).resolve().parent
source = (RAW.parent/'d847_20261025/backup_executed.py.snapshot').read_text()
for old,new in (
    ('d847_3b_scaling_feedback','d849_current_remote_preparation'),
    ('D847_STARTUP_FEEDBACK_AND_CURRENT_VIOLATIONS_20261025.md','D849_CURRENT_REMOTE_PREPARATION_20261025.md'),
    ('435f9a1b2c5cda16e1a432728f0779727ffa4980','720e9419d1bda55b7fc5ccdc84b886279df60634'),
    ('backup/d847-startup-feedback-20261025','backup/d849-current-preparation-20261025'),
    ('tc: preserve D847 startup feedback and physical holding diagnosis','tc: preserve D849 current preparation and compressed-source identity'),
    ("ROOT/'docs/ieee_tc/EXECUTION_STATUS.md',", "ROOT/'docs/ieee_tc/EXECUTION_STATUS.md',\n         ROOT/'scripts/ieee_tc/audit_d703_3b_full.py',\n         ROOT/'tests/test_ieee_tc_diagnostic_plot.py',"),
):
    assert old in source,old
    source = source.replace(old,new)
with (RAW/'backup_executed.py.snapshot').open('x') as stream:
    stream.write(source)
exec(compile(source,str(RAW/'backup_executed.py.snapshot'),'exec'),globals())
