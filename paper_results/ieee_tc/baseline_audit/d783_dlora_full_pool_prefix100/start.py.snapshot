"""Reuse actual D781 launch; bind only the qualified D782 CPU representation."""
import hashlib
from pathlib import Path
original=Path('/home/qhq/serverless_llm_experiment/results/ieee_tc/dlora_qualification/d781_20261024/start.py')
data=original.read_bytes()
assert hashlib.sha256(data).hexdigest()=='031635552050b647225bf22c491d5df1ed0d09973293bd68b68a8779dca2b2b8'
source=data.decode().replace('D781','D783').replace('d781','d783')
changes={
    "PRIOR = RAW.parent/'d778_20261024'":"PRIOR = RAW.parent/'d782_20261024'",
    "BACKUP = RAW.parent/'d780_20261024'":"BACKUP = RAW.parent/'d782_20261024'",
    "for name in ('backup','maintenance','start','qualification','qualification2'):":
        "for name in ('backup','backup_recovery','qualification','probe'):",
    "startup=read(BACKUP/'qualification2.json')":
        "startup=read(RAW.parent/'d780_20261024/qualification2.json')",
    "binding['refs'] | startup['refs']":"startup['refs'] | binding['refs']",
    "startup_qualification_sha256=p.digest(BACKUP/'qualification2.json')":
        "startup_qualification_sha256=p.digest(RAW.parent/'d780_20261024/qualification2.json')",
    "assert binding['passed'] and binding['source_view']['worker_lifecycle']":
        "assert binding['passed'] and binding['source_view']['worker_lifecycle']\n"
        "assert binding['source_view']['cpu_lora_representation'] == 'attention_only_cpu_mlp_zero_views_v1'\n"
        "assert read(PRIOR/'result_receipt.json')['native_tensor_copy_validated']\n"
        "assert read(RAW/'native_3b.json')['source_view_manifest_sha256'] == p.digest(PRIOR/'source_view/measurement_manifest.json')",
}
for old,new in changes.items():
    assert source.count(old)==1,old
    source=source.replace(old,new)
exec(compile(source,str(original),'exec'),{'__name__':'__main__','__file__':str(Path(__file__))})
