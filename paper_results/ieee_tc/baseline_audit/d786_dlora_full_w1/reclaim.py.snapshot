"""Reclaim verified duplicates after a complete failed run; preserve all evidence."""
import hashlib
from pathlib import Path

original = Path('/home/qhq/serverless_llm_experiment/results/ieee_tc/dlora_qualification/d783_20261024/reclaim.py')
data = original.read_bytes()
assert hashlib.sha256(data).hexdigest() == '7476bee26075e92cf526be97089b833a6214836a0f062eeda51809409f7b23d1'
source = data.decode().replace('D783', 'D786').replace('d783', 'd786')
source = source.replace('analysis3_', 'analysis_').replace('audit_prefix100.json', 'audit_full4000_w1.json')
source = source.replace('http_3b_100.json', 'http_3b_4000.json')
before = "assert audit['workload_passed'] and audit['native_revalidated_requests']==100"
assert source.count(before) == 2
after = ("assert audit['measurement_complete'] and not audit['workload_passed'] "
         "and audit['outcome_contract']=='complete_with_failures' "
         "and audit['counts']['N_plan']==audit['counts']['N_terminal']==4000 "
         "and audit['counts']['N_failed']==622 "
         "and audit['native_revalidated_requests']==audit['counts']['N_response']==3378")
source = source.replace(before, after)
# The historical cleanup recipe assumed success. A failed but actually released
# service is equally safe to reclaim; content, retained originals, references,
# metadata preservation, mounts, links and actual GPU-release checks remain.
before = 'for before,after in changes.items():'
assert source.count(before) == 1
source = source.replace(before,
    'changes["and launch[\'service_returncode\'] == 0"] = "and type(launch[\'service_returncode\']) is int"\n' + before)
exec(compile(source, str(original), 'exec'), {'__name__': '__main__', '__file__': str(Path(__file__))})
