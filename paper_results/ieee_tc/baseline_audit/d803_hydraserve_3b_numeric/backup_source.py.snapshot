"""Back up the six CPU-tested HydraServe files after D802's result checkpoint.

Reuse explicit-path publication checks; no model execution or environment edit.
The completed Loquetier run retains its original baseline commit identity.
"""
import ast
import hashlib
from pathlib import Path

original = Path('/home/qhq/serverless_llm_experiment/results/ieee_tc/serverless_qualification/d764_20261023/publish_result.py')
data = original.read_bytes()
assert hashlib.sha256(data).hexdigest() == '1852265b403fa717ec44014d031950f34317b9f7bce1d7b8a02a22fa2a9448c4'
recipe = data.decode()
exec(compile(recipe[:recipe.index('own=p.scope_identity')], str(original), 'exec'), globals())
prior = RAW.parent.parent/'loquetier_qualification/d796_20261024/backup.py'
assert p.digest(prior) == '2d6159d567e2077d40aa4ecce0a911fccc1de0a5cbd566158db9570e65d00ae0'
tree = ast.parse(prior.read_bytes())
nodes = [n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name in ('checked', 'commit')
         or isinstance(n, ast.Assign) and any(isinstance(t, ast.Name) and t.id == 'secret' for t in n.targets)]
assert len(nodes) == 3
exec(compile(ast.Module(body=nodes, type_ignores=[]), str(prior), 'exec'), globals())

own = p.scope_identity(p.cg_path().name)
save(RAW/'backup_identity.json', own)
assert os.sched_getaffinity(0) == {2, 3, 26, 27}
for name, value in (('memory.high', 3*p.GIB), ('memory.max', 4*p.GIB), ('memory.swap.max', 0)):
    assert (Path(own['path'])/name).read_text().strip() == str(value)
assert not call(MAIN, 'nvidia-smi', '--query-compute-apps=pid', '--format=csv,noheader')
done = RAW.parent.parent/'loquetier_qualification/d802_20261024'
result = read(done/'result_receipt.json')
assert result['passed'] and result['head'] == '2e03240376d093884ff1ba7ef396e7f8ad2e9f0a'
assert read(done/'result_closure.json')['path_gone']
assert call(MAIN, 'git', 'rev-parse', 'HEAD') == result['head']
assert call(MAIN, 'git', 'ls-remote', 'faaslora_origin', result['remote_ref']).split()[0] == result['head']
preserved = read(done/'preparation.json')['preserved']
for path, digest in preserved.items():
    assert p.digest(Path(path)) == digest, path
test_path = MAIN/'paper_results/ieee_tc/baseline_audit/hydraserve_3b_probe_preparation_20261024/receipt.json'
tests = read(test_path)
assert tests['returncode'] == 0 and tests['test_count'] == 31
assert len(tests['files_sha256']) == 6
paths = [BASE/name for name in tests['files_sha256']]
for path in paths:
    assert p.digest(path) == tests['files_sha256'][str(path.relative_to(BASE))], path
assert call(BASE, 'git', 'rev-parse', 'HEAD') == '8594922093ee4625dcc6614ecc11746af277219d'
assert call(BASE, 'git', 'ls-remote', 'origin', 'refs/heads/main').split()[0] == '8594922093ee4625dcc6614ecc11746af277219d'
head = commit(BASE, paths, 'tc: adapt native HydraServe to tied Llama3 models with bounded numerical probe',
              'origin', 'refs/heads/main')
for path, digest in preserved.items():
    assert p.digest(Path(path)) == digest, path
save(RAW/'backup_receipt.json', dict(passed=True, baseline_head=head, remote_ref='refs/heads/main',
    main_result_head=result['head'], source_files_sha256=tests['files_sha256'],
    test_receipt=str(test_path), test_receipt_sha256=p.digest(test_path),
    tests_reused_unchanged=31, gpu_run_executed=False, performance_qualified=False,
    other_project_k3s_changed=False, force_push=False, new_weights_or_trace=False,
    preserved_unchanged=len(preserved), resources=p.cgroup_snapshot(Path(own['path']))))
print(json.dumps(dict(passed=True, baseline_head=head, gpu_run_executed=False, files=len(paths))))
