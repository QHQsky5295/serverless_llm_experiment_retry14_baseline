"""Reuse explicit-path checkpoint helpers for the bounded HydraServe observation."""
import ast
import hashlib
from pathlib import Path

original = Path('/home/qhq/serverless_llm_experiment/results/ieee_tc/serverless_qualification/d764_20261023/publish_result.py')
data = original.read_bytes()
assert hashlib.sha256(data).hexdigest() == '1852265b403fa717ec44014d031950f34317b9f7bce1d7b8a02a22fa2a9448c4'
recipe = data.decode()
exec(compile(recipe[:recipe.index('own=p.scope_identity')], str(original), 'exec'), globals())
prior = RAW.parent.parent/'loquetier_qualification/d796_20261024/backup.py'
assert p.digest(prior) == '2d6159d567e2077d40aa4ecce0a911fccc1de0a5cbd566158db9570e65d00ae0'
tree = ast.parse(prior.read_bytes())
nodes = [n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name in ('checked', 'commit')
    or isinstance(n, ast.Assign) and any(isinstance(t, ast.Name) and t.id == 'secret' for t in n.targets)]
assert len(nodes) == 3
exec(compile(ast.Module(body=nodes, type_ignores=[]), str(prior), 'exec'), globals())
own = p.scope_identity(p.cg_path().name)
save(RAW/'result_identity.json', own)
assert os.sched_getaffinity(0) == {2,3,26,27}
assert not call(MAIN, 'nvidia-smi', '--query-compute-apps=pid', '--format=csv,noheader')
for name in ('qualification', 'probe', 'backup'):
    closed = read(RAW/(name+'_closure.json'))
    assert closed['passed'] and closed['path_gone'] and not Path(closed['identity']['path']).exists()
launch, numeric, q = (read(RAW/name) for name in ('probe_launch.json', 'native_probe.json', 'qualification.json'))
assert launch['service_returncode'] == launch['watchdog_returncode'] == 0
assert launch['native_gpu_context_release_confirmed'] and launch['service_path_removed']
assert numeric['passed'] and len(numeric['checks']) == 6
assert numeric['tied_head_shared_after_native_load_and_lora_binding']
assert not numeric['pipeline_consolidation_qualified']
assert not numeric['provider_shared_memory_qualified']
assert not numeric['full_workload_numerical_correctness_proven']
for path, digest in (q['refs'] | q['preserved']).items():
    assert p.digest(Path(path)) == digest, path
assert call(BASE, 'git', 'rev-parse', 'HEAD') == '05be2d8a3c2120cf20754af3159781d38d42d639'
assert call(BASE, 'git', 'ls-remote', 'origin', 'refs/heads/main').split()[0] == '05be2d8a3c2120cf20754af3159781d38d42d639'
runner = BASE/'HydraServe_project/scripts/probe_layer_identity.py'
test = BASE/'tests/test_ieee_tc_hydraserve_layer_identity.py'
assert p.digest(runner) == 'a4e6640e7b285f626acc924267a73069256876a6e8da0dfe3ec2887db3bfa4c9'
assert p.digest(test) == 'c3eeb51ae633803ed0f0f8cb23b40b64ad18db0d5f6638648f5a74b66735c0ba'
save(RAW/'test_receipt.json', dict(passed=True, tests=32, elapsed_seconds=.942,
    command='taskset -c 2 env PYTHONDONTWRITEBYTECODE=1 python3 -m unittest tests.test_ieee_tc_hydraserve_llama_model_compat tests.test_ieee_tc_hydraserve_native_delivery tests.test_ieee_tc_hydraserve_layer_identity -q',
    execution='completed exec session 60302, exit0; no Torch/GPU in these CPU tests',
    files_sha256={str(path):p.digest(path) for path in (runner,test)},
    change='reuse existing explicit-file guard loader in preparation/native/reference paths'))
basehead = commit(BASE, [runner,test], 'tc: resolve HydraServe numeric guard by explicit source path',
                  'origin', 'refs/heads/main')
save(RAW/'baseline_result_receipt.json', dict(passed=True, baseline_head=basehead,
    remote_ref='refs/heads/main', force_push=False, executed_head=q['source_heads']['baseline'],
    executed_runner_sha256=p.digest(runner)))
OUT = MAIN/'paper_results/ieee_tc/baseline_audit/d803_hydraserve_3b_numeric'
OUT.mkdir(parents=True, exist_ok=False)
sources = [RAW/name for name in ('prepare.py','prepare_import_failure.py',
    'prepare_import_failure_closure.json','close_failed_prepare.py','run_probe.py','close.py',
    'backup_source.py','backup_receipt.json','backup_closure.json','qualification.json',
    'qualification_resource_gate.json','qualification_closure.json','probe_launch.json','probe_closure.json',
    'native_probe.json','native_probe.reference.json','native_probe.reference_input.json',
    'native_probe.reference.log','test_receipt.json','baseline_result_receipt.json',
    'publish_result.py','close_result.py')]
sources += [RAW/'probe_launch.launch/service.log',RAW/'probe_launch.launch/exec_receipt.json',
            RAW/'overlays/manifest.json',RAW/'metadata/partition.json']
checked(sources)
mapping = copy_sources(OUT, sources)
save(OUT/'checkpoint_manifest.json',dict(schema='ieee_tc_hydraserve_3b_numeric_checkpoint_v1',
    passed=True, files=mapping, plan_sha256=p.check_plan(), baseline_head=basehead,
    executed_heads=q['source_heads'], numerical_checks=6, numerical_passed=6,
    gpu_probes=1, performance_runs=0, new_weights_or_trace=False, other_project_k3s_changed=False,
    provider_shared_memory_qualified=False,pipeline_consolidation_qualified=False,
    full_workload_numerical_correctness_proven=False, preserved_unchanged=len(q['preserved']),
    raw_sources={str(path):p.digest(path) for path in
        (RAW/'native_probe.native_logits.npy', RAW/'probe_launch.launch/watchdog.jsonl')},
    next='affected native provider/shared-memory and pipeline checks; then HydraServe 3B full scenarios'))
assert call(MAIN,'git','rev-parse','HEAD') == '2e03240376d093884ff1ba7ef396e7f8ad2e9f0a'
paths = [MAIN/'docs/ieee_tc/EXECUTION_STATUS.md',
    MAIN/'docs/ieee_tc/HYDRASERVE_3B_MODEL_COMPATIBILITY_AUDIT_20261024.md',
    MAIN/'docs/ieee_tc/D803_HYDRASERVE_3B_MODEL_NUMERICS_20261024.md',*sorted(OUT.iterdir())]
ref = 'refs/heads/backup/d803-hydraserve-3b-numeric-20261024'
head = commit(MAIN, paths, 'tc: preserve HydraServe 3B native numerical qualification (D803)',
              'faaslora_origin', ref)
for path, digest in q['preserved'].items():
    assert p.digest(Path(path)) == digest, path
save(RAW/'result_receipt.json', dict(passed=True, head=head, baseline_head=basehead,
    remote_ref=ref, force_push=False, v2_synchronized=False,
    resources=p.cgroup_snapshot(Path(own['path']))))
print(json.dumps(dict(passed=True, head=head, baseline_head=basehead, remote_ref=ref)))
