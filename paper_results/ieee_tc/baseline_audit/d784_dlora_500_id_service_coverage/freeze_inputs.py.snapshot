"""Reuse D769's approved 500-ID view; only the native service identity differs."""
import hashlib
from pathlib import Path

original = Path('/home/qhq/serverless_llm_experiment/results/ieee_tc/slora_qualification/d769_20261023/freeze_inputs.py')
data = original.read_bytes()
assert hashlib.sha256(data).hexdigest() == 'edde253ec61b56d245a585fe20bced6520d7cc577b0b24b202667f9c80cc570e'
source = data.decode().replace('verify_slora_source_view', 'verify_dlora_source_view').replace('S-LoRA', 'dLoRA')
