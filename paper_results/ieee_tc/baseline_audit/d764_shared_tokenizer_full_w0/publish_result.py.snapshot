"""Explicit-path D764 W0 result checkpoint and next unchanged W1 binding."""
import json
import os
from pathlib import Path
import re
import subprocess
import sys

MAIN=Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
BASE=Path('/home/qhq/serverless_llm_baselines')
RAW=Path(__file__).resolve().parent
NEXT=RAW.parent/'d765_20261023'
OUT=MAIN/'paper_results/ieee_tc/baseline_audit/d764_shared_tokenizer_full_w0'
NEXT_OUT=MAIN/'paper_results/ieee_tc/baseline_audit/d765_shared_tokenizer_w1_binding'
sys.path.insert(0,str(MAIN))
from scripts import ieee_tc_preflight as p
def read(path): return json.loads(path.read_text())
def save(path,value):
    with path.open('x') as handle:
        json.dump(value,handle,indent=2,allow_nan=False)
        handle.write('\n')
def call(repo,*args):
    return subprocess.check_output(args,cwd=repo,text=True,stderr=subprocess.STDOUT).strip()
def copy_sources(target,sources):
    mapping={}
    for source in sources:
        name=source.name+('.snapshot' if source.suffix in ('.py','.sh','.log') else '')
        with (target/name).open('xb') as stream: stream.write(source.read_bytes())
        assert p.digest(target/name)==p.digest(source)
        mapping[name]=dict(source=str(source),sha256=p.digest(source))
    return mapping

own=p.scope_identity(p.cg_path().name)
save(RAW/'result_publication_identity.json',own)
assert os.sched_getaffinity(0)=={2,3,26,27}
assert not call(MAIN,'nvidia-smi','--query-compute-apps=pid','--format=csv,noheader')
assert read(RAW/'result_receipt.json')['passed'] and read(RAW/'reclamation.json')['passed']
for folder,names in ((RAW,('result','contract','storage')),(NEXT,('qualification',))):
    for name in names:
        row=read(folder/(name+'_closure.json'))
        assert row['path_gone'] and not Path(row['identity']['path']).exists()
q=read(NEXT/'qualification.json')
for name,digest in (q['refs']|q['protected']|q['preserved']).items():
    assert p.digest(Path(name))==digest,name
for name,row in read(OUT/'manifest.json')['files'].items():
    assert p.digest(OUT/name)==row['sha256'],name
assert call(MAIN,'git','rev-parse','HEAD')=='95a4d703a74531f6271171149d9c1006bb04485e'
basehead=call(BASE,'git','rev-parse','HEAD')
assert basehead=='c9b3c9f7a02c1a118db089708697af3c76d47a5c'
assert call(BASE,'git','ls-remote','origin','refs/heads/main').split()[0]==basehead
extra=copy_sources(OUT,[RAW/name for name in ('result_receipt.json','result_closure.json',
    'reclaim.py','reclamation.json','cache_cleanup_before.json','cache_cleanup_after.json',
    'contract_closure.json','storage.py','close_storage.py','storage_closure.json','publish_result.py')])
save(OUT/'checkpoint_manifest.json',dict(passed=True,files=extra,baseline_head=basehead,
    protected_unchanged=len(q['protected']),plan_sha256=p.check_plan()))
NEXT_OUT.mkdir(parents=True,exist_ok=False)
nextmap=copy_sources(NEXT_OUT,[NEXT/name for name in ('prepare.py','qualification.json',
    'qualification_closure.json','http_3b_4000.json','run3b_repaired.sh','start.py','run_analysis.py')]
    +[NEXT/'source_repaired/measurement_manifest.json'])
save(NEXT_OUT/'manifest.json',dict(passed=True,files=nextmap,qualification_reused_from='D764',
    requests=4000,workload='W1',actual_unique_adapters=132,target_tokens=458224,performance_run_started=False,
    no_new_trace_or_weights=True,independent_numerical_correctness_proven=False))
storage=MAIN/'paper_results/ieee_tc/storage'
storage_paths=[storage/name for name in ('20261023_d764_closed_d752_outcome.json',
    '20261023_d764_closed_d752_outcome_verification.json',
    '20261023_d764_closed_d752_outcome.py.snapshot')]
for path in storage_paths:
    assert path.is_file()
paths=[MAIN/'docs/ieee_tc/EXECUTION_STATUS.md',
    MAIN/'docs/ieee_tc/D764_SHARED_TOKENIZER_FULL_W0_20261023.md',
    *sorted(OUT.iterdir()),*sorted(NEXT_OUT.iterdir()),*storage_paths]
relative=[str(path.relative_to(MAIN)) for path in paths]
assert len(relative)==len(set(relative)) and not call(MAIN,'git','diff','--cached','--name-only')
secret=re.compile(r'-----BEGIN (?:OPENSSH |RSA |EC )?PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]+|(?im:^[ \t]*(?:password|passwd|secret|api_key|PRIME_REMOTE_TOKEN)[ \t]*=[ \t]*[\x22\x27]?[A-Za-z0-9+/]{8,})')
for path in paths:
    assert path.is_file() and path.stat().st_size<2*1024*1024,path
    assert not secret.search(path.read_text()),path
call(MAIN,'git','add','--',*relative)
assert set(call(MAIN,'git','diff','--cached','--name-only').splitlines())==set(relative)
call(MAIN,'git','-c','core.whitespace=blank-at-eol,space-before-tab,-blank-at-eof,cr-at-eol','diff','--cached','--check')
call(MAIN,'git','commit','-m','tc: seal ServerlessLLM 3B W0 and bind unchanged W1 (D764-D765)')
head=call(MAIN,'git','rev-parse','HEAD')
ref='refs/heads/backup/d764-complete-w0-20261023'
call(MAIN,'git','-c','http.version=HTTP/1.1','push','faaslora_origin','HEAD:'+ref)
assert call(MAIN,'git','ls-remote','faaslora_origin',ref).split()[0]==head
save(RAW/'result_publication_receipt.json',dict(passed=True,head=head,remote_ref=ref,
    baseline_head=basehead,force_push=False,v2_synchronized=False,paths=relative,
    protected_unchanged=len(q['protected']),resources=p.cgroup_snapshot(Path(own['path']))))
print(json.dumps(dict(passed=True,head=head,remote_ref=ref,baseline_head=basehead,paths=len(relative))))
