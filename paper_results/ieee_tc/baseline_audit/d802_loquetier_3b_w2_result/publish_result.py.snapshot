"""Reuse explicit-path result publication for the complete D802 W2 observation.

Prepared while the run is live; execute only after actual terminal, GPU release,
analysis and duplicate-cache reclamation. Never changes execution identities.
"""
import hashlib
from pathlib import Path

original = Path('/home/qhq/serverless_llm_experiment/results/ieee_tc/loquetier_qualification/d799_20261024/publish_result.py')
data = original.read_bytes()
assert hashlib.sha256(data).hexdigest() == '13866fcfdb80fe5d7222f3c3d3c6c4d68f63ead4cb66084bb7af050f006a6953'
source = data.decode()
changes = {
    'completed coverage evidence': 'completed W2 evidence',
    "'audit_coverage500.json'": "'audit_full4000.json'",
    "audit['native_revalidated_requests'] == 500": "audit['native_revalidated_requests'] == 4000",
    "audit['served_adapter_ids'] == audit['deployment_prepared_adapters'] == 500":
        "audit['served_adapter_ids'] == 497 and audit['deployment_prepared_adapters'] == 500",
    '482ff4d378ffc8358764b34834ab9c0017e8071f': '2b14036a7dfa74fc3c7e91fcd3ca257ea027d7a4',
    'd799_loquetier_3b_coverage': 'd802_loquetier_3b_w2_result',
    "'analysis_config_alias.json',": '',
    'http_3b_coverage500.json': 'http_3b_4000.json',
    'ieee_tc_loquetier_full500_coverage_v1': 'ieee_tc_loquetier_full4000_w2_result_v1',
    'adapter_pool_functional_coverage': 'native_3b_full_w2_development_observation',
    'independent_full_pool_numerical_correctness_proven': 'independent_full_workload_numerical_correctness_proven',
    'unchanged Loquetier 3B W0/W1/W2, then isolated HydraServe 3B and full comparison':
        'isolated HydraServe 3B, then full baseline comparison and evidence-led PrimeLoRA optimization',
    "MAIN/'docs/ieee_tc/D799_LOQUETIER_3B_COVERAGE_RESULT_20261024.md',*sorted(OUT.iterdir())":
        "MAIN/'docs/ieee_tc/D802_LOQUETIER_3B_W2_RESULT_20261024.md', "
        "MAIN/'docs/ieee_tc/HYDRASERVE_3B_MODEL_COMPATIBILITY_AUDIT_20261024.md', "
        "MAIN/'paper_results/ieee_tc/baseline_audit/hydraserve_3b_model_compat_cpu_20261024/receipt.json', "
        "MAIN/'paper_results/ieee_tc/baseline_audit/hydraserve_3b_probe_preparation_20261024/receipt.json', "
        "*sorted(OUT.iterdir())",
    'backup/d799-loquetier-3b-coverage-20261024': 'backup/d802-loquetier-3b-w2-result-20261024',
    'tc: seal Loquetier 3B complete500 coverage evidence (D799)':
        'tc: seal Loquetier 3B W2 and record isolated HydraServe preparation (D802)',
}
for before, after in changes.items():
    expected = 2 if before == "'audit_coverage500.json'" else 1
    assert source.count(before) == expected, (before, source.count(before))
    source = source.replace(before, after)
exec(compile(source, str(original), 'exec'), {'__name__': '__main__', '__file__': str(Path(__file__))})
