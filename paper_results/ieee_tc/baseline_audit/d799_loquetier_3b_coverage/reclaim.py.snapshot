"""Reuse audited duplicate-only reclamation after full500 coverage and release."""
import hashlib
from pathlib import Path
original = Path('/home/qhq/serverless_llm_experiment/results/ieee_tc/dlora_qualification/d783_20261024/reclaim.py')
data = original.read_bytes()
assert hashlib.sha256(data).hexdigest() == '7476bee26075e92cf526be97089b833a6214836a0f062eeda51809409f7b23d1'
source = data.decode().replace('D783','D799').replace('d783','d799')
source = source.replace('tc-d799-3bd','tc-d799-3bl').replace('analysis3_','analysis_')
source = source.replace('audit_prefix100.json','audit_coverage500.json').replace('http_3b_100.json','http_3b_500.json')
source = source.replace("q=read(RAW.parent/'d782_20261024/qualification.json')", "q=read(RAW/'preparation.json')")
assert source.count("audit['native_revalidated_requests']==100") == 2
source = source.replace("audit['native_revalidated_requests']==100", "audit['native_revalidated_requests']==500")
exec(compile(source,str(original),'exec'), {'__name__':'__main__','__file__':str(Path(__file__))})
