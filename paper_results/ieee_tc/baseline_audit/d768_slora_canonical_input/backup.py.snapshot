"""Reuse explicit-path publication checks, separate source/evidence repositories."""
import hashlib
from pathlib import Path

original = Path('/home/qhq/serverless_llm_experiment/results/ieee_tc/serverless_qualification/d764_20261023/publish_result.py')
data = original.read_bytes()
assert hashlib.sha256(data).hexdigest() == '1852265b403fa717ec44014d031950f34317b9f7bce1d7b8a02a22fa2a9448c4'
recipe = data.decode()
prefix = recipe[:recipe.index('own=p.scope_identity')]
suffix = recipe[recipe.index('relative=[str(path.relative_to(MAIN))'):]
file_checks = suffix[suffix.index('secret=re.compile'):suffix.index("call(MAIN,'git','add'")]
body = '''own=p.scope_identity(p.cg_path().name)
save(RAW/'backup_identity.json',own)
assert os.sched_getaffinity(0)=={2,3,26,27}
assert not call(MAIN,'nvidia-smi','--query-compute-apps=pid','--format=csv,noheader')
q=read(RAW/'qualification.json')
assert q['passed'] and q['cpu_tests']==57
for name in ('qualification_01','qualification_02'):
    closed=read(RAW/(name+'_closure.json'))
    assert closed['path_gone'] and not Path(closed['identity']['path']).exists()
for name,digest in (q['refs']|q['protected']|q['preserved']).items():
    assert p.digest(Path(name))==digest,name
assert call(MAIN,'git','rev-parse','HEAD')=='4b2fc47e280a3354bb1877f98caed09c7903bf2e'
oldbase='08a69516e072d774ee77ee5d37df6a487871dee1'
assert call(BASE,'git','rev-parse','HEAD')==oldbase
assert call(BASE,'git','ls-remote','origin','refs/heads/main').split()[0]==oldbase
paths=[BASE/'scripts/replay_vllm_engine_trace.py',BASE/'scripts/prepare_ieee_tc_serverless_stack.py',
    BASE/'scripts/ieee_tc_serverless_measurement.py',BASE/'tests/test_ieee_tc_slora_service.py',
    BASE/'tests/test_ieee_tc_slora_measurement.py',BASE/'docs/ieee_tc/D768_SLORA_CANONICAL_INPUT_BOUNDARY.md']
assert not call(BASE,'git','diff','--cached','--name-only')
'''+file_checks+'''
relative=[str(path.relative_to(BASE)) for path in paths]
call(BASE,'git','add','--',*relative)
assert set(call(BASE,'git','diff','--cached','--name-only').splitlines())==set(relative)
call(BASE,'git','diff','--cached','--check')
call(BASE,'git','commit','-m','tc: bind explicit canonical S-LoRA input IDs (D768)')
basehead=call(BASE,'git','rev-parse','HEAD')
call(BASE,'git','-c','http.version=HTTP/1.1','push','origin','HEAD:refs/heads/main')
assert call(BASE,'git','ls-remote','origin','refs/heads/main').split()[0]==basehead
save(RAW/'baseline_backup_receipt.json',dict(passed=True,head=basehead,remote='origin/main',
    force_push=False,paths=relative,tests=57))
OUT.mkdir(parents=True,exist_ok=False)
sources=[RAW/name for name in ('qualify.py','qualification.json','qualification_01_closure.json',
    'qualification_02_closure.json','http_3b_100.json','native_3b.json',
    'cpu_contract_tests_01.log','cpu_contract_tests_02.log','backup.py','baseline_backup_receipt.json',
    'start.py','freeze_inputs.py','run3b.sh','start_remote.sh','stop_remote.sh',
    'check_remote_health_stdlib.py','close.py','close_launch.py','preserve_evidence.py','run_analysis.py')]
sources.append(RAW/'source_view/measurement_manifest.json')
previous=RAW.parent/'d767_20261023'
sources.extend(previous/name for name in ('gpu_publication_receipt.json','gpu_publication_closure.json'))
mapping=copy_sources(OUT,sources)
save(OUT/'manifest.json',dict(passed=True,files=mapping,plan_sha256=p.check_plan(),
    baseline_head=basehead,cpu_tests=57,requests_prepared=100,gpu_run_started=False,
    no_new_weights_or_trace=True,independent_numerical_correctness_proven=False))
paths=[MAIN/'docs/ieee_tc/EXECUTION_STATUS.md',MAIN/'docs/ieee_tc/D768_SLORA_CANONICAL_INPUT_20261023.md',
    *sorted(OUT.iterdir())]
'''
source = prefix+body+suffix
source = source.replace('d764_shared_tokenizer_full_w0','d768_slora_canonical_input')
source = source.replace('tc: seal ServerlessLLM 3B W0 and bind unchanged W1 (D764-D765)',
    'tc: preserve S-LoRA canonical-input qualification (D768)')
source = source.replace('refs/heads/backup/d764-complete-w0-20261023',
    'refs/heads/backup/d768-slora-input-20261023')
source = source.replace("RAW/'result_publication_receipt.json'", "RAW/'backup_receipt.json'")
exec(compile(source, str(original), 'exec'),
     {'__name__':'__main__','__file__':str(Path(__file__))})
