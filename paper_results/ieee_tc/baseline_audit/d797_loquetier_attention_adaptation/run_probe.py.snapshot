"""Run the unchanged D796 arithmetic diagnostic on the isolated D797 kernel."""
import hashlib
from pathlib import Path

original = Path('/home/qhq/serverless_llm_experiment/results/ieee_tc/loquetier_qualification/d796_20261024/run_probe.py')
data = original.read_bytes()
assert hashlib.sha256(data).hexdigest() == '83db2f83f3968a2684b4165b187926983c02524b7fca52ce83f289cba23cf3db'
source = data.decode()
source = source.replace(
    "kernel = Path('/home/qhq/anaconda3/envs/loquetier_20260520/lib/python3.9/site-packages/loquetier/ops/_kernels.cpython-39-x86_64-linux-gnu.so')",
    "kernel = RAW/'python/loquetier/ops/_kernels.cpython-39-x86_64-linux-gnu.so'")
source = source.replace('100efcf29d3f8a53d8b2fe31b877d1589634024c742c8fff6ff30110f5a57ec9',
    'b1f4b70ef8d816183a9d3ca0211b79a022f05af16a9228f34346bbe4ef2e1d41')
source = source.replace("str(MAIN), str(BASE/'scripts')", "str(RAW/'python'), str(MAIN), str(BASE/'scripts')")
exec(compile(source, str(original), 'exec'), {'__name__':'__main__', '__file__':str(Path(__file__))})
