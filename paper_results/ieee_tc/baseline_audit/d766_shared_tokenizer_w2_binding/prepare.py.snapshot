"""Bind the existing W2 mapping to D764/D765's unchanged native configuration."""
import ast
import json
import os
from pathlib import Path
import subprocess
import sys

MAIN=Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
BASE=Path('/home/qhq/serverless_llm_baselines')
RAW=Path(__file__).resolve().parent
OLD=RAW.parent/'d765_20261023'
sys.path[:0]=[str(MAIN),str(BASE/'scripts')]
from scripts import ieee_tc_preflight as p
import prepare_ieee_tc_serverless_stack as native

def read(path): return json.loads(path.read_text())
def save(path,value):
    with path.open('x') as stream:
        json.dump(value,stream,indent=2,allow_nan=False)
        stream.write('\n')

own=p.scope_identity(p.cg_path().name)
save(RAW/'qualification_identity.json',own)
assert os.sched_getaffinity(0)=={2,3,26,27}
assert not subprocess.check_output(['nvidia-smi','--query-compute-apps=pid','--format=csv,noheader'],text=True).strip()
assert read(OLD/'result_receipt.json')['passed']
assert read(OLD/'reclamation.json')['passed']
assert read(OLD/'contract_closure.json')['path_gone']
assert p.digest(OLD/'audit_full4000.json')=='b949ffdf08d5083073fc11891b818f2db43935f4db1f1d4758cacfdc610c4c71'
prior=read(OLD/'qualification.json')
for name,digest in (prior['refs']|prior['protected']|prior['preserved']).items():
    assert p.digest(Path(name))==digest,name
reference=MAIN/'paper_results/ieee_tc/vllm/d656_3b_full_w2/audit.json'
ref_plan=read(reference)['source_plan']
adapter_map=Path(ref_plan['adapter_map'])
assert p.digest(adapter_map)==ref_plan['adapter_map_sha256']
http=read(OLD/'http_3b_4000.json')
http.update(experiment_role='native_full4000_w2_verified_shared_tokenizer_development_observation',
    request_view='trace_w2_v1',replay_profile='W2',adapter_map=str(adapter_map),
    adapter_map_sha256=ref_plan['adapter_map_sha256'])
plan=native.load_http_replay_plan(http)
assert plan.identity()==ref_plan
assert plan.identity()['source_sha256']==prior['views']['4000']['plan']['source_sha256']
rows=[json.loads(entry.source_json) for entry in plan.entries]
assert len({r['adapter_id'] for r in rows})==497
assert sum(min(r['expected_output_tokens'],256) for r in rows)==458224
save(RAW/'http_3b_4000.json',http)
view=native.prepare_measurement_view(
    BASE/'vendor_new_baselines/ServerlessLLM_new_main_20260518',RAW/'source_repaired',
    'repaired',MAIN,'request_identity_v1',shared_tokenizer=True,
    device_compile_cache_root=Path(prior['source_view']['device_compile_cache_root']))
assert view['measured_sha256']==prior['source_view']['measured_sha256']
assert view['helper_sha256']==prior['source_view']['helper_sha256']
save(RAW/'overlay_preflight.json',read(OLD/'overlay_preflight.json'))
mapping=[]
for name in ('run3b_repaired.sh','start.py','start_remote.sh','stop_remote.sh',
             'check_remote_health_stdlib.py','close.py','close_launch.py',
             'restore_overlay.py','preserve_evidence.py','run_analysis.py'):
    source=OLD/name
    body=source.read_text().replace('d765','d766').replace('D765','D766')
    if name=='start.py':
        before='D764 complete W0 configuration; unchanged native policy/cache ownership; existing W1 view'
        assert body.count(before)==1
        body=body.replace(before,'D764/D765 complete configurations; unchanged native policy/cache ownership; existing W2 view')
        assert body.count('actual_unique_adapters=132')==1
        body=body.replace('actual_unique_adapters=132','actual_unique_adapters=497')
    if name=='run_analysis.py':
        assert body.count("'--population', 'full4000_w1'")==1
        body=body.replace("'--population', 'full4000_w1'","'--population', 'full4000_w2'")
    target=RAW/name
    with target.open('x') as stream: stream.write(body)
    if target.suffix=='.py': ast.parse(body,filename=str(target))
    else: subprocess.run(['bash','-n',str(target)],check=True)
    mapping.append(dict(source=str(source),source_sha256=p.digest(source),
        target=str(target),target_sha256=p.digest(target)))
paths=[*RAW.glob('*.py'),*RAW.glob('*.sh'),RAW/'http_3b_4000.json',RAW/'overlay_preflight.json',
    RAW/'source_repaired/measurement_manifest.json',BASE/'scripts/prepare_ieee_tc_serverless_stack.py',
    BASE/'scripts/ieee_tc_serverless_measurement.py',MAIN/'scripts/ieee_tc/audit_d402_serverlessllm_path.py',
    Path(http['trace']),Path(http['pool_index']),adapter_map,OLD/'audit_full4000.json',
    OLD/'shared_tokenizer_live_proof.json',MAIN/'docs/ieee_tc/METRIC_PROTOCOL_FROZEN_V1.md',
    MAIN/'docs/ieee_tc/METRIC_PROTOCOL_SINGLE_RUN_V2.md',
    MAIN/'paper_results/ieee_tc/protocols/20261017_3b_slo_d648_frozen.json',
    MAIN/'paper_results/ieee_tc/main_comparison/d657_3b_references/resident_references.json',reference]
save(RAW/'qualification.json',dict(passed=True,reused_native_tests=114,reused_3b_input_tests=89,
    affected_tests=33,new_component_tests=0,
    views={**prior['views'],'4000':dict(plan=plan.identity(),actual_unique_adapters=497,target_tokens=458224)},
    protected=prior['protected'],preserved=prior['preserved'],
    native_configuration=prior['native_configuration'],source_view=view,
    refs={str(path):p.digest(path) for path in paths},mechanical_rebindings=mapping,
    changed_path_native_check=str(OLD/'audit_full4000.json'),
    no_new_weights_or_trace=True,performance_qualified=False,
    resources=p.cgroup_snapshot(Path(own['path']))))
print(json.dumps(dict(passed=True,requests=4000,adapter_ids=497,target_tokens=458224,
    source_view_matches_actual_D765=True,workload='W2',gpu_started=False)))
