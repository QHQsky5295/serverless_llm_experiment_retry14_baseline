"""Finish the exact checkpoint after its small unit log matched *.log ignore."""
import json
from pathlib import Path
import subprocess
import sys

MAIN=Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
BASE=Path('/home/qhq/serverless_llm_baselines')
RAW=Path(__file__).resolve().parent
OUT=MAIN/'paper_results/ieee_tc/baseline_audit/d762_verified_common_tokenizer'
sys.path.insert(0,str(MAIN))
from scripts import ieee_tc_preflight as p
def read(path): return json.loads(path.read_text())
def save(path,value):
    with path.open('x') as handle:
        json.dump(value,handle,indent=2,allow_nan=False)
        handle.write('\n')
def call(repo,*args):
    return subprocess.check_output(args,cwd=repo,text=True,stderr=subprocess.STDOUT).strip()

own=p.scope_identity(p.cg_path().name)
save(RAW/'finish_publication_identity.json',own)
old=read(RAW/'publication_identity.json')
path=Path(old['path'])
assert p.scope_still_owned(old)
assert all(not f.read_text().split() for f in path.rglob('cgroup.procs'))
resources=p.cgroup_snapshot(path)
subprocess.run(['systemctl','--user','stop',old['unit']],check=True)
assert not path.exists()
save(RAW/'publication1_closure.json',dict(passed=True,identity=old,resources=resources,
    actual_recursive_procs_empty=True,path_gone=True,publication_passed=False,
    failure='git add exit 1: affected_tests.log matched repository *.log; other explicit paths staged'))
base=read(RAW/'baseline_checkpoint.json')
assert call(BASE,'git','rev-parse','HEAD')==base['head']
assert call(BASE,'git','ls-remote','origin','refs/heads/main').split()[0]==base['head']
assert call(MAIN,'git','rev-parse','HEAD')=='0e4a1fededda818a32d54fe1c7f880fc256a7aac'
files={str(path.relative_to(MAIN)) for path in OUT.iterdir() if path.is_file()}
files|={'docs/ieee_tc/EXECUTION_STATUS.md','docs/ieee_tc/D762_VERIFIED_COMMON_TOKENIZER_20261023.md'}
log=OUT/'affected_tests.log'
assert log.stat().st_size < 16384
assert p.digest(log)==read(OUT/'manifest.json')['files']['affected_tests.log']['sha256']
assert set(call(MAIN,'git','diff','--cached','--name-only').splitlines())==files-{str(log.relative_to(MAIN))}
call(MAIN,'git','add','-f','--',str(log.relative_to(MAIN)))
assert set(call(MAIN,'git','diff','--cached','--name-only').splitlines())==files
assert not call(MAIN,'git','diff','--name-only','--',*sorted(files))
call(MAIN,'git','-c','core.whitespace=blank-at-eol,space-before-tab,-blank-at-eof,cr-at-eol','diff','--cached','--check')
call(MAIN,'git','commit','-m','tc: validate common tokenizer representation without performance claims (D762)')
head=call(MAIN,'git','rev-parse','HEAD')
ref='refs/heads/backup/d762-common-tokenizer-20261023'
call(MAIN,'git','-c','http.version=HTTP/1.1','push','faaslora_origin','HEAD:'+ref)
assert call(MAIN,'git','ls-remote','faaslora_origin',ref).split()[0]==head
save(RAW/'publication_receipt.json',dict(passed=True,head=head,remote_ref=ref,baseline_head=base['head'],
    force_push=False,v2_synchronized=False,paths=sorted(files),small_curated_log_explicitly_added=True,
    first_publication_failure_preserved=True,resources=p.cgroup_snapshot(Path(own['path']))))
print(json.dumps(dict(passed=True,head=head,baseline_head=base['head'],remote_ref=ref,paths=len(files))))
