"""Close D780's actual empty domains; preserve an incomplete diagnostic as such."""
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time

MAIN=Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
BASE=Path('/home/qhq/serverless_llm_baselines')
RAW=Path(__file__).resolve().parent
REUSE=RAW.parent.parent/'slora_qualification/d767_20261023'
sys.path.insert(0,str(MAIN))
from scripts import ieee_tc_preflight as p
def read(path): return json.loads(path.read_text())
def save(path,value):
    with path.open('x') as stream: json.dump(value,stream,indent=2,allow_nan=False)
own=p.scope_identity(p.cg_path().name)
save(RAW/'maintenance_identity.json',own)
group=Path(own['path'])
assert os.sched_getaffinity(0)=={2,3,26,27}
assert (group/'memory.max').read_text().strip()==str(4*p.GIB)
assert (group/'memory.swap.max').read_text().strip()=='0'
launch=read(RAW/'launch3b.launch/exec_receipt.json')
service=launch['service_identity']
assert not (RAW/'launch3b.json').exists(), 'Do not replace an actual launcher result'
assert 'process membership/owner changed during census' in (RAW/'runner.log').read_text()
api=p.load_nvml_binding(Path(launch['watchdog_ready']['nvml_binding_path']),launch['watchdog_ready']['nvml_binding_sha256'])
census=p.NativeGPUCensus(api)
try: gpu=census.sample(Path(service['path']))
finally: census.close()
p.require_idle_gpu_census(gpu)
closures={}
for name,identity in [('service',service),('launcher',read(RAW/'service_aux_identity.json')),('start',read(RAW/'start_identity.json'))]:
    assert p.scope_still_owned(identity)
    path=Path(identity['path'])
    members={str(item):item.read_text().split() for item in path.rglob('cgroup.procs')}
    assert members and all(not values for values in members.values()),members
    before=p.cgroup_snapshot(path)
    assert p.scope_still_owned(identity)
    subprocess.run(['systemctl','--user','stop',identity['unit']],check=True,timeout=10)
    assert not path.exists()
    closed=dict(passed=True,identity=identity,actual_recursive_procs_empty=True,path_gone=True,resources=before)
    save(RAW/(name+'_closure.json'),closed)
    closures[name]=closed
local=dict(passed=True,service_identity=service,service_path_gone=True,
    auxiliary_identity=closures['launcher']['identity'],auxiliary_path_gone=True,
    actual_recursive_procs_empty=True,native_gpu_context_release_confirmed=True,
    service_path_removed=True,gpu_census=gpu,at=time.monotonic(),
    launch_result_missing=True,physical_measurement_complete=False,
    service_returncode=None,reason='Launcher cleanup census raised during process exit; no fabricated launcher returncode or physical release journal.')
save(RAW/'local_cleanup.json',local)
save(RAW/'recovery_cleanup.json',local)
path=REUSE/'stop_remote.sh'
assert p.digest(path)=='28ff871738f753c68b3152b693dc680ab3281ecac79c56c62897a26962a1526e'
source=path.read_text().replace(str(REUSE),str(RAW)).replace('d767','d780').replace('$raw/launch3b.json','$raw/recovery_cleanup.json')
subprocess.run(['bash'],input=source,text=True,check=True)
path=REUSE/'preserve_evidence.py'
assert p.digest(path)=='b5af7c5a6a930892c53813d4d4615238a71628055ba08e6c192599b9f8b6dde4'
source=path.read_text().replace('/tmp/tc-d767-3bs/','/tmp/tc-d780-3bd/').replace('d767','d780').replace("ROOT/'launch3b.json'","ROOT/'recovery_cleanup.json'")
exec(compile(source,str(path),'exec'),{'__name__':'__main__','__file__':str(RAW/'preserve_evidence.py')})
# Preserve private Ray diagnostic files, not model/cache payloads.
ray=Path('/tmp/tc-d780-ray/session_latest').resolve(strict=True)
assert ray.parent==Path('/tmp/tc-d780-ray')
dest=RAW/'ray_evidence'
dest.mkdir(exist_ok=False)
copies={}
for item in sorted((ray/'logs').rglob('*')):
    if item.is_file() and not item.is_symlink():
        relative=item.relative_to(ray/'logs')
        target=dest/relative
        target.parent.mkdir(parents=True,exist_ok=True)
        shutil.copy2(item,target)
        assert p.digest(item)==p.digest(target)
        copies[str(relative)]=dict(source=str(item),sha256=p.digest(target),bytes=target.stat().st_size)
save(RAW/'ray_evidence_manifest.json',copies)
before=read(RAW/'manual_stop_before.json')
by_name={}
for proc in before['process_snapshot']:
    bucket=by_name.setdefault(proc['comm'],dict(count=0,rss_bytes_sum=0,anonymous_rss_bytes_sum=0))
    bucket['count']+=1
    for source,key in [('VmRSS','rss_bytes_sum'),('RssAnon','anonymous_rss_bytes_sum')]:
        value=proc['memory'][source].split()
        if value: bucket[key]+=int(value[0])*1024
result=dict(schema='ieee_tc_dlora_startup_diagnostic_v1',system='dLoRA',model='3B',
    workload_passed=False,formal_run=False,performance_ranking_eligible=False,
    outcome='manual_diagnostic_stop_during_native_model_loading',
    prepared_pool_count=len(read(RAW/'model3b/dlora_full_pool_preparation.json')),
    private_ray_started=True,native_worker_ready=False,model_load_completed=False,
    independent_numerical_correctness_proven=False,physical_measurement_complete=False,
    n_correct=None,service_returncode=None,launch_result_missing=True,
    launcher_cleanup_error='process membership/owner changed during census',
    no_oom_observed=closures['service']['resources']['memory.events']['oom']==0,
    not_watchdog_threshold_abort=True,service_final_resources=closures['service']['resources'],
    process_memory_snapshot_by_name=by_name,rss_sum_is_not_unique_physical_memory=True,
    native_actor_count_in_snapshot=4,prestarted_python_workers=40,
    source_configuration_unchanged=True,remote_stopped=True,
    actual_cleanup=local,
    interpretation='Startup pressure occurred with 36 idle Ray workers. Their memory is an unnecessary startup burden; removing prestart is not yet proven sufficient for native model loading.',
    sources={str(path):p.digest(path) for path in (RAW/'manual_stop_before.json',RAW/'manual_stop_signal.json',RAW/'runner.log',RAW/'model3b/worker_0.log',RAW/'ray_evidence_manifest.json')})
assert result['prepared_pool_count']==500
save(RAW/'failure_result.json',result)
path=RAW.parent.parent/'vllm_qualification/d532_20261015/reclaim_objects.py'
assert p.digest(path)=='e66e17f0a2ca0f72c0c0ae9f6bb6c6da8351b924f4d72ce4f7e93c64476892bb'
source=path.read_text()
changes={
    "'d532_20261015'":"'d780_20261024'",
    '/tmp/tc-d532-7bv/':'/tmp/tc-d780-3bd/',
    'llama2_7b_a500_v2_publicmix':'llama32_3b_a500_v1_modelscope',
    "ROOT/'launch7b.json'":"ROOT/'recovery_cleanup.json'",
    "launch['service_returncode'] == 0":"launch['passed'] and launch['physical_measurement_complete'] is False",
    "MAIN/'paper_results/ieee_tc/main_comparison/d532_vllm_w1/result1/audit.json'":"ROOT/'failure_result.json'",
    'f3b2344147c51db9407b9711ec6dbc59af8c6c5007dd7c9d90fdd68efcf6ddb7':p.digest(RAW/'failure_result.json'),
    "assert audit['workload_passed'] and audit['offered_unique_adapters'] == 132 and audit['verified_materialized_bytes'] == 3300789780":"assert not audit['workload_passed'] and not audit['model_load_completed'] and audit['prepared_pool_count'] == 500",
    '20260927_7b_materialized_content_index.json':'20260927_3b_remote_content_index.json',
    'e85cce3c3611da15530f9e663549231d3493282c85913344fe41c2a67044260c':read(RAW/'http_3b_100.json')['pool_index_sha256'],
    "len(selected) == audit['offered_unique_adapters']":"len(selected) == 500",
    "total == audit['verified_materialized_bytes']":"total == sum(item['size_bytes'] for row in index['artifacts'] for item in row['files'])",
    'all_cache_bytes_previously_hashed_by_audit=True':'all_cache_bytes_previously_hashed_by_audit=False',
}
for old,new in changes.items():
    assert source.count(old)==1,old
    source=source.replace(old,new)
exec(compile(source,str(path),'exec'),{'__name__':'__main__','__file__':str(Path(__file__))})
q=read(RAW.parent/'d778_20261024/qualification.json')
for path,sha in (q['refs']|q['preserved']).items(): assert p.digest(Path(path))==sha,path
save(RAW/'maintenance_receipt.json',dict(passed=True,failure_preserved=True,
    cache_reclamation=read(RAW/'cache_cleanup_after.json'),resources=p.cgroup_snapshot(group)))
print(json.dumps(dict(passed=True,outcome=result['outcome'],resources=result['service_final_resources'],idle=by_name.get('ray::IDLE'))))
