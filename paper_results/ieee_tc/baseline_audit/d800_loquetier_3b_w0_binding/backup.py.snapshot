"""Back up only unchanged W0 binding and its exact provenance."""
import ast
import hashlib
from pathlib import Path
original = Path('/home/qhq/serverless_llm_experiment/results/ieee_tc/serverless_qualification/d764_20261023/publish_result.py')
data = original.read_bytes()
assert hashlib.sha256(data).hexdigest() == '1852265b403fa717ec44014d031950f34317b9f7bce1d7b8a02a22fa2a9448c4'
recipe = data.decode()
exec(compile(recipe[:recipe.index('own=p.scope_identity')],str(original),'exec'),globals())
prior = RAW.parent/'d796_20261024/backup.py'
assert p.digest(prior) == '2d6159d567e2077d40aa4ecce0a911fccc1de0a5cbd566158db9570e65d00ae0'
tree = ast.parse(prior.read_bytes())
nodes = [n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name in ('checked','commit')
    or isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id == 'secret' for t in n.targets)]
assert len(nodes) == 3
exec(compile(ast.Module(body=nodes,type_ignores=[]),str(prior),'exec'),globals())
own = p.scope_identity(p.cg_path().name)
save(RAW/'backup_identity.json',own)
assert os.sched_getaffinity(0) == {2,3,26,27}
assert read(RAW/'prepare_closure.json')['path_gone']
assert not call(MAIN,'nvidia-smi','--query-compute-apps=pid','--format=csv,noheader')
q = read(RAW/'preparation.json')
for path,digest in (q['refs'] | q['preserved']).items(): assert p.digest(Path(path)) == digest,path
basehead = call(BASE,'git','rev-parse','HEAD')
assert basehead == '8594922093ee4625dcc6614ecc11746af277219d'
assert call(BASE,'git','ls-remote','origin','refs/heads/main').split()[0] == basehead
assert call(MAIN,'git','rev-parse','HEAD') == '889970cfd3218f5982ef07ff6eebb07ce8c5a6f4'
OUT = MAIN/'paper_results/ieee_tc/baseline_audit/d800_loquetier_3b_w0_binding'
OUT.mkdir(parents=True,exist_ok=False)
sources = [RAW/name for name in ('prepare.py','start.py','run3b.py','close.py','backup.py',
    'preparation.json','prepare_closure.json','native_3b.json','http_3b_4000.json')]
checked(sources)
mapping = copy_sources(OUT,sources)
save(OUT/'manifest.json',dict(schema='ieee_tc_loquetier_3b_w0_binding_v1',files=mapping,
    baseline_head=basehead,plan_sha256=p.check_plan(),native_configuration_unchanged=True,
    qualification_reused_from='D799 full500 coverage; D798 bounded numeric check',
    input_identity=q['input_identity'],actual_unique_adapters=q['actual_unique_adapters'],
    target_tokens=q['target_tokens'],performance_run_started=False,
    full_workload_numerical_correctness_proven=False,protected_and_dirty_unchanged=len(q['preserved'])))
paths = [MAIN/'docs/ieee_tc/EXECUTION_STATUS.md',MAIN/'docs/ieee_tc/D800_LOQUETIER_3B_FULL_W0_20261024.md',
    *sorted(OUT.iterdir())]
ref = 'refs/heads/backup/d800-loquetier-3b-w0-binding-20261024'
head = commit(MAIN,paths,'tc: bind unchanged Loquetier 3B to full W0 (D800)','faaslora_origin',ref)
for path,digest in q['preserved'].items(): assert p.digest(Path(path)) == digest,path
save(RAW/'backup_receipt.json',dict(passed=True,head=head,baseline_head=basehead,remote_ref=ref,
    force_push=False,v2_synchronized=False,protected_and_dirty_unchanged=len(q['preserved']),
    resources=p.cgroup_snapshot(Path(own['path']))))
print(json.dumps(dict(passed=True,head=head,baseline_head=basehead,remote_ref=ref)))
