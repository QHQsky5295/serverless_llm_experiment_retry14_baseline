"""Reuse verified D807 cleanup for D808; preserve all W1 result evidence."""
import hashlib
import json
from pathlib import Path

RAW = Path(__file__).resolve().parent
closed = json.loads((RAW/'publication2_closure.json').read_text())
assert closed['passed'] and closed['path_gone']
assert not Path(closed['identity']['path']).exists()
original = RAW.parent/'d807_20261024/reclaim.py'
data = original.read_bytes()
assert hashlib.sha256(data).hexdigest() == '785dbc5c9b850b2a289842122f00736d75993c30322d3ae6012ae7fa979af1e6'
source = data.decode().replace('d807_20261024', 'd808_20261024')
exec(compile(source, str(original), 'exec'), {'__name__': '__main__', '__file__': str(Path(__file__))})
