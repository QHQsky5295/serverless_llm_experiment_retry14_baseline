"""Reuse the complete D576 audit with 3B identities; never rewrite raw results."""
from hashlib import sha256
import json
import os
from pathlib import Path
import subprocess
import sys

RAW = Path(__file__).resolve().parent
MAIN = Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
sys.path.insert(0, '/home/qhq/serverless_llm_baselines/scripts')
from prepare_ieee_tc_serverless_stack import load_guard
p = load_guard(MAIN)


def save(name, value):
    with (RAW/name).open('x') as stream:
        json.dump(value, stream, indent=2, sort_keys=True)


own = p.scope_identity(p.cg_path().name)
save('audit_identity.json', own)
assert os.sched_getaffinity(0) == {2, 3, 26, 27}
assert (Path(own['path'])/'memory.max').read_text().strip() == str(4*p.GIB)
assert not subprocess.check_output(['nvidia-smi', '--query-compute-apps=pid', '--format=csv,noheader'], text=True).strip()
launch = json.loads((RAW/'launch_gate.json').read_text())
closure = json.loads((RAW/'closure.json').read_text())
assert launch['pass'] and launch['cleanup']['released']
assert closure['service_gone'] and closure['actual_recursive_empty']
assert not Path(closure['service']['path']).exists()
remote = json.loads((RAW/'remote_stop.json').read_text())
assert remote['all_owned_units_inactive'] and remote['download_hashes_match_remote']
assert remote['ports_18080_18081_absent']
for name, expected in remote['hashes'].items():
    assert p.digest(RAW/name) == expected
prereg = json.loads((RAW/'preregistration.json').read_text())
for path, expected in prereg['preserved'].items():
    assert p.digest(Path(path)) == expected, path

original = RAW.parent/'d576_20261016/audit.py'
assert p.digest(original) == 'f35fcd266e29948c1da5c6153676e482c610506b8ed18512ef3705ac015f37a6'
assert p.digest(RAW.parent/'d503_20261013/audit.py') == 'bbb64378e11f125ce97fc3534cf5e3c51f49853d5dce49164923b55bb0857d5a'
source = original.read_text()


def replace_one(old, new):
    global source
    assert source.count(old) == 1, old
    source = source.replace(old, new)


references = {
    'plan': {'path': '/home/qhq/storage_audit_20260915/PrimeLoRA-PLAN.md',
             'sha256': 'd7acd08127d4f4513b23af6dd57a9647cf047570f2b563e361e716ccb0b32b83'},
    'metric_protocol': {'path': str(MAIN/'docs/ieee_tc/METRIC_PROTOCOL_FROZEN_V1.md'),
                        'sha256': '5f0732ef54d629b40cece42bdbf536e8e74c6505e3ec5d4c7e8742408ad80f22'},
    'single_run_amendment': {'path': str(MAIN/'docs/ieee_tc/METRIC_PROTOCOL_SINGLE_RUN_V2.md'),
                             'sha256': '193bf1535af1aa50f83d98dc2e944ecbdc7bd27aa96baeca82f0654e02f9357d'},
    'slo_eval': {'path': str(MAIN/'paper_results/ieee_tc/protocols/20261017_3b_slo_d648_frozen.json'),
                 'sha256': 'd15123570c4a8d830515ca942d1db553c6717ffc1a40ade5c1546d35e2bed9d8'},
}
replace_one("'ff143878a62bf95761a85cd456529f2c0f954a9bfbf9be3d4746a441ddfb5753'",
            "'0345c5e577756f015d673ba67324f5698954019a67e587dcdd5aed078835738d'")
replace_one("    for ref in prereg['references'].values():",
            "    prereg['references'] = " + repr(references) + "\n    for ref in prereg['references'].values():")
replace_one("    source = replace_one(source,\n        \"outputs=",
    "    source = source.replace('http_7b_4000.json', 'http_3b_4000.json')\n"
    "    source = source.replace('from scripts import ieee_tc_preflight as p', "
    "'from prepare_ieee_tc_serverless_stack import load_guard\\np = load_guard(MAIN)')\n"
    "    source = replace_one(source, \"prior={r['request_id']:r for r in json.loads((RAW.parent/'d502_20261013/generation_result.json').read_text())['requests']}\", "
    "'prior={}  # 7B reference is not a 3B numerical comparison')\n"
    "    source = replace_one(source,\n        \"outputs=")
replace_one("    assert len({row['adapter_id'] for row in rows}) == 132",
            "    assert {row['adapter_id'] for row in rows} == {row['adapter_id'] for row in contracts.values()}")
# All complete-run timing, source/adapter binding, pp1 lifecycle union, frozen
# SLO arithmetic and 4000/458224 counts remain the existing D576 implementation.
scope = {'__name__': '__main__', '__file__': str(RAW/'audit.py')}
exec(compile(source, str(original), 'exec'), scope)

reference_path = RAW.parent/'d803_20261024/native_probe.json'
assert p.digest(reference_path) == 'a8445cfbbf280707a08a270cca98bd5f1d80607ea9a0269c0b7b3cd596a8b1a5'
reference = json.loads(reference_path.read_text())
ref_input = next(row for row in reference['inputs'] if row['request_id'] == 'req_00001')
native = scope['raws']['req_00001']['body']['metrics']['ieee_tc']
assert native['native_prompt_token_ids'] == ref_input['prompt_ids']
assert scope['contracts']['req_00001']['adapter_id'] == ref_input['adapter_id']
checks = sorted((row for row in reference['checks'] if row['request_id'] == 'req_00001'), key=lambda row: row['step'])
assert all(row['passed'] and row['native_token'] == row['reference_token'] for row in checks)
expected = [row['reference_token'] for row in checks]
observed = native['completion_token_ids'][:len(expected)]
all_zero = [rid for rid, row in scope['raws'].items()
            if set(row['body']['metrics']['ieee_tc']['completion_token_ids']) == {0}]
save('delivery_numerical_audit.json', dict(
    audit_completed=True, affected_path_pass=observed == expected and not all_zero,
    native_binding_accounting_passed=scope['result']['full_audit_pass'],
    independent_full_correctness_proven=False, n_correct=None,
    n_plan=4000, n_arrived=4000, n_terminal=4000, n_response=4000,
    all_zero_output_count=len(all_zero), all_zero_request_ids=all_zero,
    reference_request_id='req_00001', same_prompt_ids=True, same_adapter_id=True,
    expected_prefix=expected, observed_prefix=observed,
    scope='One exact-input independent reference prefix; all native-bound responses checked, not 4000 independent numerical references',
    source_sha256={str(path): p.digest(path) for path in
        (RAW/'audit.py', original, reference_path, RAW/'full_w0_evaluation.json',
         RAW/'http_audit.json', RAW/'launch_gate.json', RAW/'closure.json', RAW/'remote_stop.json')}
))
assert observed == expected and not all_zero, 'retain numerical failure; no qualified performance claim'
print(json.dumps(dict(audit_completed=True, affected_path_pass=True,
                     expected_prefix=expected, observed_prefix=observed, all_zero_outputs=len(all_zero))))
