"""Seal the bounded model observation and its explicit runner extension."""
import ast
import hashlib
from pathlib import Path
original = Path('/home/qhq/serverless_llm_experiment/results/ieee_tc/serverless_qualification/d764_20261023/publish_result.py')
data = original.read_bytes()
assert hashlib.sha256(data).hexdigest() == '1852265b403fa717ec44014d031950f34317b9f7bce1d7b8a02a22fa2a9448c4'
recipe = data.decode()
exec(compile(recipe[:recipe.index('own=p.scope_identity')],str(original),'exec'),globals())
prior = RAW.parent/'d796_20261024/backup.py'
tree = ast.parse(prior.read_bytes())
nodes = [n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name in ('checked','commit')
    or isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id == 'secret' for t in n.targets)]
assert len(nodes) == 3
exec(compile(ast.Module(body=nodes,type_ignores=[]),str(prior),'exec'),globals())
own = p.scope_identity(p.cg_path().name)
save(RAW/'backup_identity.json',own)
assert os.sched_getaffinity(0) == {2,3,26,27}
assert not call(MAIN,'nvidia-smi','--query-compute-apps=pid','--format=csv,noheader')
closed = read(RAW/'probe_closure.json')
assert closed['passed'] and closed['path_gone'] and not Path(closed['identity']['path']).exists()
launch,result = read(RAW/'probe_launch.json'),read(RAW/'native_probe.json')
assert launch['service_returncode'] == launch['watchdog_returncode'] == 0
assert launch['native_gpu_context_release_confirmed'] and launch['service_path_removed']
assert result['passed'] and result['completed'] and result['tied_head_shared']
assert len(result['checks']) == 6 and all(r['passed'] for r in result['checks'])
assert not result['full_workload_numerical_correctness_proven']
preserved = read(Path('/home/qhq/serverless_llm_experiment/results/ieee_tc/dlora_qualification/d782_20261024/qualification.json'))['preserved']
for path,digest in preserved.items(): assert p.digest(Path(path)) == digest,path
runner = BASE/'Loquetier_project/scripts/run_loquetier_trace_gate.py'
test = BASE/'tests/test_loquetier_static_capacity.py'
assert p.digest(runner) == result['runner_sha256']
save(RAW/'test_receipt.json',dict(passed=True,tests=22,seconds=.157,
    command='/usr/bin/taskset -c 2,3,26,27 /usr/bin/python3 -B -m unittest tests.test_loquetier_static_capacity -q',
    execution='completed interactively before GPU launch; exit0',
    runner_sha256=p.digest(runner),test_sha256=p.digest(test),post_probe_source_change=False))
assert call(BASE,'git','rev-parse','HEAD') == 'afef3a2fa447eb19c9c428debf8624680cf46516'
assert call(BASE,'git','ls-remote','origin','refs/heads/main').split()[0] == 'afef3a2fa447eb19c9c428debf8624680cf46516'
basehead = commit(BASE,[runner,test],'tc: validate configured Loquetier native model outputs',
    'origin','refs/heads/main')
save(RAW/'baseline_backup_receipt.json',dict(passed=True,head=basehead,remote='origin/main',force_push=False))
OUT = MAIN/'paper_results/ieee_tc/baseline_audit/d798_loquetier_model_output'
OUT.mkdir(parents=True,exist_ok=False)
sources = [RAW/name for name in ('run_probe.py','close.py','backup.py','execution_identity.json',
    'probe_launch.json','probe_closure.json','native_probe.json','test_receipt.json',
    'baseline_backup_receipt.json')]
sources += [RAW/'probe_launch.launch/service.log',RAW/'probe_launch.launch/exec_receipt.json']
# Preserve the completed D797 main-publication continuation without modifying its
# existing curated manifest or pretending the first whitespace check succeeded.
sources += [RAW.parent/'d797_20261024'/name for name in
    ('resume_backup.py','close_publication.py','backup_receipt.json','publication_closure.json')]
checked(sources)
mapping = copy_sources(OUT,sources)
save(OUT/'manifest.json',dict(schema='ieee_tc_loquetier_model_output_checkpoint_v1',
    files=mapping,baseline_head=basehead,plan_sha256=p.check_plan(),
    model_diagnostics=1,performance_experiments=0,checks=6,passed=True,
    distinct_logical_adapters=2,distinct_adapter_payloads=len(set(result['adapter_payload_sha256'].values())),
    full_workload_numerical_correctness_proven=False,protected_and_dirty_unchanged=len(preserved),
    raw_sources={str(path):p.digest(path) for path in
        (RAW/'probe_launch.launch/watchdog.jsonl',RAW/'probe_launcher.log')},
    next='3B actual static capacity/kernel source binding, then existing full baseline matrix'))
paths = [MAIN/'docs/ieee_tc/EXECUTION_STATUS.md',
    MAIN/'docs/ieee_tc/D798_LOQUETIER_3B_MODEL_OUTPUT_20261024.md',*sorted(OUT.iterdir())]
assert call(MAIN,'git','rev-parse','HEAD') == 'b56a5a83c47f210fdd86df821d240c5871b6d2d0'
ref = 'refs/heads/backup/d798-loquetier-model-output-20261024'
head = commit(MAIN,paths,'tc: preserve Loquetier 3B real-input arithmetic qualification (D798)',
    'faaslora_origin',ref)
for path,digest in preserved.items(): assert p.digest(Path(path)) == digest,path
save(RAW/'backup_receipt.json',dict(passed=True,head=head,baseline_head=basehead,remote_ref=ref,
    force_push=False,v2_synchronized=False,paths=[str(path.relative_to(MAIN)) for path in paths],
    protected_unchanged=len(preserved),resources=p.cgroup_snapshot(Path(own['path']))))
print(json.dumps(dict(passed=True,head=head,baseline_head=basehead,remote_ref=ref)))
