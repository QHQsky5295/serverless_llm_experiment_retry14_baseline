"""Finish interrupted MAIN publication without repeating the BASE commit/push.

The only failed check was six pre-existing whitespace-only lines in a byte-
preserved native snapshot. Keep those exact evidence bytes; scope its attribute
locally and separately check the actual source changes against the original.
"""
import hashlib
from pathlib import Path

original = Path('/home/qhq/serverless_llm_experiment/results/ieee_tc/serverless_qualification/d764_20261023/publish_result.py')
data = original.read_bytes()
assert hashlib.sha256(data).hexdigest() == '1852265b403fa717ec44014d031950f34317b9f7bce1d7b8a02a22fa2a9448c4'
exec(compile(data.decode().split('own=p.scope_identity')[0], str(original), 'exec'))
OUT = MAIN/'paper_results/ieee_tc/baseline_audit/d774_dlora_native_timing'
own = p.scope_identity(p.cg_path().name)
save(RAW/'backup_resume_identity.json', own)
assert os.sched_getaffinity(0) == {2,3,26,27}
assert read(RAW/'backup_closure.json')['path_gone']
assert not call(MAIN,'nvidia-smi','--query-compute-apps=pid','--format=csv,noheader')
q = read(RAW/'qualification.json')
for path, digest in (q['refs'] | q['preserved']).items():
    assert p.digest(Path(path)) == digest, path
basehead = read(RAW/'baseline_backup_receipt.json')['head']
assert call(BASE,'git','rev-parse','HEAD') == basehead
assert call(BASE,'git','ls-remote','origin','refs/heads/main').split()[0] == basehead
assert call(MAIN,'git','rev-parse','HEAD') == '57be5a751304642b76e226f9b19e84f8e941519a'
for name, row in read(OUT/'manifest.json')['files'].items():
    assert p.digest(OUT/name) == row['sha256'], name
native = Path(q['source_view']['native_source'])/'vllm/engine/llm_engine.py'
view = RAW/'source_view/vllm/engine/llm_engine.py'
check = subprocess.run(['git','diff','--no-index','--check',str(native),str(view)],
                       capture_output=True,text=True)
assert check.returncode in (0,1) and not check.stdout and not check.stderr
save(RAW/'backup_interruption.json', dict(status='recovered_before_main_commit',
    baseline_already_backed_up=basehead, main_result_before_recovery='not_published',
    cause='six inherited whitespace-only native lines in exact evidence snapshot',
    exact_snapshot_sha256=p.digest(OUT/'llm_engine.py.snapshot'),
    original_native_sha256=p.digest(native), introduced_source_whitespace_check_passed=True,
    snapshot_bytes_changed=False, exception_scope='this directory/llm_engine.py.snapshot only',
    performance_or_qualification_failure=False))
extra = copy_sources(OUT,[RAW/'backup_interruption.json',RAW/'backup_closure.json',
                         RAW/'backup_resume.py'])
extra['.gitattributes'] = dict(source=str(OUT/'.gitattributes'),sha256=p.digest(OUT/'.gitattributes'))
save(OUT/'publication_completion_manifest.json', dict(files=extra, baseline_head=basehead,
    plan_sha256=p.check_plan(), existing_manifest_and_results_unchanged=True))
paths = [MAIN/'docs/ieee_tc/EXECUTION_STATUS.md',
         MAIN/'docs/ieee_tc/D774_DLORA_NATIVE_TIMING_20261024.md', *sorted(OUT.iterdir())]
relative = [str(path.relative_to(MAIN)) for path in paths]
secret = re.compile(r'-----BEGIN (?:OPENSSH |RSA |EC )?PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]+|(?im:^[ \t]*(?:password|passwd|secret|api_key|PRIME_REMOTE_TOKEN)[ \t]*=[ \t]*[\x22\x27]?[A-Za-z0-9+/]{8,})')
assert set(call(MAIN,'git','diff','--cached','--name-only').splitlines()) <= set(relative)
for path in paths:
    assert path.is_file() and path.stat().st_size < 2*1024*1024
    assert not secret.search(path.read_text()), path
call(MAIN,'git','add','--',*relative)
assert set(call(MAIN,'git','diff','--cached','--name-only').splitlines()) == set(relative)
call(MAIN,'git','-c','core.whitespace=blank-at-eol,space-before-tab,-blank-at-eof,cr-at-eol',
     'diff','--cached','--check')
call(MAIN,'git','commit','-m','tc: preserve dLoRA native timing qualification and scope (D774)')
head = call(MAIN,'git','rev-parse','HEAD')
ref = 'refs/heads/backup/d774-dlora-native-timing-20261024'
call(MAIN,'git','-c','http.version=HTTP/1.1','push','faaslora_origin','HEAD:'+ref)
assert call(MAIN,'git','ls-remote','faaslora_origin',ref).split()[0] == head
save(RAW/'backup_resume_receipt.json', dict(passed=True, head=head, baseline_head=basehead,
    remote_ref=ref, paths=relative, force_push=False, v2_synchronized=False,
    resources=p.cgroup_snapshot(Path(own['path']))))
print(json.dumps(dict(passed=True, head=head, baseline_head=basehead, remote_ref=ref)))
