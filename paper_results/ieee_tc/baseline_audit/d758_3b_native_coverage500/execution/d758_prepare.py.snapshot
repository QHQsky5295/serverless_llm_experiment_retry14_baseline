"""Reuse D756's qualified native path for the already-qualified 500-ID input view.

Mechanical campaign rebinding only: no new workload, weights, baseline policy,
production change, or repeated component-test suite.
"""
import ast
import json
import os
from pathlib import Path
import subprocess
import sys

MAIN = Path('/home/qhq/serverless_llm_experiment_retry14_baseline')
BASE = Path('/home/qhq/serverless_llm_baselines')
RAW = Path(__file__).resolve().parent
OLD = RAW.parent/'d756_20261023'
PRIOR = RAW.parent/'d755_20261023'
BACKUP = RAW.parent.parent/'storage_maintenance/d757_20261023'
sys.path[:0] = [str(MAIN), str(BASE/'scripts')]
from scripts import ieee_tc_preflight as p
import prepare_ieee_tc_serverless_stack as native

def read(path):
    return json.loads(path.read_text())

def save(path, value):
    with path.open('x') as stream:
        json.dump(value, stream, indent=2, allow_nan=False)
        stream.write('\n')

own = p.scope_identity(p.cg_path().name)
save(RAW/'qualification_identity.json', own)
assert os.sched_getaffinity(0) == {2, 3, 26, 27}
assert not subprocess.check_output(['nvidia-smi', '--query-compute-apps=pid', '--format=csv,noheader'], text=True).strip()
assert read(OLD/'result_receipt.json')['passed']
assert read(OLD/'local_cleanup.json')['passed']
assert p.digest(OLD/'audit_prefix100.json') == 'cb0b1a11085c2a30a8807ec63df25d6ae6b46bf807a3de655a2e652e361111cb'
prior = read(PRIOR/'qualification.json')
for path, expected in (prior['refs'] | prior['protected'] | prior['preserved']).items():
    assert p.digest(Path(path)) == expected, path

http = read(OLD/'http_3b_100.json')
http.update(request_count=500, request_view='adapter_coverage_v1',
            experiment_role='adapter_pool_functional_coverage')
http.pop('replay_profile')
plan = native.load_http_replay_plan(http)
assert plan.identity() == prior['views']['coverage']['plan']
assert len({entry.adapter_id for entry in plan.entries}) == 500
save(RAW/'http_3b_500.json', http)
view = native.prepare_measurement_view(
    BASE/'vendor_new_baselines/ServerlessLLM_new_main_20260518', RAW/'source_repaired',
    'repaired', MAIN, 'request_identity_v1',
    device_compile_cache_root=Path(prior['source_view']['device_compile_cache_root']))
assert view['measured_sha256'] == prior['source_view']['measured_sha256']
save(RAW/'overlay_preflight.json', read(OLD/'overlay_preflight.json'))

sources = []
for name in ('run3b_repaired.sh', 'start.py', 'start_remote.sh', 'stop_remote.sh',
             'check_remote_health_stdlib.py', 'close.py', 'close_launch.py',
             'restore_overlay.py', 'preserve_evidence.py', 'run_analysis.py'):
    source = OLD/name
    body = source.read_text().replace('d756', 'd758').replace('D756', 'D758')
    body = body.replace('3b100', '3b500').replace('http_3b_100.json', 'http_3b_500.json')
    if name == 'start.py':
        changes = {
            "BINDING=RAW.parent/'d755_20261023/qualification.json'": "BINDING=RAW/'qualification.json'",
            "binding['views']['100']['plan']['count']==100": "binding['views']['coverage']['plan']['count']==500",
            "RAW.parent/'d755_20261023/review_closure.json'": "RAW/'qualification_closure.json'",
            "binding['views']['100']['plan'],actual_unique_adapters=29": "binding['views']['coverage']['plan'],actual_unique_adapters=500",
            'target_tokens=17369': 'target_tokens=68925',
            "'D754 unchanged model/policy; D755 device compile cache ownership adaptation'": "'D756 unchanged native model/policy/cache ownership; existing 500-ID functional view'",
        }
        for before, after in changes.items():
            assert body.count(before) == 1, before
            body = body.replace(before, after)
    if name == 'run_analysis.py':
        assert body.count("'--population', 'prefix100'") == 1
        body = body.replace("'--population', 'prefix100'", "'--population', 'adapter_coverage_v1'")
        body = body.replace('audit_prefix100.json', 'audit_coverage500.json')
    # Comments must not misidentify this population or previous failed run.
    body = body.replace('prefix100', '500-ID coverage').replace('Save closed D754 evidence', 'Save closed D758 evidence')
    target = RAW/name
    with target.open('x') as stream:
        stream.write(body)
    if target.suffix == '.py':
        ast.parse(body, filename=str(target))
    else:
        subprocess.run(['bash', '-n', str(target)], check=True)
    sources.append(dict(source=str(source), source_sha256=p.digest(source),
                        target=str(target), target_sha256=p.digest(target)))

assert sum(min(int(json.loads(entry.source_json)['expected_output_tokens']), 256)
           for entry in plan.entries) == 68925
backup = read(BACKUP/'publication_receipt.json')
assert backup['passed']
backup['baseline_head'] = '2bdf53cb25040b98e84e587f421bd772528c96b9'
backup['scope_note'] = 'Existing tested code/results checkpoint reused; D758 adds only mechanical run bindings captured in launch_gate.'
save(RAW/'backup_receipt.json', backup)
save(RAW/'backup_closure.json', read(BACKUP/'publication_closure.json'))
refs = {str(path): p.digest(path) for path in [
    *RAW.glob('*.py'), *RAW.glob('*.sh'), RAW/'http_3b_500.json',
    RAW/'source_repaired/measurement_manifest.json', RAW/'overlay_preflight.json',
    BASE/'scripts/prepare_ieee_tc_serverless_stack.py', BASE/'scripts/ieee_tc_serverless_measurement.py',
    MAIN/'scripts/ieee_tc/audit_d402_serverlessllm_path.py', Path(http['trace']), Path(http['pool_index']),
    MAIN/'docs/ieee_tc/METRIC_PROTOCOL_FROZEN_V1.md', MAIN/'docs/ieee_tc/METRIC_PROTOCOL_SINGLE_RUN_V2.md']}
save(RAW/'qualification.json', dict(passed=True, reused_native_tests=114,
    reused_3b_input_tests=89, reused_cache_tests=17, new_component_tests=0,
    views=prior['views'], protected=prior['protected'], preserved=prior['preserved'],
    native_configuration=prior['native_configuration'], source_view=view, refs=refs,
    mechanical_rebindings=sources, no_gpu_run=True, no_new_weights_or_trace=True,
    resources=p.cgroup_snapshot(Path(own['path']))))
print(json.dumps(dict(passed=True, requests=500, adapter_ids=500, target_tokens=68925,
                     source_view_unchanged=True, gpu_run_started=False)))
