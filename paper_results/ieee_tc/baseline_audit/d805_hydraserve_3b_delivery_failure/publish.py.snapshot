"""Reuse explicit-path checkpoint helpers for numerical failure and receive fix."""
import ast
import hashlib
from pathlib import Path

original = Path('/home/qhq/serverless_llm_experiment/results/ieee_tc/serverless_qualification/d764_20261023/publish_result.py')
data = original.read_bytes()
assert hashlib.sha256(data).hexdigest() == '1852265b403fa717ec44014d031950f34317b9f7bce1d7b8a02a22fa2a9448c4'
recipe = data.decode()
exec(compile(recipe[:recipe.index('own=p.scope_identity')], str(original), 'exec'), globals())
prior = RAW.parent.parent/'loquetier_qualification/d796_20261024/backup.py'
assert p.digest(prior) == '2d6159d567e2077d40aa4ecce0a911fccc1de0a5cbd566158db9570e65d00ae0'
nodes = [n for n in ast.parse(prior.read_bytes()).body
    if isinstance(n, ast.FunctionDef) and n.name in ('checked', 'commit')
    or isinstance(n, ast.Assign) and any(isinstance(t, ast.Name) and t.id == 'secret' for t in n.targets)]
assert len(nodes) == 3
exec(compile(ast.Module(body=nodes, type_ignores=[]), str(prior), 'exec'), globals())
own = p.scope_identity(p.cg_path().name)
save(RAW/'publication_identity.json', own)
assert os.sched_getaffinity(0) == {2,3,26,27}
assert not call(MAIN, 'nvidia-smi', '--query-compute-apps=pid', '--format=csv,noheader')
for name in ('prepare', 'remote_prelaunch', 'audit'):
    closed = read(RAW/(name+'_closure.json'))
    assert closed['passed'] and not Path(closed['identity']['path']).exists()
audit = read(RAW/'delivery_numerical_audit.json')
assert audit['audit_completed'] and not audit['experiment_passed'] and audit['all_zero_output_count'] == 100
assert audit['resource_release'] and read(RAW/'remote_stop.json')['all_owned_units_inactive']
for path, digest in read(RAW/'preregistration.json')['preserved'].items():
    assert p.digest(Path(path)) == digest, path
expected = {
    'HydraServe_project/runtime/shm_control.py': 'bd60c997f99c9bb70afb68602a01fa5f58d2bf0116eef00cb63210ca2b01b0f4',
    'HydraServe_project/runtime/native_delivery.py': '4e36ad4617de7204be2c6e3c82b3dfc057b4c6b149ed46a7faeba58b71ff7d14',
    'tests/test_ieee_tc_hydraserve_shm_control.py': 'e72a24f43ae40c609e3c07591a380105e430439bab71f2686d3a929876624b49',
}
for name, digest in expected.items(): assert p.digest(BASE/name) == digest
save(RAW/'test_receipt.json', dict(passed=True, tests=37, elapsed_seconds=1.607,
    command='/usr/bin/python3 -B -m unittest tests.test_ieee_tc_hydraserve_shm_control tests.test_ieee_tc_hydraserve_native_delivery tests.test_ieee_tc_hydraserve_llama_model_compat -v',
    execution='exec session31785 exit0; primelora-tc-check-d805-receive.service success; CPU-only',
    files_sha256=expected, runtime_correction_verified=False, old_default_overlay_preserved=True))
assert call(BASE, 'git', 'rev-parse', 'HEAD') == '71b2ba170ddbd9b753e689c20f795f542d129cec'
assert call(BASE, 'git', 'ls-remote', 'origin', 'refs/heads/main').split()[0] == '71b2ba170ddbd9b753e689c20f795f542d129cec'
basehead = commit(BASE, [BASE/name for name in expected],
    'tc: bound native HydraServe SHM receives and verify child completion', 'origin', 'refs/heads/main')
save(RAW/'baseline_publication_receipt.json', dict(passed=True, baseline_head=basehead,
    executed_head='71b2ba170ddbd9b753e689c20f795f542d129cec', force_push=False,
    correction_runtime_verified=False))
OUT = MAIN/'paper_results/ieee_tc/baseline_audit/d805_hydraserve_3b_delivery_failure'
OUT.mkdir(parents=True, exist_ok=False)
sources = [RAW/name for name in ('prepare.py', 'audit.py', 'publish.py', 'close_cpu.py',
    'preregistration.json', 'prepare_result.json', 'prepare_closure.json', 'remote_prelaunch_closure.json',
    'audit_closure.json', 'http_3b_100.json', 'model_registration.json', 'model_witness.json',
    'launch_gate.json', 'closure.json', 'result.json', 'source_manifest.json', 'delivery_numerical_audit.json',
    'http_audit.json', 'generation_result.json', 'provider_ready.json', 'shm_capacity.json',
    'remote_stop.log', 'remote_stop.json', 'remote_recheck.log', 'remote_collection.log',
    'test_receipt.json', 'baseline_publication_receipt.json')]
sources += [RAW/'platform/000046.stderr', RAW/'platform/000046.stdout', RAW/'platform/000041.stderr',
            RAW/'launch_gate.launch/exec_receipt.json', RAW/'overlays/manifest.json']
checked(sources)
mapping = copy_sources(OUT, sources)
save(OUT/'checkpoint_manifest.json', dict(passed=True, experiment_passed=False,
    files=mapping, baseline_head=basehead, plan_sha256=p.check_plan(),
    performance_results=0, n_plan=100, n_arrived=100, n_response=100, n_correct=None,
    all_zero_output_count=100, native_binding_accounting_pass=True,
    failed_attempt_retained=True, other_project_k3s_changed=False,
    raw_sources={str(path):p.digest(path) for path in
        (RAW/'launch_gate.launch/replay.jsonl', RAW/'launch_gate.launch/watchdog.jsonl',
         RAW/'remote_monitor.log', RAW/'remote_transfers.jsonl', RAW/'physical/summary.json')},
    next='verified duplicate-cache recovery then affected native delivery with bounded receiver; full W0/W1/W2 only after correctness'))
assert call(MAIN, 'git', 'rev-parse', 'HEAD') == '6e41733b78b1b7533a0f858f4e691a2845552a6c'
paths = [MAIN/'docs/ieee_tc/EXECUTION_STATUS.md',
    MAIN/'docs/ieee_tc/D805_HYDRASERVE_3B_SHM_RECEIVE_20261024.md', *sorted(OUT.iterdir())]
ref = 'refs/heads/backup/d805-hydraserve-shm-receive-20261024'
head = commit(MAIN, paths, 'tc: preserve HydraServe 3B delivery numerical failure and receiver repair (D805)',
              'faaslora_origin', ref)
save(RAW/'publication_receipt.json', dict(passed=True, head=head, baseline_head=basehead,
    remote_ref=ref, force_push=False, v2_synchronized=False,
    resources=p.cgroup_snapshot(Path(own['path']))))
print(json.dumps(dict(passed=True, head=head, baseline_head=basehead, remote_ref=ref)))
