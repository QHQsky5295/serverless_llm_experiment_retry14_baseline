"""Bind the existing checked reclaimer to a released, fully preserved failure."""
import ast
from pathlib import Path

RAW = Path(__file__).resolve().parent
source = (RAW.parent/'d759_20261023/reclaim.py').read_text()
replacements = [
    ('D759 only', 'D760 only'),
    ('d759_20261023', 'd760_20261023'),
    ('/tmp/tc-d759-3br/', '/tmp/tc-d760-3br/'),
    ('d759_3b_native_prefix1000', 'd760_3b_native_full_w0_failure'),
    ('fd908be8a01f219e10227c43be7af84daaae4cb2c318f469690728d71ac3b53d',
     'e7d4561861e6f8ac6600a9bb5930bd25a7ca9af57b1a28d267e2a4b7207620d6'),
    ("audit['offered_unique_adapters'] == 60 and audit['verified_materialized_bytes'] == 2336314960",
     "audit['offered_unique_adapters'] == 132 and audit['verified_materialized_bytes'] == 5139892912"),
    ('http_3b_1000.json', 'http_3b_4000.json'),
    ('for before, after in changes.items():',
     '''changes.update({
    "launch['service_returncode'] == 0": "launch['service_returncode'] == 1 and launch['classification'] == 'qualification_request_failure'",
    "audit['workload_passed'] and": "not audit['workload_passed'] and audit['counts']['N_terminal'] == 4000 and audit['counts']['N_failed'] == 1478 and not audit['performance_ranking_eligible'] and",
})
assert json.loads((RAW/'review_closure.json').read_text())['path_gone']
assert json.loads((RAW/'ray_logs_preservation.json').read_text())['original_deleted'] is False
for before, after in changes.items():'''),
]
for before, after in replacements:
    assert before in source, before
    source = source.replace(before, after)
ast.parse(source)
with (RAW/'reclaim.py').open('x') as handle:
    handle.write(source)
print('Existing reclamation recipe bound; not yet executed.')
