"""Reuse D759's explicit-path publication for a preserved D760 failure."""
import ast
import hashlib
import json
from pathlib import Path

RAW = Path(__file__).resolve().parent
original = RAW/'native_compile_cache_before.json'
data = original.read_bytes()
cache = json.loads(data)
with (RAW/'native_compile_cache_before_summary.json').open('x') as handle:
    json.dump(dict(root=cache['root'], entries=len(cache['entries']),
        total_bytes=sum(row[1] for row in cache['entries']),
        full_inventory_path=str(original), full_inventory_sha256=hashlib.sha256(data).hexdigest(),
        full_inventory_bytes=len(data), full_inventory_retained_locally=True,
        full_inventory_in_git=False), handle, indent=2)
source = (RAW.parent/'d759_20261023/publish_v2.py').read_text()
replacements = [
    ('completed D759 original-prefix compatibility and safe reclamation', 'D760 complete failure evidence and offline accounting correction'),
    ('d759_3b_native_prefix1000', 'd760_3b_native_full_w0_failure'),
    ('39d9518ce22a848821f65a64bf85be23bc712e57', '90f7c4a5fdef53965704dcf7f8eee3359d164f74'),
    ('fd908be8a01f219e10227c43be7af84daaae4cb2c318f469690728d71ac3b53d',
     'e7d4561861e6f8ac6600a9bb5930bd25a7ca9af57b1a28d267e2a4b7207620d6'),
    ("('qualification', 'start', 'analysis', 'result', 'contract')",
     "('qualification', 'start', 'analysis', 'review', 'result', 'contract')"),
    ("    assert p.digest(Path(path)) == expected, path",
     "    if path == str(MAIN/'scripts/ieee_tc/audit_d402_serverlessllm_path.py'):\n        assert expected == '761ef6758ae85c665aa8ee38ef1a6fdbe740b2a7edb9a26912a9273b419b3a17'\n        expected = 'e89ac9f8e79e3b42901bf6df8615b4842f7132adb0ebc0847dd27359f12d3156'\n    assert p.digest(Path(path)) == expected, path"),
    ('D759_3B_SERVERLESSLLM_PREFIX1000_20261023.md', 'D760_3B_SERVERLESSLLM_FULL_W0_20261023.md'),
    ("         OUT/'audit.json', OUT/'manifest.json']",
     "         MAIN/'scripts/ieee_tc/audit_d402_serverlessllm_path.py',\n         MAIN/'tests/test_tc_serverless_qualification_population.py',\n         OUT/'audit.json', OUT/'manifest.json']"),
    ('http_3b_1000.json', 'http_3b_4000.json'),
    ("'native_compile_cache_before_summary.json', 'publication_failure.json', 'publication_closure.json',",
     "'native_compile_cache_before_summary.json', 'review_receipt.json', 'review_closure.json', 'focused_tests_closure.json', 'ray_logs_preservation.json',"),
    ("previous = RAW.parent/'d758_20261023'", "previous = RAW.parent/'d759_20261023'"),
    ("previous/'publication_receipt.json', previous/'publication_closure.json'",
     "previous/'result_publication_receipt.json', previous/'result_publication_closure.json'"),
    ("prefix = 'd758_' if source.is_relative_to(previous) else 'd759_'",
     "prefix = 'd759_' if source.is_relative_to(previous) else 'd760_'"),
    ('failed_preparations_retained=False, preparation_first_pass=True',
     "failed_preparations_retained=False, preparation_first_pass=True, failed_analysis_retained=True, workload_passed=False, ranking_eligible=False"),
    ('tc: complete 3B ServerlessLLM original 1000-request compatibility (D759)',
     'tc: preserve D760 3B failure and account failed-request downloads'),
    ('refs/heads/backup/d759-3b-prefix1000-20261023', 'refs/heads/backup/d760-3b-w0-failure-20261023'),
]
for before, after in replacements:
    assert before in source, before
    source = source.replace(before, after)
ast.parse(source)
with (RAW/'publish.py').open('x') as handle:
    handle.write(source)
print('Publication recipe prepared; no git operation yet.')
