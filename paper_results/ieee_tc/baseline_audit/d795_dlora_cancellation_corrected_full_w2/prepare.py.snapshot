"""Bind existing W2 bytes to the unchanged D794/D793 native configuration."""
import hashlib
import json
from pathlib import Path

RAW = Path(__file__).resolve().parent
W1 = RAW.parent/'d794_20261024'
OLD = RAW.parent/'d792_20261024'
def sha(path): return hashlib.sha256(path.read_bytes()).hexdigest()
def save(name, value):
    with (RAW/name).open('x') as stream:
        json.dump(value, stream, indent=2, allow_nan=False)

refs = {
    W1/'native_3b.json': '1fd479ec432279f12fa32d9e1feb2e822c948290fccfcea4caa2fec77956f9e4',
    W1/'run3b.sh': 'ef86d8a31fe9a9dc4a8f61a1fb5e9803d46a8bedea5579b3c6037e922d2017cf',
    W1/'close.py': 'eee2027f07574d5ef47d1abe68aac75f7b02ef4165aa405e00ed72914cb676c8',
    OLD/'http_3b_4000.json': '7a7264bd9c88244c5eb0a9ee63fc1ee303bb59c943b1c2b5b6b903a4227286d6',
    OLD/'freeze_inputs.py': '01acf177dfad5645648c0724d4bf15996ae6b3fd6c3f2a5a3db894ee04cc1357',
}
for path, digest in refs.items(): assert sha(path) == digest, path
old = json.loads((W1/'native_3b.json').read_text())
view = Path(old['source_view'])/'measurement_manifest.json'
assert sha(view) == old['source_view_manifest_sha256'] == 'fd0916a07bc7365d35b78ac6b54b0d5481b849f25056927019f78471f82c6ca1'
assert json.loads(view.read_text())['cancellation_lifecycle'] == 'native_owner_backend_transaction_v1'
new = dict(old, ray_root='/tmp/tc-d795-ray')
assert [key for key in old if old[key] != new[key]] == ['ray_root']
prior = json.loads((OLD/'native_3b.json').read_text())
assert sorted(key for key in prior if prior[key] != new[key]) == ['ray_root', 'source_view', 'source_view_manifest_sha256']
save('native_3b.json', new)
for origin, name in ((OLD, 'http_3b_4000.json'), (OLD, 'freeze_inputs.py'),
                     (W1, 'close.py'), (W1, 'run3b.sh')):
    data = (origin/name).read_text()
    if name == 'run3b.sh': data = data.replace('d794', 'd795')
    with (RAW/name).open('x') as stream: stream.write(data)
save('reuse_identity.json', dict(passed=True,
    source_sha256={str(path):digest for path,digest in refs.items()},
    prior_w2=str(OLD), same_configuration_as_w1=str(W1/'native_3b.json'),
    only_config_change_from_w1='ray_root', performance_parameters_changed=False,
    http_bytes_unchanged=sha(RAW/'http_3b_4000.json') == refs[OLD/'http_3b_4000.json'],
    model_and_lifecycle_evidence_reused='D790 bounded numeric parity and D793 55 CPU regressions',
    no_new_trace_or_weights=True, previous_results_preserved=True,
    prior_w2_reuse_class='R3_cancellation_lifecycle',
    full_workload_numerical_correctness_proven=False,
    generated_sha256={name:sha(RAW/name) for name in ('native_3b.json','http_3b_4000.json','freeze_inputs.py','close.py','run3b.sh')}))
print(json.dumps(dict(prepared=True, same_performance_config_as_w1=True, no_new_trace_or_weights=True)))
