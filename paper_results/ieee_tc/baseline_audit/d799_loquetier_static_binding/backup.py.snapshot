"""Back up only the tested service binding and its non-sensitive provenance."""
import ast
import hashlib
from pathlib import Path
original = Path('/home/qhq/serverless_llm_experiment/results/ieee_tc/serverless_qualification/d764_20261023/publish_result.py')
data = original.read_bytes()
assert hashlib.sha256(data).hexdigest() == '1852265b403fa717ec44014d031950f34317b9f7bce1d7b8a02a22fa2a9448c4'
recipe = data.decode()
exec(compile(recipe[:recipe.index('own=p.scope_identity')],str(original),'exec'),globals())
prior = RAW.parent/'d796_20261024/backup.py'
tree = ast.parse(prior.read_bytes())
nodes = [n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name in ('checked','commit')
    or isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id == 'secret' for t in n.targets)]
assert len(nodes) == 3
exec(compile(ast.Module(body=nodes,type_ignores=[]),str(prior),'exec'),globals())
own = p.scope_identity(p.cg_path().name)
save(RAW/'backup_identity.json',own)
assert os.sched_getaffinity(0) == {2,3,26,27}
assert not call(MAIN,'nvidia-smi','--query-compute-apps=pid','--format=csv,noheader')
assert read(RAW/'prepare_closure.json')['path_gone']
assert read(RAW/'prepare_parse_failure.json')['closed']
q = read(RAW/'preparation.json')
for path,digest in (q['refs'] | q['preserved']).items(): assert p.digest(Path(path)) == digest,path
assert call(BASE,'git','rev-parse','HEAD') == '2e3b1939d81cf1aec251f53fc47712ac67fa36ec'
assert call(BASE,'git','ls-remote','origin','refs/heads/main').split()[0] == '2e3b1939d81cf1aec251f53fc47712ac67fa36ec'
basehead = commit(BASE,[BASE/'scripts/replay_vllm_engine_trace.py',BASE/'tests/test_ieee_tc_loquetier_worker.py'],
    'tc: bind Loquetier native kernel and static batch to model configuration','origin','refs/heads/main')
save(RAW/'baseline_backup_receipt.json',dict(passed=True,head=basehead,remote='origin/main',force_push=False))
OUT = MAIN/'paper_results/ieee_tc/baseline_audit/d799_loquetier_static_binding'
OUT.mkdir(parents=True,exist_ok=False)
sources = [RAW/name for name in ('prepare.py','close.py','close_prepare_parse_failure.py','run3b.py',
    'start.py','backup.py','static_capacity.json','preparation.json','native_3b.json',
    'http_3b_coverage500.json','prepare_closure.json','prepare_parse_failure.json',
    'baseline_backup_receipt.json','tests.log')]
sources.append(RAW/'source_view/measurement_manifest.json')
checked(sources)
mapping = copy_sources(OUT,sources)
save(OUT/'manifest.json',dict(schema='ieee_tc_loquetier_static_model_binding_v1',passed=True,
    baseline_head=basehead,files=mapping,plan_sha256=p.check_plan(),cpu_tests=37,
    gpu_experiments_this_checkpoint=0,coverage_started=False,full_workload_numerical_correctness_proven=False,
    next='one full500 functional coverage then unchanged 3B W0/W1/W2'))
assert call(MAIN,'git','rev-parse','HEAD') == '9f8003172ccca9e559133d48f97d1abd0d380ee8'
ref = 'refs/heads/backup/d799-loquetier-static-binding-20261024'
paths = [MAIN/'docs/ieee_tc/EXECUTION_STATUS.md',MAIN/'docs/ieee_tc/D799_LOQUETIER_3B_STATIC_BINDING_20261024.md',
    *sorted(OUT.iterdir())]
head = commit(MAIN,paths,'tc: freeze Loquetier 3B static deployment binding (D799)','faaslora_origin',ref)
for path,digest in q['preserved'].items(): assert p.digest(Path(path)) == digest,path
save(RAW/'backup_receipt.json',dict(passed=True,head=head,baseline_head=basehead,remote_ref=ref,
    force_push=False,v2_synchronized=False,protected_and_dirty_unchanged=len(q['preserved']),
    resources=p.cgroup_snapshot(Path(own['path']))))
print(json.dumps(dict(passed=True,head=head,baseline_head=basehead,remote_ref=ref)))
