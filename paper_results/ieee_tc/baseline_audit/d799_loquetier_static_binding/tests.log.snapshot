usage: gate [-h] [--vendor VENDOR] --base-model BASE_MODEL
            [--adapter-root ADAPTER_ROOT] [--trace TRACE]
            [--adapter-subset ADAPTER_SUBSET] --output OUTPUT
            [--device DEVICE] [--dtype {float16,bfloat16}]
            [--max-adapters MAX_ADAPTERS] [--max-requests MAX_REQUESTS]
            [--max-batch-size MAX_BATCH_SIZE]
            [--max-input-tokens MAX_INPUT_TOKENS]
            [--max-new-tokens-cap MAX_NEW_TOKENS_CAP] [--static-capacity-only]
            [--pool-index POOL_INDEX] [--static-shards STATIC_SHARDS]
            [--context-tokens CONTEXT_TOKENS] [--native-capacity-probe]
            [--attention-compatibility-probe] [--model-output-probe]
            [--model-output-inputs MODEL_OUTPUT_INPUTS]
            [--model-output-inputs-sha256 MODEL_OUTPUT_INPUTS_SHA256]
            [--kernel-receipt KERNEL_RECEIPT]
            [--kernel-receipt-sha256 KERNEL_RECEIPT_SHA256]
            [--inference-owner-probe] [--forward-capacity-probe]
            [--capacity-evidence CAPACITY_EVIDENCE]
            [--capacity-evidence-sha256 CAPACITY_EVIDENCE_SHA256]
            [--capacity-score-evidence CAPACITY_SCORE_EVIDENCE]
            [--capacity-score-evidence-sha256 CAPACITY_SCORE_EVIDENCE_SHA256]
            [--capacity-score-mode {single_all_prefill_v1,completed_phases_v2}]
            [--ownership-input-journal OWNERSHIP_INPUT_JOURNAL]
            [--ownership-input-sha256 OWNERSHIP_INPUT_SHA256]
            [--static-capacity-plan STATIC_CAPACITY_PLAN]
            [--measurement-view MEASUREMENT_VIEW]
            [--measurement-view-sha256 MEASUREMENT_VIEW_SHA256]
            [--physical-gpu-id {0,1,2,3}] [--main-repo MAIN_REPO]
            [--arrival-scale ARRIVAL_SCALE]
