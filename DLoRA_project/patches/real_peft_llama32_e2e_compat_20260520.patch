+def _resolve_adapter_subset(
+    subset_path: Optional[str],
+    adapter_root: Optional[str],
+    adapter_limit: int,
+) -> Tuple[List[str], List[str]]:
+    if subset_path is None:
+        return [], []
+
+    subset = json.loads(Path(subset_path).read_text(encoding="utf-8"))
+    root = Path(adapter_root or subset.get("remote_dir") or "")
+    if not root:
+        raise ValueError("adapter root is required when subset has no remote_dir")
+
+    adapters = subset.get("adapters", [])
+    if adapter_limit > 0:
+        adapters = adapters[:adapter_limit]
+
+    adapter_ids = []
+    adapter_paths = []
+    for adapter in adapters:
+        adapter_id = adapter["id"]
+        adapter_ids.append(adapter_id)
+        adapter_paths.append(str(root / adapter_id))
+    return adapter_ids, adapter_paths
+
