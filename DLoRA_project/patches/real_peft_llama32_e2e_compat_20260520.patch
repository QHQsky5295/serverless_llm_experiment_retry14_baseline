 def _get_dtype_size(dtype: torch.dtype) -> int:
     return torch.tensor([], dtype=dtype).element_size()
+
+
+_LORA_KEY_RE = re.compile(
+    r"layers\.(?P<layer>\d+)\..*?(?P<module>q_proj|k_proj|v_proj|o_proj)"
+    r"\.lora_(?P<kind>A|B)\.weight$")
+
+
+def _get_lora_tensor(tensors: Dict[str, torch.Tensor],
+                     layer: int,
+                     module: str,
+                     kind: str) -> torch.Tensor:
+    for name, tensor in tensors.items():
+        match = _LORA_KEY_RE.search(name)
+        if match is None:
+            continue
+        if int(match.group("layer")) == layer and match.group("module") == module and match.group("kind") == kind:
+            return tensor.contiguous()
+    raise KeyError(f"missing layer {layer} {module}.lora_{kind}.weight")
+
+
+def _copy_checked(dst: torch.Tensor, src: torch.Tensor, label: str) -> None:
+    if tuple(dst.shape) != tuple(src.shape):
+        raise ValueError(
+            f"shape mismatch for {label}: dst={tuple(dst.shape)} src={tuple(src.shape)}")
+    dst.copy_(src.to(dtype=dst.dtype), non_blocking=True)
+
+
+def _assert_expected_shape(tensor: torch.Tensor,
+                           shape: Tuple[int, int],
+                           label: str) -> None:
+    if tuple(tensor.shape) != tuple(shape):
+        raise ValueError(
+            f"unexpected shape for {label}: got={tuple(tensor.shape)} expected={shape}")
