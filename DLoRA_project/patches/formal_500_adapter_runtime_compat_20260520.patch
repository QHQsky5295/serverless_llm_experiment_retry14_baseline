+
+def _selected_lora_einsum(x: torch.Tensor, adapter_mapping: torch.Tensor,
+                          active_lora_As: torch.Tensor,
+                          active_lora_Bs: torch.Tensor) -> torch.Tensor:
+    active_columns = torch.nonzero(adapter_mapping.any(dim=0),
+                                   as_tuple=False).flatten()
+    if active_columns.numel() == 0:
+        out_features = active_lora_Bs.shape[-1]
+        return torch.zeros((x.shape[0], out_features),
+                           dtype=x.dtype,
+                           device=x.device)
+    if active_columns.numel() == adapter_mapping.shape[1]:
+        return torch.einsum('bk, bi, ikr, ird->bd',
+                            x, adapter_mapping, active_lora_As,
+                            active_lora_Bs)
+    return torch.einsum('bk, bi, ikr, ird->bd',
+                        x,
+                        adapter_mapping.index_select(1, active_columns),
+                        active_lora_As.index_select(0, active_columns),
+                        active_lora_Bs.index_select(0, active_columns))
+
+
