+def discover_weight_files(input_path: str) -> Tuple[str, list[str]]:
+    """Return one complete Hugging Face weight format from a model directory."""
+    root = Path(input_path)
+    safetensor_files = sorted(str(path) for path in root.glob("*.safetensors"))
+    if safetensor_files:
+        return "safetensors", safetensor_files
+
+    bin_files = sorted(str(path) for path in root.glob("*.bin"))
+    if bin_files:
+        return "bin", bin_files
+
+    raise ValueError(
+        f"Input {input_path} does not contain *.safetensors or *.bin weights"
+    )
+
+
+def load_hf_state_dict(input_path: str) -> Dict[str, torch.Tensor]:
+    """Load all shards from one Hugging Face checkpoint into a state dict."""
+    weight_format, weight_files = discover_weight_files(input_path)
+    state_dict: Dict[str, torch.Tensor] = {}
+
+    if weight_format == "safetensors":
+        try:
+            from safetensors.torch import load_file
+        except ImportError as exc:
+            raise RuntimeError(
+                "safetensors is required to convert this checkpoint"
+            ) from exc
+
+        for file in weight_files:
+            print(f"Loading {file}")
+            state_dict.update(load_file(file, device="cpu"))
+    else:
+        for file in weight_files:
+            print(f"Loading {file}")
+            state_dict.update(torch.load(file, map_location=torch.device("cpu")))
+
+    return state_dict
+
