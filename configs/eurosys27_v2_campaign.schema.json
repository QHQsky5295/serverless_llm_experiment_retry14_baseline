{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://primelora.local/schemas/eurosys27_v2_campaign.schema.json",
  "title": "PrimeLoRA EuroSys'27 V2 campaign",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "campaign_root",
    "environment",
    "registries",
    "cleanup",
    "runs"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "eurosys27_v2_campaign_v1"},
    "campaign_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,95}$"
    },
    "campaign_root": {"$ref": "#/$defs/absolutePath"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inherit": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "values": {"$ref": "#/$defs/environment"}
      }
    },
    "registries": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/absolutePath"}
    },
    "source_repositories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": {"$ref": "#/$defs/absolutePath"},
          "required_branch": {"type": "string", "minLength": 1},
          "allowed_tracked_dirty_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/relativePath"}
          }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strict_gpu_idle": {"type": "boolean"},
        "gpu_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "timeout_seconds": {"type": "integer", "minimum": 0},
        "poll_seconds": {"type": "number", "exclusiveMinimum": 0},
        "prune_completed_cache": {"type": "boolean"},
        "pre_commands": {"$ref": "#/$defs/commands"},
        "post_commands": {"$ref": "#/$defs/commands"}
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/executableRun"},
          {"$ref": "#/$defs/reuseRun"}
        ]
      }
    },
    "analyzer_exports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "run_ids", "output_directory", "inputs"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "run_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/id"}
          },
          "output_directory": {"$ref": "#/$defs/absolutePath"},
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "glob"],
              "properties": {
                "name": {"$ref": "#/$defs/id"},
                "glob": {"$ref": "#/$defs/relativePath"},
                "multiple": {"type": "boolean"},
                "required": {"type": "boolean"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,95}$"
    },
    "absolutePath": {"type": "string", "pattern": "^/"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean"]
      }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "commands": {
      "type": "array",
      "items": {"$ref": "#/$defs/command"}
    },
    "runBase": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "executableRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runner", "working_directory", "registry", "env"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "runner": {"$ref": "#/$defs/command"},
        "working_directory": {"$ref": "#/$defs/absolutePath"},
        "registry": {"type": "string", "minLength": 1},
        "env": {"$ref": "#/$defs/environment"},
        "manifest_relative_path": {"$ref": "#/$defs/relativePath"}
      }
    },
    "reuseRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reuse_of"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "reuse_of": {"$ref": "#/$defs/id"}
      }
    }
  }
}
